---
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations } from '@/i18n/utils';

export interface Props {
  locale?: SupportedLocale;
  email?: string;
  subject?: string;
  body?: string;
  label?: string;
  class?: string;
  variant?: 'solid' | 'outline';
}

const {
  locale = 'en',
  email = 'contact@sportiverf.com',
  subject,
  body,
  label = 'Email Headquarters',
  class: className = '',
  variant = 'outline'
} = Astro.props;

const t = useTranslations(locale);
const finalSubject = subject || t('contact.emailSubject');
const finalBody = body || t('contact.emailBody');

const mailtoUrl = `mailto:${email}?subject=${encodeURIComponent(finalSubject)}&body=${encodeURIComponent(finalBody)}`;
---

<a
  href={mailtoUrl}
  class={variant === 'solid'
    ? `btn-primary gap-2.5 ${className}`
    : `btn-secondary gap-2.5 ${className}`}
  aria-label={`Send email to ${email}`}
>
  <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
    ></path>
  </svg>
  <span>{label}</span>
</a>
