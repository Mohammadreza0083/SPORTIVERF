---
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations, getDirFromLocale } from '@/i18n/utils';

export interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const dir = getDirFromLocale(locale);
---

<!-- Parent Agency Banner (Ak Limosa Turizm) - Dark Theme & i18n Supported -->
<section
  id="parent-agency-banner"
  dir={dir}
  class="bg-[#0A0A0A] text-white py-16 px-6 border-b border-t border-white/10"
>
  <div
    class="max-w-[1200px] mx-auto flex flex-col md:flex-row items-center justify-between gap-10 md:gap-12"
  >
    <!-- Left Column (60% Desktop Width): Company Information -->
    <div class="w-full md:w-[60%] flex flex-col items-start text-start">
      <!-- Ak Limosa Logo -->
      <div class="mb-6">
        <img
          src="/images/aklimosa-logo.webp"
          alt="Ak Limosa Turizm"
          class="h-12 sm:h-14 w-auto object-contain"
          loading="lazy"
        />
      </div>

      <!-- Agency Official Description (i18n translated) -->
      <div class="text-gray-300 text-sm leading-relaxed space-y-1.5 mb-6 font-sans">
        <p>{t('agency.desc1')}</p>
        <p>{t('agency.desc2')}</p>
      </div>

      <!-- Official Website CTA Button -->
      <a
        href="https://www.limosatur.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#db5a54] text-white px-6 py-2.5 rounded-sm hover:brightness-110 transition-all font-medium text-sm inline-flex items-center gap-2 shadow-sm active:scale-95"
      >
        <span>{t('agency.btn')}</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </div>

    <!-- Right Column (40% Desktop Width): Official Accreditation Badges -->
    <div class="w-full md:w-[40%] flex justify-start md:justify-end items-center">
      <div class="flex flex-col gap-4 max-w-[250px] w-full items-start md:items-end">
        <!-- TÜRSAB License Badge -->
        <img
          src="/images/tursab-badge.webp"
          alt="TÜRSAB D-13792 Ak Limosa Turizm"
          class="w-full max-w-[240px] h-auto object-contain rounded-sm shadow-md"
          loading="lazy"
        />

        <!-- IATA Accredited Member Badge -->
        <img
          src="/images/iata-logo.webp"
          alt="IATA Accredited Passenger Agency"
          class="w-full max-w-[240px] h-auto object-contain rounded-sm shadow-md"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
