---
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations } from '@/i18n/utils';

export interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const partnerLogos = [
  { name: 'Aklimosaturizm Travel Agency', type: 'Parent Tourism Agency', license: 'TÜRSAB Licensed' },
  { name: 'Pega Kartal Residence', type: 'Headquarters Center', location: 'İstanbul' },
  { name: 'Belek High Altitude Center', type: 'Affiliated Resort', location: 'Antalya' },
  { name: 'Burhan Felek Olympic Hall', type: 'Indoor Court Partner', location: 'İstanbul' },
  { name: 'European Scout Network', type: 'Talent Showcase Partner', location: 'EU Region' },
  { name: 'FIVB Accredited Complexes', type: 'Volleyball Facilities', location: 'Turkey' }
];
---

<section class="py-16 md:py-24 bg-white border-b border-[#E5E3DC]">
  <div class="max-w-[1400px] mx-auto px-4 md:px-8">
    <!-- Parent Agency Aklimosaturizm Feature Card -->
    <div class="bg-[#FAF9F6] border border-[#E5E3DC] p-8 md:p-12 mb-16 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-2 h-full bg-[#E5383B]"></div>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8">
          <span class="inline-block px-3 py-1 bg-white border border-[#E5383B] text-[#E5383B] font-mono text-xs uppercase tracking-[0.2em] mb-4 shadow-sm">
            {t('about.badge')}
          </span>
          <h2 class="font-barlow font-extrabold text-3xl md:text-5xl uppercase tracking-tight text-[#0D0D0D] mb-4">
            Aklimosaturizm — Authorized Parent Tourism Agency
          </h2>
          <p class="text-[#555555] text-base leading-relaxed font-light mb-6">
            {t('about.supervisionDesc')} All SPORTIVERF athletic expeditions, hotel stays, ground logistics, and match operations strictly comply with national and international travel regulations under the official license of Aklimosaturizm.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 font-mono text-xs">
            <div class="bg-white border border-[#E5E3DC] p-3.5">
              <span class="text-[#888888] block text-[10px] uppercase">LEGAL STATUS</span>
              <span class="font-bold text-[#0D0D0D] block mt-0.5">TÜRSAB Licensed Agency</span>
            </div>
            <div class="bg-white border border-[#E5E3DC] p-3.5">
              <span class="text-[#888888] block text-[10px] uppercase">PROTECTION</span>
              <span class="font-bold text-[#0D0D0D] block mt-0.5">Full Travel Insurance</span>
            </div>
            <div class="bg-white border border-[#E5E3DC] p-3.5">
              <span class="text-[#888888] block text-[10px] uppercase">HEADQUARTERS</span>
              <span class="font-bold text-[#0D0D0D] block mt-0.5">Kartal / İstanbul</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-4 bg-white border border-[#E5E3DC] p-6 text-center space-y-3 shadow-sm">
          <div class="w-16 h-16 rounded-full bg-[#E5383B]/10 border-2 border-[#E5383B] flex items-center justify-center mx-auto text-[#E5383B]">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="font-barlow font-bold text-xl uppercase text-[#0D0D0D]">Official License</h3>
          <p class="font-mono text-xs text-[#888888] uppercase tracking-wider">A-Group Tourism Operator</p>
          <span class="inline-block px-3 py-1 bg-[#0D0D0D] text-white font-mono text-[10px] uppercase tracking-widest">
            VERIFIED SECURITY
          </span>
        </div>
      </div>
    </div>

    <!-- Partner Ecosystem Showcase Grid -->
    <div>
      <div class="text-center mb-10">
        <span class="font-mono text-xs text-[#E5383B] uppercase tracking-[0.2em] block mb-2">
          AFFILIATED ECOSYSTEM
        </span>
        <h3 class="font-barlow font-extrabold text-2xl md:text-4xl uppercase tracking-tight text-[#0D0D0D]">
          Partner Hotels & Sports Organizations
        </h3>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {
          partnerLogos.map((partner) => (
            <div class="bg-[#FAF9F6] border border-[#E5E3DC] p-5 flex flex-col justify-between items-center text-center hover:border-[#E5383B] transition-colors group">
              <div class="w-12 h-12 bg-white border border-[#E5E3DC] flex items-center justify-center font-barlow font-black text-xl text-[#0D0D0D] group-hover:bg-[#E5383B] group-hover:text-white group-hover:border-[#E5383B] transition-colors mb-3">
                {partner.name.charAt(0)}
              </div>
              <div>
                <h4 class="font-barlow font-bold text-sm uppercase text-[#0D0D0D] line-clamp-1">{partner.name}</h4>
                <span class="font-mono text-[9px] text-[#888888] uppercase block mt-1">{partner.type}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
