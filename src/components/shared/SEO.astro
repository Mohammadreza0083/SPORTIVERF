---
import { LOCALES_LIST } from '@/i18n/config';
import type { SupportedLocale } from '@/types/i18n';
import JsonLd from '@/components/seo/JsonLd.astro';
import { generateOrganizationSchema, generateWebSiteSchema } from '@/utils/schema';

export interface SEOProps {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'product';
  customSchema?: object | object[];
}

export interface Props extends SEOProps {
  locale: SupportedLocale;
}

const {
  locale,
  title = 'SPORTIVERF — High-Performance Sports Tourism',
  description = 'Premier international sports tourism platform, alpine skiing expeditions, and elite athletic retreats.',
  image = '/assets/images/og-default.jpg',
  canonicalUrl,
  noindex = false,
  type = 'website',
  customSchema
} = Astro.props;

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://sportiverf.com').replace(/\/$/, '');

// Normalize canonical URL
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const computedCanonical = canonicalUrl || `${siteUrl}${currentPath}`;
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;

// Map locale to OG locale format
const ogLocales: Record<SupportedLocale, string> = {
  en: 'en_US',
  tr: 'tr_TR',
  fa: 'fa_IR'
};
const currentOgLocale = ogLocales[locale] || 'en_US';
const alternateOgLocales = Object.entries(ogLocales)
  .filter(([loc]) => loc !== locale)
  .map(([, ogLoc]) => ogLoc);

// Base Schemas
const orgSchema = generateOrganizationSchema(siteUrl);
const websiteSchema = generateWebSiteSchema(siteUrl, locale);
const allSchemas = [orgSchema, websiteSchema, ...(customSchema ? (Array.isArray(customSchema) ? customSchema : [customSchema]) : [])];
---

<!-- Primary Technical Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
<meta name="theme-color" content="#000000" />
<meta name="color-scheme" content="dark" />
<meta name="format-detection" content="telephone=no" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

<!-- Canonical Link -->
<link rel="canonical" href={computedCanonical} />

<!-- Multilingual SEO Hreflang Strategy -->
{LOCALES_LIST.map((loc) => {
  const cleanPath = Astro.url.pathname.replace(/^\/(en|tr|fa)/, '');
  const localizedHref = `${siteUrl}/${loc}${cleanPath.startsWith('/') ? cleanPath : '/' + cleanPath}`.replace(/\/$/, '') || `${siteUrl}/${loc}`;
  return <link rel="alternate" hreflang={loc} href={localizedHref} />;
})}
<link rel="alternate" hreflang="x-default" href={`${siteUrl}/en`} />

<!-- OpenGraph Metadata -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="SPORTIVERF" />
<meta property="og:url" content={computedCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={currentOgLocale} />
{alternateOgLocales.map((altOg) => (
  <meta property="og:locale:alternate" content={altOg} />
))}

<!-- Twitter Card Metadata -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@sportiverf" />
<meta name="twitter:creator" content="@sportiverf" />
<meta name="twitter:url" content={computedCanonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:image:alt" content={title} />

<!-- JSON-LD Structured Data Schemas -->
<JsonLd schema={allSchemas} />
