---
import WhatsAppButton from './WhatsAppButton.astro';
import MailtoButton from './MailtoButton.astro';

export interface Props {
  class?: string;
  campTitle?: string;
}

const { class: className = '', campTitle } = Astro.props;
const whatsappMsg = campTitle
  ? `Hello SPORTIVERF! I am interested in booking or receiving details about: ${campTitle}.`
  : undefined;
---

<div class={`flex flex-wrap items-center gap-4 ${className}`}>
  <WhatsAppButton message={whatsappMsg} variant="solid" label="WhatsApp Concierge" />
  <MailtoButton
    subject={campTitle ? `Inquiry: ${campTitle}` : undefined}
    variant="outline"
    label="Send Email"
  />
  <a
    href="tel:+902165147808"
    class="btn-secondary gap-2"
    aria-label="Call SPORTIVERF Headquarters Office Phone"
  >
    <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.826-1.07-5.11-3.354-6.18-6.18l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
      ></path>
    </svg>
    <span>+90 216 514 78 08</span>
  </a>
</div>
