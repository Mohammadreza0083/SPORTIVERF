---
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations, getDirFromLocale } from '@/i18n/utils';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const dir = getDirFromLocale(locale);
const isRtl = dir === 'rtl';
---

<section
  dir={dir}
  class="relative min-h-screen md:min-h-[92vh] flex flex-col justify-between bg-[#080808] text-white border-b border-white/10 overflow-hidden w-full max-w-full"
>
  <!-- TOP: Image Wrapper (h-[75vh] on Mobile, absolute full screen on Desktop) -->
  <div
    class="relative w-full h-[75vh] md:h-full md:absolute md:inset-0 z-0 overflow-hidden"
  >
    <!-- Responsive Picture Tag Serving Mobile Asset on Mobile Viewports -->
    <picture class="absolute inset-0 w-full h-full block z-0">
      <source media="(max-width: 767px)" srcset="/images/hero-mobile.webp" type="image/webp" />
      <source media="(min-width: 768px)" srcset="/images/hero-bg.webp" type="image/webp" />
      <img
        src="/images/hero-bg.jpg"
        alt="SPORTIVERF Elite Athletic Arena"
        loading="eager"
        fetchpriority="high"
        class="w-full h-full object-cover object-center opacity-90 transition-all duration-700"
      />
    </picture>

    <!-- Dark Gradient Overlay (Bottom 50% of Image Wrapper) -->
    <div
      class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-[#080808] via-[#080808]/80 to-transparent pointer-events-none z-10"
    >
    </div>

    <!-- Desktop Ambient Overlays -->
    <div
      class="hidden md:block absolute inset-0 bg-gradient-to-b from-[#080808] via-[#080808]/40 to-transparent pointer-events-none z-10"
    >
    </div>

    <!-- Red Neon Ambient Accents -->
    <div
      class="absolute -top-32 right-0 w-[350px] md:w-[500px] h-[350px] md:h-[500px] bg-[#E5383B]/15 rounded-full blur-[120px] md:blur-[140px] pointer-events-none z-10"
    >
    </div>
    <div
      class="absolute -bottom-32 left-0 w-[350px] md:w-[600px] h-[350px] md:h-[600px] bg-[#B7094C]/15 rounded-full blur-[120px] md:blur-[160px] pointer-events-none z-10"
    >
    </div>

    <!-- Mobile Badge & Main H1 Title (Positioned Absolute Bottom-6 Overlapping Image Fade) -->
    <div
      class={`absolute bottom-6 left-0 w-full px-5 z-20 md:hidden flex flex-col ${
        isRtl ? 'text-right items-end' : 'text-left items-start'
      }`}
    >
      <!-- Top Tagline Badge -->
      <div
        class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-[#E5383B]/10 border border-[#E5383B]/40 text-[#E5383B] font-mono text-[10px] sm:text-xs uppercase tracking-[0.2em] backdrop-blur-md shadow-[0_0_15px_rgba(229,56,59,0.2)] rounded-none mb-3"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-[#E5383B] animate-pulse"></span>
        <span>{t('hero.badge')}</span>
      </div>

      <!-- Main H1 Headline -->
      <h1
        class="font-barlow font-black text-3xl sm:text-5xl uppercase tracking-tight text-white leading-[0.92] drop-shadow-[0_4px_16px_rgba(0,0,0,0.9)]"
      >
        {t('hero.title')}
      </h1>
    </div>
  </div>

  <!-- BOTTOM: CTA Buttons Container Below Image Wrapper on Mobile (Overlay on Desktop) -->
  <div
    class={`w-full max-w-[1400px] mx-auto px-5 py-6 md:pt-36 md:pb-20 flex flex-col relative z-20 flex-1 justify-start md:justify-center bg-[#080808] md:bg-transparent ${
      isRtl ? 'text-right items-end' : 'text-left items-start'
    }`}
  >
    <!-- Desktop Tagline Badge -->
    <div
      class="hidden md:inline-flex items-center gap-2 px-3.5 py-1.5 bg-[#E5383B]/10 border border-[#E5383B]/40 text-[#E5383B] font-mono text-xs uppercase tracking-[0.22em] mb-6 backdrop-blur-md shadow-[0_0_15px_rgba(229,56,59,0.2)] rounded-none"
    >
      <span class="w-2 h-2 rounded-full bg-[#E5383B] animate-pulse"></span>
      <span>{t('hero.badge')}</span>
    </div>

    <!-- Desktop Main H1 Headline -->
    <h1
      class="hidden md:block font-barlow font-black text-8xl lg:text-9xl uppercase tracking-tight text-white max-w-5xl leading-[0.92] mb-6 drop-shadow-[0_10px_25px_rgba(0,0,0,0.9)]"
    >
      {t('hero.title')}
    </h1>

    <!-- Desktop Subtitle -->
    <p
      class="hidden md:block font-sans text-base md:text-xl text-[#DDDDDD] max-w-2xl font-light mb-10 leading-relaxed drop-shadow-md"
    >
      {t('hero.subtitle')}
    </p>

    <!-- Interactive CTA Buttons -->
    <div class="relative w-full max-w-4xl my-2 md:my-4">
      <div
        class={`flex flex-wrap items-center gap-3 sm:gap-6 z-20 ${
          isRtl ? 'justify-end' : 'justify-start'
        }`}
      >
        <!-- CTA 1: Volleyball Camps -->
        <div class="relative group/cta w-full sm:w-auto">
          <a
            href={`/${locale}/volleyball-camps`}
            class="bg-gradient-to-r from-[#E5383B] to-[#B7094C] hover:from-[#FF4D6D] hover:to-[#E5383B] text-white shadow-[0_0_25px_rgba(229,56,59,0.4)] hover:shadow-[0_0_35px_rgba(229,56,59,0.7)] transition-all duration-300 font-barlow font-bold text-xs sm:text-sm tracking-[0.18em] uppercase py-3.5 sm:py-4 px-6 sm:px-7 flex items-center justify-between sm:justify-start gap-2 relative border border-[#FF4D6D]/30 w-full sm:w-auto"
          >
            <span>Volleyball Camps</span>
            <!-- Mobile Help Icon -->
            <button
              type="button"
              data-guide-trigger="volleyball-camps"
              class="sm:hidden w-5 h-5 rounded-full bg-white/20 text-white flex items-center justify-center text-[11px] font-mono font-bold ml-1 rtl:ml-0 rtl:mr-1 hover:bg-white/40 focus:outline-none cursor-pointer"
              aria-label="Volleyball Camps Guide"
            >
              ?
            </button>
          </a>

          <!-- Desktop Floating Glassmorphism Guidance Tooltip -->
          <div
            class={`hidden sm:block absolute bottom-full mb-3 w-72 p-4 bg-[#0D0D0D]/95 border border-[#E5383B]/60 text-white text-xs font-sans rounded-none shadow-[0_0_30px_rgba(229,56,59,0.3)] opacity-0 scale-95 pointer-events-none group-hover/cta:opacity-100 group-hover/cta:scale-100 transition-all duration-300 z-30 backdrop-blur-xl ${
              isRtl ? 'right-0 text-right' : 'left-0 text-left'
            }`}
          >
            <span
              class="font-barlow font-bold text-sm uppercase text-[#E5383B] tracking-wider block mb-1"
            >
              Volleyball Masterclasses
            </span>
            <p class="text-[#CCCCCC] leading-relaxed font-light">
              FIVB Taraflex court clinics, jump serve biomechanics, and direct scout exposure.
            </p>

            <!-- Tooltip Arrow Indicator -->
            <div
              class={`absolute top-full border-4 border-transparent border-t-[#E5383B]/80 ${
                isRtl ? 'right-8' : 'left-8'
              }`}
            >
            </div>
          </div>
        </div>

        <!-- CTA 2: Football Camps -->
        <div class="relative group/cta w-full sm:w-auto">
          <a
            href={`/${locale}/football-camps`}
            class="bg-white/10 hover:bg-white text-white hover:text-[#0D0D0D] border border-white/20 hover:border-white shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_25px_rgba(255,255,255,0.4)] transition-all duration-300 font-barlow font-bold text-xs sm:text-sm tracking-[0.18em] uppercase py-3.5 sm:py-4 px-6 sm:px-7 flex items-center justify-between sm:justify-start gap-2 backdrop-blur-md relative w-full sm:w-auto"
          >
            <span>Football Camps</span>
            <!-- Mobile Help Icon -->
            <button
              type="button"
              data-guide-trigger="football-camps"
              class="sm:hidden w-5 h-5 rounded-full bg-white/20 text-white hover:text-[#0D0D0D] flex items-center justify-center text-[11px] font-mono font-bold ml-1 rtl:ml-0 rtl:mr-1 hover:bg-white/40 focus:outline-none cursor-pointer"
              aria-label="Football Camps Guide"
            >
              ?
            </button>
          </a>

          <!-- Desktop Floating Glassmorphism Guidance Tooltip -->
          <div
            class={`hidden sm:block absolute bottom-full mb-3 w-72 p-4 bg-[#0D0D0D]/95 border border-[#E5383B]/60 text-white text-xs font-sans rounded-none shadow-[0_0_30px_rgba(229,56,59,0.3)] opacity-0 scale-95 pointer-events-none group-hover/cta:opacity-100 group-hover/cta:scale-100 transition-all duration-300 z-30 backdrop-blur-xl ${
              isRtl ? 'right-0 text-right' : 'left-0 text-left'
            }`}
          >
            <span
              class="font-barlow font-bold text-sm uppercase text-[#E5383B] tracking-wider block mb-1"
            >
              Football Showcases
            </span>
            <p class="text-[#CCCCCC] leading-relaxed font-light">
              UEFA Pro coaches, FIFA Quality Pro hybrid grass pitches, and European scout
              evaluations.
            </p>

            <div
              class={`absolute top-full border-4 border-transparent border-t-[#E5383B]/80 ${
                isRtl ? 'right-8' : 'left-8'
              }`}
            >
            </div>
          </div>
        </div>

        <!-- CTA 3: Volleyball Direct -->
        <div class="relative group/cta w-full sm:w-auto">
          <a
            href={`/${locale}/volleyball-camps`}
            class="bg-[#111111]/80 hover:bg-[#E5383B] text-white border border-[#E5383B]/40 hover:border-[#E5383B] shadow-[0_0_20px_rgba(229,56,59,0.15)] hover:shadow-[0_0_30px_rgba(229,56,59,0.5)] transition-all duration-300 font-barlow font-bold text-xs sm:text-sm tracking-[0.18em] uppercase py-3.5 sm:py-4 px-6 sm:px-7 flex items-center justify-between sm:justify-start gap-2 backdrop-blur-md relative w-full sm:w-auto"
          >
            <span>Volleyball</span>
            <!-- Mobile Help Icon -->
            <button
              type="button"
              data-guide-trigger="volleyball-direct"
              class="sm:hidden w-5 h-5 rounded-full bg-white/20 text-white flex items-center justify-center text-[11px] font-mono font-bold ml-1 rtl:ml-0 rtl:mr-1 hover:bg-white/40 focus:outline-none cursor-pointer"
              aria-label="Volleyball Guide"
            >
              ?
            </button>
          </a>

          <!-- Desktop Floating Glassmorphism Guidance Tooltip -->
          <div
            class={`hidden sm:block absolute bottom-full mb-3 w-72 p-4 bg-[#0D0D0D]/95 border border-[#E5383B]/60 text-white text-xs font-sans rounded-none shadow-[0_0_30px_rgba(229,56,59,0.3)] opacity-0 scale-95 pointer-events-none group-hover/cta:opacity-100 group-hover/cta:scale-100 transition-all duration-300 z-30 backdrop-blur-xl ${
              isRtl ? 'right-0 text-right' : 'left-0 text-left'
            }`}
          >
            <span
              class="font-barlow font-bold text-sm uppercase text-[#E5383B] tracking-wider block mb-1"
            >
              High-Altitude Indoor
            </span>
            <p class="text-[#CCCCCC] leading-relaxed font-light">
              Specialized setter, libero & attacker high-altitude training clinics for youth.
            </p>

            <div
              class={`absolute top-full border-4 border-transparent border-t-[#E5383B]/80 ${
                isRtl ? 'right-8' : 'left-8'
              }`}
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Interactive Guide Popover Modal -->
  <div
    id="mobile-guide-modal"
    class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 hidden flex items-center justify-center p-4"
  >
    <div
      class={`bg-[#121212] border-2 border-[#E5383B] p-6 max-w-sm w-full relative text-white space-y-4 shadow-[0_0_40px_rgba(229,56,59,0.4)] ${
        isRtl ? 'text-right' : 'text-left'
      }`}
    >
      <button
        id="close-guide-modal"
        type="button"
        class={`absolute top-3 ${
          isRtl ? 'left-3' : 'right-3'
        } text-[#888888] hover:text-white font-mono text-xl focus:outline-none cursor-pointer`}
        aria-label="Close Modal"
      >
        &times;
      </button>

      <div class="w-12 h-1 bg-gradient-to-r from-[#E5383B] to-[#FF4D6D] mb-2"></div>

      <h4 id="guide-title" class="font-barlow font-bold text-2xl uppercase text-[#E5383B]">
        Camp Guide
      </h4>

      <p id="guide-body" class="text-sm text-[#DDDDDD] font-light leading-relaxed">
        Explanation guide text goes here.
      </p>

      <button
        id="guide-action-btn"
        type="button"
        class="w-full py-3.5 bg-gradient-to-r from-[#E5383B] to-[#B7094C] text-white text-xs font-barlow font-bold uppercase tracking-wider block text-center shadow-[0_0_20px_rgba(229,56,59,0.4)] hover:shadow-[0_0_30px_rgba(229,56,59,0.6)] cursor-pointer"
      >
        Explore Now
      </button>
    </div>
  </div>

  <!-- Statistics Strip Directly Positioned Underneath Hero Content -->
  <div
    class="w-full border-t border-white/10 bg-[#0A0A0A]/95 backdrop-blur-xl relative z-20 py-6 sm:py-8 shadow-[0_-10px_30px_rgba(0,0,0,0.5)]"
  >
    <div
      class="max-w-[1400px] mx-auto px-4 md:px-8 grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 text-center"
    >
      <div class="p-2">
        <span
          class="font-barlow font-black text-3xl sm:text-4xl md:text-5xl text-white block tracking-tight"
          data-counter="500"
          data-suffix="+"
        >
          0+
        </span>
        <span
          class="font-mono text-[11px] sm:text-xs text-[#888888] uppercase tracking-wider mt-1 block font-medium"
        >
          {t('hero.statAthletes')}
        </span>
      </div>

      <div class="sm:border-x border-white/10 p-2">
        <span
          class="font-barlow font-black text-3xl sm:text-4xl md:text-5xl text-white block tracking-tight"
          data-counter="40"
          data-suffix="+"
        >
          0+
        </span>
        <span
          class="font-mono text-[11px] sm:text-xs text-[#888888] uppercase tracking-wider mt-1 block font-medium"
        >
          {t('hero.statClubs')}
        </span>
      </div>

      <div class="p-2">
        <span
          class="font-barlow font-black text-4xl md:text-5xl text-white block tracking-tight"
          data-counter="15"
          data-suffix="+"
        >
          0+
        </span>
        <span
          class="font-mono text-[11px] sm:text-xs text-[#888888] uppercase tracking-wider mt-1 block font-medium"
        >
          {t('hero.statAcademies')}
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Kinetic Stats Counter Trigger
    const counters = document.querySelectorAll('[data-counter]');

    if (counters.length) {
      const animateCounter = (counter: Element): void => {
        const target = parseInt(counter.getAttribute('data-counter') || '0', 10);
        const suffix = counter.getAttribute('data-suffix') || '';
        const duration = 2000;
        const startTime = performance.now();

        const updateCount = (currentTime: number): void => {
          const elapsedTime = currentTime - startTime;
          const progress = Math.min(elapsedTime / duration, 1);
          const easeProgress = 1 - Math.pow(1 - progress, 3);
          const currentCount = Math.floor(easeProgress * target);

          counter.textContent = `${currentCount}${suffix}`;

          if (progress < 1) {
            requestAnimationFrame(updateCount);
          } else {
            counter.textContent = `${target}${suffix}`;
          }
        };

        requestAnimationFrame(updateCount);
      };

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCounter(entry.target);
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.2 }
      );

      counters.forEach((c) => observer.observe(c));
    }

    // Mobile Guide Popover Trigger Logic
    const guideTriggers = document.querySelectorAll('[data-guide-trigger]');
    const guideModal = document.getElementById('mobile-guide-modal');
    const closeGuideBtn = document.getElementById('close-guide-modal');
    const guideTitle = document.getElementById('guide-title');
    const guideBody = document.getElementById('guide-body');
    const guideActionBtn = document.getElementById('guide-action-btn');

    const guideData = {
      'volleyball-camps': {
        title: 'Volleyball Camps',
        body: 'FIVB Taraflex court clinics, jump serve biomechanics, and direct scout exposure across top Turkish indoor arenas.',
        link: 'volleyball-camps'
      },
      'football-camps': {
        title: 'Football Camps',
        body: 'UEFA Pro coaches, 5-Star resort stays, FIFA Quality Pro hybrid grass pitches, and European scout showcase evaluations.',
        link: 'football-camps'
      },
      'volleyball-direct': {
        title: 'Volleyball Masterclass',
        body: 'Specialized setter, libero, and attacker high-altitude training clinics for international youth athletes.',
        link: 'volleyball-camps'
      }
    };

    const currentPath = window.location.pathname;
    const pathParts = currentPath.split('/').filter(Boolean);
    const localePrefix = pathParts.length > 0 ? pathParts[0] : 'en';

    guideTriggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const key = trigger.getAttribute('data-guide-trigger');
        const info = key && key in guideData ? guideData[key as keyof typeof guideData] : null;

        if (info && guideModal && guideTitle && guideBody && guideActionBtn) {
          guideTitle.textContent = info.title;
          guideBody.textContent = info.body;
          guideActionBtn.onclick = (): void => {
            window.location.href = `/${localePrefix}/${info.link}`;
          };
          guideModal.classList.remove('hidden');
        }
      });
    });

    if (closeGuideBtn && guideModal) {
      closeGuideBtn.addEventListener('click', () => {
        guideModal.classList.add('hidden');
      });

      guideModal.addEventListener('click', (e) => {
        if (e.target === guideModal) {
          guideModal.classList.add('hidden');
        }
      });
    }
  });
</script>
