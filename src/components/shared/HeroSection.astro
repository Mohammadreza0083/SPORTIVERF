---
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations, getDirFromLocale } from '@/i18n/utils';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const dir = getDirFromLocale(locale);
---

<!-- Hero Section Container with Centered Interactive CTAs -->
<section
  id="hero-section"
  dir={dir}
  class="relative w-full min-h-[560px] h-[85svh] md:h-screen overflow-hidden flex items-center justify-center bg-[#080808] text-white border-b border-white/10"
>
  <!-- Background Picture with Dynamic Red Hue Shift Filter & Full Container Coverage -->
  <picture class="absolute inset-0 w-full h-full block z-0">
    <source media="(max-width: 767px)" srcset="/images/hero-mobile.webp" type="image/webp" />
    <source media="(min-width: 768px)" srcset="/images/hero-bg.webp" type="image/webp" />
    <img
      src="/images/hero-bg.jpg"
      alt="SPORTIVERF Elite Athletic Arena"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover object-center opacity-85 filter hue-rotate-[130deg] saturate-[1.3] transition-all duration-700 z-0"
    />
  </picture>

  <!-- Ambient Dark Overlays -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-[#080808] via-[#080808]/60 to-[#080808]/80 pointer-events-none z-10"
  >
  </div>
  <div class="absolute inset-0 bg-black/40 pointer-events-none z-10"></div>
  <!-- Dark Radial Gradient Overlay for Center Contrast -->
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(0,0,0,0.7)_0%,rgba(0,0,0,0.2)_70%)] z-10 pointer-events-none"
  >
  </div>

  <!-- Red Neon Ambient Accents -->
  <div
    class="absolute -top-32 right-0 w-[300px] sm:w-[350px] md:w-[500px] h-[300px] sm:h-[350px] md:h-[500px] bg-[#E5383B]/15 rounded-full blur-[100px] md:blur-[140px] pointer-events-none z-10"
  >
  </div>
  <div
    class="absolute -bottom-32 left-0 w-[300px] sm:w-[350px] md:w-[600px] h-[300px] sm:h-[350px] md:h-[600px] bg-[#B7094C]/15 rounded-full blur-[100px] md:blur-[160px] pointer-events-none z-10"
  >
  </div>

  <!-- Centered Hero CTAs (Desktop: Row, Mobile: Column) -->
  <div
    class="relative z-20 flex flex-col md:flex-row items-center justify-center gap-5 sm:gap-6 md:gap-8 px-4"
  >
    <!-- Button 1: Volleyball Camps -->
    <button
      id="btn-volleyball-camps"
      type="button"
      class="aspect-square w-40 md:w-48 flex flex-col items-center justify-center gap-3 backdrop-blur-md bg-black/50 border border-white/10 hover:border-[#E5383B] transition-all hover:scale-105 active:scale-95 group cursor-pointer p-4 text-center shadow-[0_4px_30px_rgba(0,0,0,0.5)] hover:shadow-[0_0_30px_rgba(229,56,59,0.35)]"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="volleyball-modal"
    >
      <svg
        class="w-10 h-10 md:w-12 md:h-12 text-white group-hover:text-[#E5383B] transition-colors"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="m4.93 4.93 4.24 4.24"></path>
        <path d="m14.83 9.17 4.24-4.24"></path>
        <path d="m14.83 14.83 4.24 4.24"></path>
        <path d="m9.17 14.83-4.24 4.24"></path>
        <circle cx="12" cy="12" r="4"></circle>
      </svg>
      <span
        class="font-barlow font-bold text-sm md:text-base tracking-wider uppercase text-white group-hover:text-[#E5383B] transition-colors text-center leading-snug"
      >
        {t('camps.volleyball')}
      </span>
    </button>

    <!-- Button 2: Player Camps -->
    <button
      type="button"
      class="camp-trigger-btn aspect-square w-40 md:w-48 flex flex-col items-center justify-center gap-3 backdrop-blur-md bg-black/50 border border-white/10 hover:border-[#E5383B] transition-all hover:scale-105 active:scale-95 group cursor-pointer p-4 text-center shadow-[0_4px_30px_rgba(0,0,0,0.5)] hover:shadow-[0_0_30px_rgba(229,56,59,0.35)]"
      data-desc={t('camps.descPlayer')}
      data-href={`/${locale}/camps/player`}
    >
      <svg
        class="w-10 h-10 md:w-12 md:h-12 text-white group-hover:text-[#E5383B] transition-colors"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span
        class="font-barlow font-bold text-sm md:text-base tracking-wider uppercase text-white group-hover:text-[#E5383B] transition-colors text-center leading-snug"
      >
        {t('camps.player')}
      </span>
    </button>
  </div>
</section>

<!-- Full-screen Blurred Modal for Volleyball Camps -->
<div
  id="volleyball-modal"
  class="fixed inset-0 backdrop-blur-xl bg-black/60 z-50 hidden items-center justify-center p-4 transition-all duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="volleyball-modal-title"
>
  <div
    id="volleyball-modal-content"
    class="relative w-full max-w-lg bg-[#0e0e0e]/95 border border-white/15 p-6 sm:p-8 md:p-10 shadow-[0_0_50px_rgba(0,0,0,0.8)] backdrop-blur-2xl flex flex-col items-center transform transition-all duration-300 scale-95 opacity-0"
  >
    <!-- Modal Close Button -->
    <button
      id="volleyball-modal-close"
      type="button"
      class="absolute top-4 right-4 text-white/60 hover:text-white p-2 transition-colors cursor-pointer"
      aria-label="Close"
    >
      <svg
        class="w-6 h-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div
      class="inline-flex items-center gap-2 px-3 py-1 bg-[#E5383B]/10 border border-[#E5383B]/30 text-[#E5383B] font-mono text-[10px] uppercase tracking-[0.2em] mb-4"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-[#E5383B] animate-pulse"></span>
      <span>SPORTIVERF</span>
    </div>

    <h3
      id="volleyball-modal-title"
      class="font-barlow font-bold text-xl md:text-2xl uppercase tracking-wider text-white mb-6 text-center"
    >
      {t('camps.volleyball')}
    </h3>

    <!-- Sub-options: Team Camps & Friendly Matches -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 w-full">
      <!-- Team Camps Button -->
      <button
        type="button"
        class="camp-trigger-btn aspect-square w-36 sm:w-40 md:w-44 flex flex-col items-center justify-center gap-3 backdrop-blur-md bg-black/40 border border-white/10 hover:border-[#E5383B] transition-all hover:scale-105 active:scale-95 text-white group cursor-pointer p-4 shadow-lg hover:shadow-[0_0_20px_rgba(229,56,59,0.3)] text-center"
        data-desc={t('camps.descTeam')}
        data-href={`/${locale}/camps/team`}
      >
        <svg
          class="w-8 h-8 md:w-10 md:h-10 text-white group-hover:text-[#E5383B] transition-colors"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <span
          class="font-barlow font-bold text-xs sm:text-sm tracking-wider uppercase text-center leading-snug"
        >
          {t('camps.team')}
        </span>
      </button>

      <!-- Friendly Matches Button -->
      <button
        type="button"
        class="camp-trigger-btn aspect-square w-36 sm:w-40 md:w-44 flex flex-col items-center justify-center gap-3 backdrop-blur-md bg-black/40 border border-white/10 hover:border-[#E5383B] transition-all hover:scale-105 active:scale-95 text-white group cursor-pointer p-4 shadow-lg hover:shadow-[0_0_20px_rgba(229,56,59,0.3)] text-center"
        data-desc={t('camps.descFriendly')}
        data-href={`/${locale}/camps/friendly`}
      >
        <svg
          class="w-8 h-8 md:w-10 md:h-10 text-white group-hover:text-[#E5383B] transition-colors"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m11 17 2 2a1 1 0 0 0 1.4 0l4.3-4.3a1 1 0 0 0 0-1.4l-3-3a1 1 0 0 0-1.4 0l-1.3 1.3"
          ></path>
          <path d="m14 11-1.3-1.3a1 1 0 0 0-1.4 0L7 14"></path>
          <path d="m7 7 3-3a1 1 0 0 1 1.4 0l3 3"></path>
          <path d="M2 14h6"></path>
          <path d="M22 10h-6"></path>
          <path d="m2 14 3-3a1 1 0 0 1 1.4 0L10 14"></path>
        </svg>
        <span
          class="font-barlow font-bold text-xs sm:text-sm tracking-wider uppercase text-center leading-snug"
        >
          {t('camps.friendly')}
        </span>
      </button>
    </div>
  </div>
</div>

<!-- Sleek Animated Motion Toast / Overlay -->
<div
  id="motion-toast-container"
  class="fixed inset-0 backdrop-blur-xl bg-black/75 z-50 hidden items-center justify-center p-4 transition-all duration-300 opacity-0 pointer-events-none"
  role="alertdialog"
  aria-live="assertive"
>
  <div
    id="motion-toast-card"
    class="relative w-full max-w-md bg-[#111111]/95 border border-[#E5383B]/50 p-6 sm:p-8 shadow-[0_0_50px_rgba(229,56,59,0.3)] flex flex-col items-center text-center transform transition-all duration-300 ease-out translate-y-4 opacity-0"
  >
    <!-- Glowing indicator -->
    <div class="w-2.5 h-2.5 rounded-full bg-[#E5383B] shadow-[0_0_12px_#E5383B] animate-ping mb-4">
    </div>

    <!-- Description Text -->
    <p
      id="motion-toast-desc"
      class="text-white text-sm sm:text-base md:text-lg font-light leading-relaxed font-barlow tracking-wide mb-6"
    >
    </p>

    <!-- Progress indicator bar for 2.5s countdown -->
    <div class="w-full h-1 bg-white/10 overflow-hidden mb-6 rounded-full">
      <div
        id="motion-toast-bar"
        class="h-full bg-gradient-to-r from-[#E5383B] to-[#FF4D6D] w-0 transition-all ease-linear"
      >
      </div>
    </div>

    <!-- Skip Button -->
    <button
      id="motion-toast-skip-btn"
      type="button"
      class="px-6 py-2.5 bg-white/10 hover:bg-[#E5383B] text-white border border-white/20 hover:border-[#E5383B] text-xs font-mono uppercase tracking-[0.2em] font-semibold transition-all duration-200 cursor-pointer shadow-md hover:shadow-[0_0_20px_rgba(229,56,59,0.4)] active:scale-95"
    >
      {t('ui.skip')} &rarr;
    </button>
  </div>
</div>

<script>
  function initHeroInteractions(): void {
    const volleyballBtn = document.getElementById('btn-volleyball-camps');
    const volleyballModal = document.getElementById('volleyball-modal');
    const volleyballModalContent = document.getElementById('volleyball-modal-content');
    const volleyballModalClose = document.getElementById('volleyball-modal-close');

    const toastContainer = document.getElementById('motion-toast-container');
    const toastCard = document.getElementById('motion-toast-card');
    const toastDesc = document.getElementById('motion-toast-desc');
    const toastBar = document.getElementById('motion-toast-bar');
    const toastSkipBtn = document.getElementById('motion-toast-skip-btn');

    let redirectTimer: number | null = null;
    let targetUrl = '';

    const openVolleyballModal = (): void => {
      if (!volleyballModal || !volleyballModalContent) return;
      volleyballBtn?.setAttribute('aria-expanded', 'true');
      volleyballModal.classList.remove('hidden');
      volleyballModal.classList.add('flex');
      // Trigger layout reflow
      void volleyballModal.offsetWidth;
      volleyballModal.classList.remove('opacity-0');
      volleyballModal.classList.add('opacity-100');
      volleyballModalContent.classList.remove('scale-95', 'opacity-0');
      volleyballModalContent.classList.add('scale-100', 'opacity-100');
    };

    const closeVolleyballModal = (): void => {
      if (!volleyballModal || !volleyballModalContent) return;
      volleyballBtn?.setAttribute('aria-expanded', 'false');
      volleyballModal.classList.remove('opacity-100');
      volleyballModal.classList.add('opacity-0');
      volleyballModalContent.classList.remove('scale-100', 'opacity-100');
      volleyballModalContent.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        volleyballModal.classList.remove('flex');
        volleyballModal.classList.add('hidden');
      }, 300);
    };

    if (volleyballBtn) {
      volleyballBtn.addEventListener('click', (e) => {
        e.preventDefault();
        openVolleyballModal();
      });
    }

    if (volleyballModalClose) {
      volleyballModalClose.addEventListener('click', (e) => {
        e.preventDefault();
        closeVolleyballModal();
      });
    }

    if (volleyballModal) {
      volleyballModal.addEventListener('click', (e) => {
        if (e.target === volleyballModal) {
          closeVolleyballModal();
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeVolleyballModal();
      }
    });

    const triggerMotionToast = (desc: string, href: string): void => {
      // 1. Closes previous menu (if open)
      closeVolleyballModal();

      if (redirectTimer !== null) {
        clearTimeout(redirectTimer);
        redirectTimer = null;
      }

      targetUrl = href;
      if (toastDesc) {
        toastDesc.textContent = desc;
      }

      if (toastBar) {
        toastBar.style.transitionDuration = '0ms';
        toastBar.style.width = '0%';
      }

      if (toastContainer && toastCard) {
        toastContainer.classList.remove('hidden', 'pointer-events-none');
        toastContainer.classList.add('flex', 'pointer-events-auto');

        // Trigger reflow for CSS transitions
        void toastContainer.offsetWidth;

        toastContainer.classList.remove('opacity-0');
        toastContainer.classList.add('opacity-100');

        // Entry animation: translate-y-4 opacity-0 to translate-y-0 opacity-100
        toastCard.classList.remove('translate-y-4', 'opacity-0');
        toastCard.classList.add('translate-y-0', 'opacity-100');

        if (toastBar) {
          requestAnimationFrame(() => {
            toastBar.style.transitionDuration = '2500ms';
            toastBar.style.width = '100%';
          });
        }
      }

      // 4. The Timer: 2.5s redirect
      redirectTimer = window.setTimeout(() => {
        if (targetUrl) {
          window.location.href = targetUrl;
        }
      }, 2500);
    };

    const campTriggers = document.querySelectorAll<HTMLElement>('.camp-trigger-btn');
    campTriggers.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const desc = btn.getAttribute('data-desc') || '';
        const href = btn.getAttribute('data-href') || '';
        triggerMotionToast(desc, href);
      });
    });

    // 5. The Skip Button: clearTimeout and redirect immediately
    if (toastSkipBtn) {
      toastSkipBtn.addEventListener('click', (e) => {
        e.preventDefault();
        if (redirectTimer !== null) {
          clearTimeout(redirectTimer);
          redirectTimer = null;
        }
        if (targetUrl) {
          window.location.href = targetUrl;
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroInteractions);
  } else {
    initHeroInteractions();
  }
  document.addEventListener('astro:page-load', initHeroInteractions);
</script>
