---
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations, getDirFromLocale } from '@/i18n/utils';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const dir = getDirFromLocale(locale);
---

<!-- Hero Section Container with Centered Interactive CTAs -->
<section
  id="hero-section"
  dir={dir}
  class="relative w-full min-h-[560px] h-[85svh] md:h-screen overflow-hidden flex items-center justify-center bg-[#080808] text-white border-b border-white/10"
>
  <!-- Desktop 3-Panel Split Background (Hidden on Mobile) -->
  <div class="hidden md:flex absolute inset-0 w-full h-full z-0 overflow-hidden">
    <!-- Panel 1: Volleyball -->
    <div
      class="hero-split-panel relative flex-1 h-full overflow-hidden transition-all duration-700 ease-out group/panel cursor-pointer"
    >
      <img
        src="/photos/volleyball.webp"
        alt="Volleyball"
        loading="eager"
        fetchpriority="high"
        class="w-full h-full object-cover object-center filter grayscale-[40%] contrast-110 group-hover/panel:grayscale-0 group-hover/panel:scale-105 transition-all duration-700 ease-out"
      />
      <div
        class="absolute inset-0 bg-black/30 group-hover/panel:bg-black/10 transition-colors duration-500 pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-8 left-8 z-10 font-mono text-[10px] uppercase tracking-[0.25em] text-white/40 group-hover/panel:text-[#E5383B] transition-colors duration-300 pointer-events-none hidden lg:block"
      >
        01 / Volleyball
      </div>
    </div>

    <!-- Panel 2: Football -->
    <div
      class="hero-split-panel relative flex-1 h-full overflow-hidden transition-all duration-700 ease-out border-x border-white/5 group/panel cursor-pointer"
    >
      <img
        src="/photos/football.webp"
        alt="Football"
        loading="eager"
        class="w-full h-full object-cover object-center filter grayscale-[40%] contrast-110 group-hover/panel:grayscale-0 group-hover/panel:scale-105 transition-all duration-700 ease-out"
      />
      <div
        class="absolute inset-0 bg-black/30 group-hover/panel:bg-black/10 transition-colors duration-500 pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-8 left-8 z-10 font-mono text-[10px] uppercase tracking-[0.25em] text-white/40 group-hover/panel:text-[#E5383B] transition-colors duration-300 pointer-events-none hidden lg:block"
      >
        02 / Football
      </div>
    </div>

    <!-- Panel 3: Basketball -->
    <div
      class="hero-split-panel relative flex-1 h-full overflow-hidden transition-all duration-700 ease-out group/panel cursor-pointer"
    >
      <img
        src="/photos/basketball.webp"
        alt="Basketball"
        loading="eager"
        class="w-full h-full object-cover object-center filter grayscale-[40%] contrast-110 group-hover/panel:grayscale-0 group-hover/panel:scale-105 transition-all duration-700 ease-out"
      />
      <div
        class="absolute inset-0 bg-black/30 group-hover/panel:bg-black/10 transition-colors duration-500 pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-8 left-8 z-10 font-mono text-[10px] uppercase tracking-[0.25em] text-white/40 group-hover/panel:text-[#E5383B] transition-colors duration-300 pointer-events-none hidden lg:block"
      >
        03 / Basketball
      </div>
    </div>
  </div>

  <!-- Mobile Slideshow Container (Hidden on Desktop) -->
  <div
    id="hero-mobile-slideshow"
    class="md:hidden absolute inset-0 w-full h-full z-0 overflow-hidden"
    aria-hidden="true"
  >
    <div
      class="hero-mobile-slide absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out opacity-100"
    >
      <img
        src="/photos/volleyball.webp"
        alt="Volleyball"
        loading="eager"
        class="w-full h-full object-cover object-center"
      />
    </div>
    <div
      class="hero-mobile-slide absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out opacity-0"
    >
      <img
        src="/photos/football.webp"
        alt="Football"
        loading="eager"
        class="w-full h-full object-cover object-center"
      />
    </div>
    <div
      class="hero-mobile-slide absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out opacity-0"
    >
      <img
        src="/photos/basketball.webp"
        alt="Basketball"
        loading="eager"
        class="w-full h-full object-cover object-center"
      />
    </div>
  </div>

  <!-- Ambient Dark Overlays -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-[#080808] via-[#080808]/50 to-[#080808]/70 pointer-events-none z-10"
  >
  </div>
  <div class="absolute inset-0 bg-black/35 pointer-events-none z-10"></div>
  <!-- Dark Radial Gradient Overlay for Center Contrast -->
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(0,0,0,0.7)_0%,rgba(0,0,0,0.2)_70%)] z-10 pointer-events-none"
  >
  </div>

  <!-- Red Neon Ambient Accents -->
  <div
    class="absolute -top-32 right-0 w-[300px] sm:w-[350px] md:w-[500px] h-[300px] sm:h-[350px] md:h-[500px] bg-[#E5383B]/15 rounded-full blur-[100px] md:blur-[140px] pointer-events-none z-10"
  >
  </div>
  <div
    class="absolute -bottom-32 left-0 w-[300px] sm:w-[350px] md:w-[600px] h-[300px] sm:h-[350px] md:h-[600px] bg-[#B7094C]/15 rounded-full blur-[100px] md:blur-[160px] pointer-events-none z-10"
  >
  </div>

  <!-- Centered Hero CTAs (Desktop: 4 in a Row, Mobile: 2x2 Grid) -->
  <div
    class="relative z-20 grid grid-cols-2 md:grid-cols-4 items-center justify-center gap-3.5 sm:gap-5 md:gap-6 lg:gap-8 px-4 max-w-5xl mx-auto"
  >
    <!-- Button 1: Volleyball -->
    <button
      id="btn-volleyball-camps"
      type="button"
      class="aspect-square w-36 sm:w-40 md:w-44 lg:w-48 flex flex-col items-center justify-center gap-2.5 sm:gap-3 backdrop-blur-md bg-black/60 border border-white/10 hover:border-[#E5383B] transition-all duration-300 hover:scale-105 active:scale-95 group cursor-pointer p-3 sm:p-4 text-center shadow-[0_4px_30px_rgba(0,0,0,0.5)] hover:shadow-[0_0_30px_rgba(229,56,59,0.35)]"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="volleyball-modal"
    >
      <svg
        class="w-10 h-10 md:w-12 md:h-12 text-white group-hover:text-[#E5383B] transition-colors filter drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <circle cx="19.5" cy="4" r="1.8"></circle>
        <circle cx="12.5" cy="5.8" r="1.6"></circle>
        <path d="M13.2 7.6 L17.5 4.8 L18.6 6.2 L14.6 8.8 Z"></path>
        <path d="M11.6 8.5 L8.4 10.4 L9.2 11.8 L12.3 10 Z"></path>
        <path
          d="M11.2 7.6 C12 7.6 13.2 8.5 13 10.5 L12.5 13.8 C12.2 14.5 11.8 15 11 15 C10.4 15 10 14.5 10.2 13.8 L10.8 10.5 C11 8.8 10.6 7.6 11.2 7.6 Z"
        ></path>
        <path d="M10.8 14.2 L8.2 18 L6.2 17.2 L9.2 13.5 Z"></path>
        <path d="M11.8 14.2 L14.8 18.2 L13.8 21.2 L12.2 20.8 L13 18.5 L10.8 14.8 Z"></path>
      </svg>
      <span
        class="font-barlow font-bold text-sm md:text-base tracking-wide text-white group-hover:text-[#E5383B] transition-colors text-center leading-snug"
      >
        {t('camps.volleyball')}
      </span>
    </button>

    <!-- Button 2: Player Camps -->
    <a
      href={`/${locale}/camps/player`}
      class="aspect-square w-36 sm:w-40 md:w-44 lg:w-48 flex flex-col items-center justify-center gap-2.5 sm:gap-3 backdrop-blur-md bg-black/60 border border-white/10 hover:border-[#E5383B] transition-all duration-300 hover:scale-105 active:scale-95 group cursor-pointer p-3 sm:p-4 text-center shadow-[0_4px_30px_rgba(0,0,0,0.5)] hover:shadow-[0_0_30px_rgba(229,56,59,0.35)]"
    >
      <svg
        class="w-10 h-10 md:w-12 md:h-12 text-white group-hover:text-[#E5383B] transition-colors filter drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <circle cx="16" cy="4.5" r="1.7"></circle>
        <path d="M14.6 7.2 L18.4 10 L17.4 11.3 L13.8 8.6 Z"></path>
        <path d="M12.5 8.2 L8.8 9.6 L9.4 11.1 L12.2 9.8 Z"></path>
        <path d="M14.2 6.8 L11.2 12.8 C11 13.3 10.5 13.7 9.8 13.6 L11.2 11.8 L13 6.8 Z"></path>
        <path d="M10.8 12.8 L15.2 14.8 L14 19.5 L12.4 19.1 L13.4 15.6 L10 13.8 Z"></path>
        <path d="M10.2 13.2 L6.8 16.2 L3.6 17.8 L4.4 19.2 L7.4 17.6 L10.8 14 Z"></path>
      </svg>
      <span
        class="font-barlow font-bold text-sm md:text-base tracking-wide text-white group-hover:text-[#E5383B] transition-colors text-center leading-snug"
      >
        {t('camps.player')}
      </span>
    </a>

    <!-- Button 3: Football -->
    <a
      href={`/${locale}/football-camps`}
      class="aspect-square w-36 sm:w-40 md:w-44 lg:w-48 flex flex-col items-center justify-center gap-2.5 sm:gap-3 backdrop-blur-md bg-black/60 border border-white/10 hover:border-[#E5383B] transition-all duration-300 hover:scale-105 active:scale-95 group cursor-pointer p-3 sm:p-4 text-center shadow-[0_4px_30px_rgba(0,0,0,0.5)] hover:shadow-[0_0_30px_rgba(229,56,59,0.35)]"
    >
      <svg
        class="w-10 h-10 md:w-12 md:h-12 text-white group-hover:text-[#E5383B] transition-colors filter drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <circle cx="20.5" cy="18" r="1.8"></circle>
        <circle cx="9.2" cy="4.8" r="1.7"></circle>
        <path d="M9 7.2 L5.8 5.6 L5 7 L8 8.4 Z"></path>
        <path d="M10.5 8 L14.2 9.2 L13.8 10.8 L10.2 9.6 Z"></path>
        <path
          d="M8.8 7 C9.5 7 10.6 8.2 10.8 10.2 L11 13.2 C11 13.8 10.5 14.4 9.8 14.4 C9.2 14.4 8.8 13.8 8.9 13.2 L9.2 10.2 C9.2 8.5 8.3 7 8.8 7 Z"
        ></path>
        <path d="M9.4 13.6 L8 17.2 L7.2 21.2 L9 21.4 L9.6 17.8 L10.8 14 Z"></path>
        <path d="M10.5 13.5 L14.8 14.5 L18.8 17.2 L17.8 18.6 L14.2 16.2 L10.2 14.6 Z"></path>
      </svg>
      <span
        class="font-barlow font-bold text-sm md:text-base tracking-wide text-white group-hover:text-[#E5383B] transition-colors text-center leading-snug"
      >
        {t('camps.football')}
      </span>
    </a>

    <!-- Button 4: Basketball -->
    <a
      href="/coming-soon"
      class="aspect-square w-36 sm:w-40 md:w-44 lg:w-48 flex flex-col items-center justify-center gap-2.5 sm:gap-3 backdrop-blur-md bg-black/60 border border-white/10 hover:border-[#E5383B] transition-all duration-300 hover:scale-105 active:scale-95 group cursor-pointer p-3 sm:p-4 text-center shadow-[0_4px_30px_rgba(0,0,0,0.5)] hover:shadow-[0_0_30px_rgba(229,56,59,0.35)]"
    >
      <svg
        class="w-10 h-10 md:w-12 md:h-12 text-white group-hover:text-[#E5383B] transition-colors filter drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <circle cx="18" cy="3.5" r="1.8"></circle>
        <circle cx="11.5" cy="6.2" r="1.7"></circle>
        <path d="M12.2 7.8 L15.6 4.8 L16.8 6 L13.5 8.8 Z"></path>
        <path d="M10.5 8.5 L7.8 10.8 L8.6 12.2 L11.2 10 Z"></path>
        <path
          d="M11.5 7.6 C12.2 7.6 12.8 8.8 12.6 10.8 L12.2 13.8 C12 14.5 11.5 15 10.8 15 C10.2 15 9.8 14.5 10 13.8 L10.4 10.8 C10.6 8.8 10.8 7.6 11.5 7.6 Z"
        ></path>
        <path d="M11.6 14.2 L14.5 17.2 L13.2 21.2 L11.6 20.8 L12.6 17.8 L10.6 14.8 Z"></path>
        <path d="M10.5 14.2 L7.8 17.2 L6 20.2 L7.4 21 L9.2 18 L11.2 14.8 Z"></path>
      </svg>
      <span
        class="font-barlow font-bold text-sm md:text-base tracking-wide text-white group-hover:text-[#E5383B] transition-colors text-center leading-snug"
      >
        {t('camps.basketball')}
      </span>
    </a>
  </div>
</section>

<!-- Full-screen Blurred Modal for Volleyball -->
<div
  id="volleyball-modal"
  class="fixed inset-0 backdrop-blur-xl bg-black/60 z-50 hidden items-center justify-center p-4 transition-opacity duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="volleyball-modal-title"
>
  <div
    id="volleyball-modal-content"
    class="relative w-full max-w-lg bg-[#0e0e0e]/95 border border-white/15 p-6 sm:p-8 md:p-10 shadow-[0_0_50px_rgba(0,0,0,0.8)] backdrop-blur-2xl flex flex-col items-center transform transition-all duration-300 ease-out scale-95 opacity-0 translate-y-4"
  >
    <!-- Modal Close Button (Top-Right) -->
    <button
      id="volleyball-modal-close"
      type="button"
      class="absolute top-4 right-4 text-white/60 hover:text-white p-2 transition-colors cursor-pointer"
      aria-label="Close"
    >
      <svg
        class="w-6 h-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div
      class="inline-flex items-center gap-2 px-3 py-1 bg-[#E5383B]/10 border border-[#E5383B]/30 text-[#E5383B] font-mono text-[10px] uppercase tracking-[0.2em] mb-4"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-[#E5383B] animate-pulse"></span>
      <span>SPORTIVERF</span>
    </div>

    <h3
      id="volleyball-modal-title"
      class="font-barlow font-bold text-xl md:text-2xl tracking-wide text-white mb-6 text-center"
    >
      {t('camps.volleyball')}
    </h3>

    <!-- Sub-options: Team Camps & Friendly Matches with Motion Animation -->
    <div
      id="volleyball-options-container"
      class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 w-full"
    >
      <!-- Team Camps Button -->
      <a
        href={`/${locale}/camps/team`}
        class="volleyball-modal-option aspect-square w-36 sm:w-40 md:w-44 flex flex-col items-center justify-center gap-3 backdrop-blur-md bg-black/40 border border-white/10 hover:border-[#E5383B] transition-all duration-300 hover:scale-105 active:scale-95 text-white group cursor-pointer p-4 shadow-lg hover:shadow-[0_0_20px_rgba(229,56,59,0.3)] text-center transform translate-y-6 opacity-0"
      >
        <svg
          class="w-8 h-8 md:w-10 md:h-10 text-white group-hover:text-[#E5383B] transition-colors"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <span
          class="font-barlow font-bold text-xs sm:text-sm tracking-wide text-center leading-snug"
        >
          {t('camps.team')}
        </span>
      </a>

      <!-- Friendly Matches Button -->
      <a
        href={`/${locale}/camps/friendly`}
        class="volleyball-modal-option aspect-square w-36 sm:w-40 md:w-44 flex flex-col items-center justify-center gap-3 backdrop-blur-md bg-black/40 border border-white/10 hover:border-[#E5383B] transition-all duration-300 hover:scale-105 active:scale-95 text-white group cursor-pointer p-4 shadow-lg hover:shadow-[0_0_20px_rgba(229,56,59,0.3)] text-center transform translate-y-6 opacity-0"
      >
        <svg
          class="w-8 h-8 md:w-10 md:h-10 text-white group-hover:text-[#E5383B] transition-colors"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m11 17 2 2a1 1 0 0 0 1.4 0l4.3-4.3a1 1 0 0 0 0-1.4l-3-3a1 1 0 0 0-1.4 0l-1.3 1.3"
          ></path>
          <path d="m14 11-1.3-1.3a1 1 0 0 0-1.4 0L7 14"></path>
          <path d="m7 7 3-3a1 1 0 0 1 1.4 0l3 3"></path>
          <path d="M2 14h6"></path>
          <path d="M22 10h-6"></path>
          <path d="m2 14 3-3a1 1 0 0 1 1.4 0L10 14"></path>
        </svg>
        <span
          class="font-barlow font-bold text-xs sm:text-sm tracking-wide text-center leading-snug"
        >
          {t('camps.friendly')}
        </span>
      </a>
    </div>

    <!-- Skip / Close Button -->
    <button
      id="volleyball-modal-skip"
      type="button"
      class="mt-8 px-6 py-2.5 bg-white/10 hover:bg-[#E5383B] text-white border border-white/20 hover:border-[#E5383B] text-xs font-mono tracking-wider font-semibold transition-all duration-200 cursor-pointer shadow-md hover:shadow-[0_0_20px_rgba(229,56,59,0.4)] active:scale-95"
    >
      {locale === 'tr' ? 'Kapat / Geç' : 'Skip / Close'} &times;
    </button>
  </div>
</div>

<style>
  .hero-split-panel {
    flex: 1;
    transition:
      flex 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.5s ease;
  }
  .hero-split-panel:hover {
    flex: 1.45;
  }
</style>

<script>
  function initHeroInteractions(): void {
    // --- 1. Volleyball Modal Logic (Instant Motion, No Loading Delay) ---
    const volleyballBtn = document.getElementById('btn-volleyball-camps');
    const volleyballModal = document.getElementById('volleyball-modal');
    const volleyballModalContent = document.getElementById('volleyball-modal-content');
    const volleyballModalClose = document.getElementById('volleyball-modal-close');
    const volleyballModalSkip = document.getElementById('volleyball-modal-skip');

    const openVolleyballModal = (): void => {
      if (!volleyballModal || !volleyballModalContent) return;
      volleyballBtn?.setAttribute('aria-expanded', 'true');
      volleyballModal.classList.remove('hidden');
      volleyballModal.classList.add('flex');

      // Force layout reflow
      void volleyballModal.offsetWidth;

      // Instant backdrop blur and modal card entrance
      volleyballModal.classList.remove('opacity-0');
      volleyballModal.classList.add('opacity-100');
      volleyballModalContent.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
      volleyballModalContent.classList.add('scale-100', 'opacity-100', 'translate-y-0');

      // Staggered animated motion for sub-options
      const modalOptions = volleyballModal.querySelectorAll<HTMLElement>(
        '.volleyball-modal-option'
      );
      modalOptions.forEach((option, index) => {
        setTimeout(
          () => {
            option.classList.remove('translate-y-6', 'opacity-0');
            option.classList.add('translate-y-0', 'opacity-100');
          },
          80 + index * 90
        );
      });
    };

    const closeVolleyballModal = (): void => {
      if (!volleyballModal || !volleyballModalContent) return;
      volleyballBtn?.setAttribute('aria-expanded', 'false');

      const modalOptions = volleyballModal.querySelectorAll<HTMLElement>(
        '.volleyball-modal-option'
      );
      modalOptions.forEach((option) => {
        option.classList.remove('translate-y-0', 'opacity-100');
        option.classList.add('translate-y-6', 'opacity-0');
      });

      volleyballModal.classList.remove('opacity-100');
      volleyballModal.classList.add('opacity-0');
      volleyballModalContent.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
      volleyballModalContent.classList.add('scale-95', 'opacity-0', 'translate-y-4');

      setTimeout(() => {
        volleyballModal.classList.remove('flex');
        volleyballModal.classList.add('hidden');
      }, 300);
    };

    volleyballBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      openVolleyballModal();
    });

    volleyballModalClose?.addEventListener('click', (e) => {
      e.preventDefault();
      closeVolleyballModal();
    });

    volleyballModalSkip?.addEventListener('click', (e) => {
      e.preventDefault();
      closeVolleyballModal();
    });

    volleyballModal?.addEventListener('click', (e) => {
      if (e.target === volleyballModal) {
        closeVolleyballModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeVolleyballModal();
      }
    });

    // --- 2. Mobile Hero Image Slideshow (Fades every 1.3 seconds / 1300ms) ---
    const mobileSlides = document.querySelectorAll<HTMLElement>('.hero-mobile-slide');
    if (mobileSlides.length > 1) {
      let currentSlideIdx = 0;
      const slideTimer = window.setInterval(() => {
        mobileSlides[currentSlideIdx].classList.remove('opacity-100');
        mobileSlides[currentSlideIdx].classList.add('opacity-0');

        currentSlideIdx = (currentSlideIdx + 1) % mobileSlides.length;

        mobileSlides[currentSlideIdx].classList.remove('opacity-0');
        mobileSlides[currentSlideIdx].classList.add('opacity-100');
      }, 1300);

      // Clean up interval if navigating away
      document.addEventListener(
        'astro:before-swap',
        () => {
          clearInterval(slideTimer);
        },
        { once: true }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroInteractions);
  } else {
    initHeroInteractions();
  }
  document.addEventListener('astro:page-load', initHeroInteractions);
</script>
