---
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations, getDirFromLocale } from '@/i18n/utils';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const dir = getDirFromLocale(locale);
---

<!-- Mobile Sticky Sub-Header with Quick-Access CTAs (Hides when scrolled past Hero) -->
<div
  id="mobile-hero-sub-header"
  class="fixed top-20 left-0 w-full z-40 bg-[#0a0a0a]/85 backdrop-blur-md border-b border-white/10 transition-transform duration-300 ease-in-out md:hidden shadow-lg"
>
  <div class="px-3 py-2 max-w-lg mx-auto">
    <div class="grid grid-cols-2 gap-1.5">
      <!-- CTA 1: Volleyball Camps -->
      <a
        href={`/${locale}/volleyball-camps`}
        class="bg-gradient-to-r from-[#E5383B] to-[#B7094C] text-white shadow-[0_0_12px_rgba(229,56,59,0.3)] font-barlow font-bold text-[10px] sm:text-[11px] tracking-wider uppercase py-2 px-1.5 flex flex-col items-center justify-center gap-1 text-center border border-[#FF4D6D]/30 active:scale-95 transition-all group"
      >
        <svg
          class="w-4 h-4 text-white"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m4.93 4.93 4.24 4.24"></path>
          <path d="m14.83 9.17 4.24-4.24"></path>
          <path d="m14.83 14.83 4.24 4.24"></path>
          <path d="m9.17 14.83-4.24 4.24"></path>
          <circle cx="12" cy="12" r="4"></circle>
        </svg>
        <span class="leading-tight">{t('hero.btnVolleyball')}</span>
      </a>

      <!-- CTA 2: Volleyball Academic Camps -->
      <a
        href={`/${locale}/volleyball-camps`}
        class="bg-[#111111]/90 text-white border border-[#E5383B]/40 shadow-[0_0_10px_rgba(229,56,59,0.15)] font-barlow font-bold text-[10px] sm:text-[11px] tracking-wider uppercase py-2 px-1.5 flex flex-col items-center justify-center gap-1 text-center backdrop-blur-md active:scale-95 transition-all group"
      >
        <svg
          class="w-4 h-4 text-[#E5383B]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
          <path d="M6 6h10"></path>
          <path d="M6 10h10"></path>
        </svg>
        <span class="leading-tight">{t('hero.btnVolleyballAcademic')}</span>
      </a>

      <!-- CTA 3: College Volleyball Opportunities -->
      <a
        href={`/${locale}/volleyball-camps`}
        class="col-span-2 bg-white/10 text-white border border-white/20 shadow-[0_0_10px_rgba(255,255,255,0.08)] font-barlow font-bold text-[10px] sm:text-[11px] tracking-wider uppercase py-2 px-1.5 flex flex-col items-center justify-center gap-1 text-center backdrop-blur-md active:scale-95 transition-all group"
      >
        <svg
          class="w-4 h-4 text-white/90"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
          <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
        </svg>
        <span class="leading-tight">{t('hero.btnCollegeVolleyball')}</span>
      </a>
    </div>
  </div>
</div>

<section
  id="hero-section"
  dir={dir}
  class="relative min-h-screen md:min-h-[92vh] flex flex-col justify-between bg-[#080808] text-white border-b border-white/10 overflow-hidden w-full max-w-full"
>
  <!-- TOP: Image Wrapper (h-[75vh] on Mobile, absolute full screen on Desktop) -->
  <div class="relative w-full h-[75vh] md:h-full md:absolute md:inset-0 z-0 overflow-hidden">
    <!-- Responsive Picture Tag Serving Mobile Asset on Mobile Viewports with Dynamic Red Hue Shift -->
    <picture class="absolute inset-0 w-full h-full block z-0">
      <source media="(max-width: 767px)" srcset="/images/hero-mobile.webp" type="image/webp" />
      <source media="(min-width: 768px)" srcset="/images/hero-bg.webp" type="image/webp" />
      <img
        src="/images/hero-bg.jpg"
        alt="SPORTIVERF Elite Athletic Arena"
        loading="eager"
        fetchpriority="high"
        class="w-full h-full object-cover object-center opacity-90 filter hue-rotate-[130deg] saturate-[1.3] transition-all duration-700"
      />
    </picture>

    <!-- Dark Gradient Overlay (Bottom 50% of Image Wrapper) -->
    <div
      class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-[#080808] via-[#080808]/80 to-transparent pointer-events-none z-10"
    >
    </div>

    <!-- Desktop Ambient Overlays -->
    <div
      class="hidden md:block absolute inset-0 bg-gradient-to-b from-[#080808] via-[#080808]/40 to-transparent pointer-events-none z-10"
    >
    </div>

    <!-- Red Neon Ambient Accents -->
    <div
      class="absolute -top-32 right-0 w-[350px] md:w-[500px] h-[350px] md:h-[500px] bg-[#E5383B]/15 rounded-full blur-[120px] md:blur-[140px] pointer-events-none z-10"
    >
    </div>
    <div
      class="absolute -bottom-32 left-0 w-[350px] md:w-[600px] h-[350px] md:h-[600px] bg-[#B7094C]/15 rounded-full blur-[120px] md:blur-[160px] pointer-events-none z-10"
    >
    </div>

    <!-- Mobile Badge & Main H1 Title (Positioned Absolute Bottom-6 Overlapping Image Fade) -->
    <div
      class="absolute bottom-6 left-0 w-full px-5 z-20 md:hidden flex flex-col items-start text-start"
    >
      <!-- Top Tagline Badge -->
      <div
        class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-[#E5383B]/10 border border-[#E5383B]/40 text-[#E5383B] font-mono text-[10px] sm:text-xs uppercase tracking-[0.2em] backdrop-blur-md shadow-[0_0_15px_rgba(229,56,59,0.2)] rounded-none mb-3"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-[#E5383B] animate-pulse"></span>
        <span>{t('hero.badge')}</span>
      </div>

      <!-- Main H1 Headline (+15% Mobile Font Size Preserved) -->
      <h1
        class="font-barlow font-black text-[38px] sm:text-[61px] uppercase tracking-tight text-white leading-[0.92] drop-shadow-[0_4px_16px_rgba(0,0,0,0.9)] text-start"
      >
        {t('hero.title')}
      </h1>
    </div>
  </div>

  <!-- BOTTOM: CTA Buttons Container Below Image Wrapper on Mobile (Overlay on Desktop) -->
  <div
    class="w-full max-w-[1400px] mx-auto px-5 py-6 md:pt-36 md:pb-20 hidden md:flex flex-col relative z-20 flex-1 justify-start md:justify-center items-start text-start bg-[#080808] md:bg-transparent"
  >
    <!-- Desktop Tagline Badge -->
    <div
      class="hidden md:inline-flex items-center gap-2 px-3.5 py-1.5 bg-[#E5383B]/10 border border-[#E5383B]/40 text-[#E5383B] font-mono text-xs uppercase tracking-[0.22em] mb-6 backdrop-blur-md shadow-[0_0_15px_rgba(229,56,59,0.2)] rounded-none"
    >
      <span class="w-2 h-2 rounded-full bg-[#E5383B] animate-pulse"></span>
      <span>{t('hero.badge')}</span>
    </div>

    <!-- Desktop Main H1 Headline -->
    <h1
      class="hidden md:block font-barlow font-black md:text-[86px] lg:text-[115px] uppercase tracking-tight text-white max-w-5xl leading-[0.92] mb-6 drop-shadow-[0_10px_25px_rgba(0,0,0,0.9)] text-start"
    >
      {t('hero.title')}
    </h1>

    <!-- Desktop Subtitle -->
    <p
      class="hidden md:block font-sans text-base md:text-xl text-[#DDDDDD] max-w-2xl font-light mb-10 leading-relaxed drop-shadow-md text-start"
    >
      {t('hero.subtitle')}
    </p>

    <!-- Interactive CTA Buttons (Desktop Viewport Only) with Centered Icons Above Text -->
    <div class="relative w-full max-w-4xl my-2 md:my-4">
      <div class="flex flex-wrap items-center gap-3 sm:gap-6 z-20 justify-start">
        <!-- CTA 1: Volleyball Camps -->
        <a
          href={`/${locale}/volleyball-camps`}
          class="bg-gradient-to-r from-[#E5383B] to-[#B7094C] hover:from-[#FF4D6D] hover:to-[#E5383B] text-white shadow-[0_0_25px_rgba(229,56,59,0.4)] hover:shadow-[0_0_35px_rgba(229,56,59,0.7)] transition-all duration-300 font-barlow font-bold text-xs sm:text-sm tracking-[0.14em] uppercase py-3.5 px-6 flex flex-col items-center justify-center gap-1.5 text-center relative border border-[#FF4D6D]/30 min-w-[200px] group"
        >
          <svg
            class="w-5 h-5 text-white"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="m4.93 4.93 4.24 4.24"></path>
            <path d="m14.83 9.17 4.24-4.24"></path>
            <path d="m14.83 14.83 4.24 4.24"></path>
            <path d="m9.17 14.83-4.24 4.24"></path>
            <circle cx="12" cy="12" r="4"></circle>
          </svg>
          <span class="leading-tight">{t('hero.btnVolleyball')}</span>
        </a>

        <!-- CTA 2: Volleyball Academic Camps -->
        <a
          href={`/${locale}/volleyball-camps`}
          class="bg-[#111111]/80 hover:bg-[#E5383B] text-white border border-[#E5383B]/40 hover:border-[#E5383B] shadow-[0_0_20px_rgba(229,56,59,0.15)] hover:shadow-[0_0_30px_rgba(229,56,59,0.5)] transition-all duration-300 font-barlow font-bold text-xs sm:text-sm tracking-[0.14em] uppercase py-3.5 px-6 flex flex-col items-center justify-center gap-1.5 text-center backdrop-blur-md relative min-w-[200px] group"
        >
          <svg
            class="w-5 h-5 text-[#E5383B] group-hover:text-white transition-colors"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
            <path d="M6 6h10"></path>
            <path d="M6 10h10"></path>
          </svg>
          <span class="leading-tight">{t('hero.btnVolleyballAcademic')}</span>
        </a>

        <!-- CTA 3: College Volleyball Opportunities -->
        <a
          href={`/${locale}/volleyball-camps`}
          class="bg-white/10 hover:bg-white text-white hover:text-[#0D0D0D] border border-white/20 hover:border-white shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_25px_rgba(255,255,255,0.4)] transition-all duration-300 font-barlow font-bold text-xs sm:text-sm tracking-[0.14em] uppercase py-3.5 px-6 flex flex-col items-center justify-center gap-1.5 text-center backdrop-blur-md relative min-w-[220px] group"
        >
          <svg
            class="w-5 h-5 text-white/90 group-hover:text-[#0D0D0D] transition-colors"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
          </svg>
          <span class="leading-tight">{t('hero.btnCollegeVolleyball')}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Mobile Sticky Sub-Header Scroll Logic
    const heroSection = document.getElementById('hero-section');
    const subHeader = document.getElementById('mobile-hero-sub-header');

    if (heroSection && subHeader) {
      let ticking = false;
      const handleSubHeaderScroll = (): void => {
        const hideThreshold = heroSection.offsetHeight + 200;
        if (window.scrollY > hideThreshold) {
          subHeader.classList.add('-translate-y-[200%]', 'pointer-events-none');
        } else {
          subHeader.classList.remove('-translate-y-[200%]', 'pointer-events-none');
        }
        ticking = false;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            requestAnimationFrame(handleSubHeaderScroll);
            ticking = true;
          }
        },
        { passive: true }
      );

      handleSubHeaderScroll();
    }
  });
</script>
