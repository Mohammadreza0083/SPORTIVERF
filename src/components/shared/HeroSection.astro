---
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations, getDirFromLocale } from '@/i18n/utils';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const dir = getDirFromLocale(locale);
---

<!-- Hero Section Container with Centered Interactive CTAs -->
<section
  id="hero-section"
  dir={dir}
  class="relative w-full min-h-[560px] h-[85svh] md:h-screen overflow-hidden flex items-start justify-center pt-32 md:pt-40 bg-[#080808] text-white border-b border-white/10"
>
  <!-- Desktop 3-Panel Split Background (Hidden on Mobile) -->
  <div class="hidden md:flex absolute inset-0 w-full h-full z-0 overflow-hidden">
    <!-- Panel 1: Volleyball -->
    <div
      class="hero-split-panel relative flex-1 h-full overflow-hidden transition-all duration-700 ease-out group/panel cursor-pointer"
    >
      <img
        src="/photos/volleyball.webp"
        alt="Volleyball"
        loading="eager"
        fetchpriority="high"
        class="w-full h-full object-cover object-center filter grayscale-[10%] contrast-105 group-hover/panel:grayscale-0 group-hover/panel:scale-105 transition-all duration-700 ease-out"
      />
      <div
        class="absolute inset-0 bg-black/15 group-hover/panel:bg-transparent transition-colors duration-500 pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-8 left-8 z-10 font-mono text-[10px] uppercase tracking-[0.25em] text-white/40 group-hover/panel:text-[#E5383B] transition-colors duration-300 pointer-events-none hidden lg:block"
      >
        01 / Volleyball
      </div>
    </div>

    <!-- Panel 2: Football -->
    <div
      class="hero-split-panel relative flex-1 h-full overflow-hidden transition-all duration-700 ease-out border-x border-white/5 group/panel cursor-pointer"
    >
      <img
        src="/photos/football.webp"
        alt="Football"
        loading="eager"
        class="w-full h-full object-cover object-center filter grayscale-[10%] contrast-105 group-hover/panel:grayscale-0 group-hover/panel:scale-105 transition-all duration-700 ease-out"
      />
      <div
        class="absolute inset-0 bg-black/15 group-hover/panel:bg-transparent transition-colors duration-500 pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-8 left-8 z-10 font-mono text-[10px] uppercase tracking-[0.25em] text-white/40 group-hover/panel:text-[#E5383B] transition-colors duration-300 pointer-events-none hidden lg:block"
      >
        02 / Football
      </div>
    </div>

    <!-- Panel 3: Basketball -->
    <div
      class="hero-split-panel relative flex-1 h-full overflow-hidden transition-all duration-700 ease-out group/panel cursor-pointer"
    >
      <img
        src="/photos/basketball.webp"
        alt="Basketball"
        loading="eager"
        class="w-full h-full object-cover object-center filter grayscale-[10%] contrast-105 group-hover/panel:grayscale-0 group-hover/panel:scale-105 transition-all duration-700 ease-out"
      />
      <div
        class="absolute inset-0 bg-black/15 group-hover/panel:bg-transparent transition-colors duration-500 pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-8 left-8 z-10 font-mono text-[10px] uppercase tracking-[0.25em] text-white/40 group-hover/panel:text-[#E5383B] transition-colors duration-300 pointer-events-none hidden lg:block"
      >
        03 / Basketball
      </div>
    </div>
  </div>

  <!-- Mobile Slideshow Container (Hidden on Desktop) -->
  <div
    id="hero-mobile-slideshow"
    class="md:hidden absolute inset-0 w-full h-full z-0 overflow-hidden"
    aria-hidden="true"
  >
    <div
      class="hero-mobile-slide absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out opacity-100"
    >
      <img
        src="/photos/volleyball.webp"
        alt="Volleyball"
        loading="eager"
        class="w-full h-full object-cover object-center"
      />
    </div>
    <div
      class="hero-mobile-slide absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out opacity-0"
    >
      <img
        src="/photos/football.webp"
        alt="Football"
        loading="eager"
        class="w-full h-full object-cover object-center"
      />
    </div>
    <div
      class="hero-mobile-slide absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out opacity-0"
    >
      <img
        src="/photos/basketball.webp"
        alt="Basketball"
        loading="eager"
        class="w-full h-full object-cover object-center"
      />
    </div>
  </div>

  <!-- Ambient Overlays (Lightened for Vibrant Background Photos) -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-[#080808]/80 via-transparent to-black/20 pointer-events-none z-10"
  >
  </div>
  <div class="absolute inset-0 bg-black/20 pointer-events-none z-10"></div>

  <!-- Red Neon Ambient Accents -->
  <div
    class="absolute -top-32 right-0 w-[300px] sm:w-[350px] md:w-[500px] h-[300px] sm:h-[350px] md:h-[500px] bg-[#E5383B]/15 rounded-full blur-[100px] md:blur-[140px] pointer-events-none z-10"
  >
  </div>
  <div
    class="absolute -bottom-32 left-0 w-[300px] sm:w-[350px] md:w-[600px] h-[300px] sm:h-[350px] md:h-[600px] bg-[#B7094C]/15 rounded-full blur-[100px] md:blur-[160px] pointer-events-none z-10"
  >
  </div>

  <!-- Hero CTAs (2x2 Grid) -->
  <div
    class="relative z-20 grid grid-cols-2 md:grid-cols-4 items-center justify-center gap-x-4 sm:gap-x-6 gap-y-8 md:gap-6 lg:gap-8 px-4 max-w-5xl mx-auto"
  >
    <!-- Button 1: Volleyball (Top Left) -->
    <button
      id="btn-volleyball-camps"
      type="button"
      class="animate-subtle-glow aspect-square w-36 sm:w-40 md:w-44 lg:w-48 flex flex-col items-center justify-center gap-2.5 sm:gap-3 backdrop-blur-md bg-black/40 border border-[#E5383B] transition-all duration-300 hover:scale-105 active:scale-95 group cursor-pointer p-3 sm:p-4 text-center hover:shadow-[0_0_30px_rgba(229,56,59,0.35)]"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="volleyball-modal"
    >
      <svg
        class="w-10 h-10 md:w-12 md:h-12 text-white group-hover:text-[#E5383B] transition-colors filter drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]"
        viewBox="0 0 512 512"
        fill="currentColor"
      >
        <path
          d="M512 258.9c-23.4 8-47.8 13.1-72.6 15.1 5.9-98.6-30.7-191.1-94.9-258.3 97.8 36 167.5 130 167.5 240.3 0 1 0 1.9 0 2.9zm-5.9 52c-5.2 23.7-13.6 46.2-24.9 66.9-94.7 52.2-214 50-308.4-13.6 21.7-31.3 49.8-58.9 83.8-80.5 79.5 41.6 168.5 49.1 249.5 27.1zM279.7 241.6c-3.7-89.7-41.7-170.5-101.3-229.7 22.3-7.1 46-11.2 70.5-11.9 92.5 55.9 150.3 160.3 142.4 273.8-38-3.2-75.9-13.7-111.6-32.3zM130.5 32.8C149.1 49.1 165.8 67.7 179.9 88.2 91.5 132.3 29.7 210.3 3.7 299.5 1.3 285.3 0 270.8 0 256 0 160.2 52.6 76.7 130.5 32.8zm73.4 97c16.3 34.5 26.1 72.6 27.9 112.8-75.8 48-126.8 121.3-148.3 202.5-17.6-16.1-33-34.6-45.5-55 2.1-108.1 63.7-210.4 165.9-260.3zM256 512c-47.7 0-92.3-13-130.5-35.7 4.8-24.3 12.6-48 23.2-70.4 82.4 54.4 180.8 68.9 271 47-44.4 37-101.5 59.2-163.7 59.2z"
        ></path>
      </svg>
      <span
        class="font-barlow font-bold text-sm md:text-base tracking-wide text-white group-hover:text-[#E5383B] transition-colors text-center leading-snug"
      >
        {t('camps.volleyball')}
      </span>
    </button>

    <!-- Button 2: Football (Top Right) -->
    <a
      href={`/${locale}/football-camps`}
      class="animate-subtle-glow aspect-square w-36 sm:w-40 md:w-44 lg:w-48 flex flex-col items-center justify-center gap-2.5 sm:gap-3 backdrop-blur-md bg-black/40 border border-[#E5383B] transition-all duration-300 hover:scale-105 active:scale-95 group cursor-pointer p-3 sm:p-4 text-center hover:shadow-[0_0_30px_rgba(229,56,59,0.35)]"
    >
      <svg
        class="w-10 h-10 md:w-12 md:h-12 text-white group-hover:text-[#E5383B] transition-colors filter drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]"
        viewBox="0 0 512 512"
        fill="currentColor"
      >
        <path
          d="M256 48C141.31 48 48 141.31 48 256s93.31 208 208 208 208-93.31 208-208S370.69 48 256 48zm143 304h-45.22a8 8 0 01-6.91-4l-16.14-27.68a8 8 0 01-.86-6l14.86-59.92a8 8 0 014.65-5.45l28.1-11.9a8 8 0 018.34 1.3l41.63 35.82a8 8 0 012.69 7.26 174.75 174.75 0 01-24.28 66.68A8 8 0 01399 352zM134.52 237.13l28.1 11.9a8 8 0 014.65 5.45l14.86 59.92a8 8 0 01-.86 6L165.13 348a8 8 0 01-6.91 4H113a8 8 0 01-6.82-3.81 174.75 174.75 0 01-24.28-66.68 8 8 0 012.69-7.26l41.63-35.82a8 8 0 018.3-1.3zm256.94-87.24l-18.07 51.38A8 8 0 01369 206l-29.58 12.53a8 8 0 01-8.26-1.24L274.9 170.1a8 8 0 01-2.9-6.1v-33.58a8 8 0 013.56-6.65l42.83-28.54a8 8 0 017.66-.67A176.92 176.92 0 01390 142a8 8 0 011.46 7.89zM193.6 95.23l42.84 28.54a8 8 0 013.56 6.65V164a8 8 0 01-2.86 6.13l-56.26 47.19a8 8 0 01-8.26 1.24L143 206a8 8 0 01-4.43-4.72L120.5 149.9a8 8 0 011.5-7.9 176.92 176.92 0 0164-47.48 8 8 0 017.6.71zm17.31 327.46L191.18 373a8 8 0 01.52-7l15.17-26a8 8 0 016.91-4h84.44a8 8 0 016.91 4l15.18 26a8 8 0 01.53 7l-19.59 49.67a8 8 0 01-5.69 4.87 176.58 176.58 0 01-79 0 8 8 0 01-5.65-4.85z"
        ></path>
      </svg>
      <span
        class="font-barlow font-bold text-sm md:text-base tracking-wide text-white group-hover:text-[#E5383B] transition-colors text-center leading-snug"
      >
        {t('camps.football')}
      </span>
    </a>

    <!-- Button 3: Basketball (Bottom Left) -->
    <a
      href="/coming-soon"
      class="animate-subtle-glow aspect-square w-36 sm:w-40 md:w-44 lg:w-48 flex flex-col items-center justify-center gap-2.5 sm:gap-3 backdrop-blur-md bg-black/40 border border-[#E5383B] transition-all duration-300 hover:scale-105 active:scale-95 group cursor-pointer p-3 sm:p-4 text-center hover:shadow-[0_0_30px_rgba(229,56,59,0.35)]"
    >
      <svg
        class="w-10 h-10 md:w-12 md:h-12 text-white group-hover:text-[#E5383B] transition-colors filter drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]"
        viewBox="0 0 512 512"
        fill="currentColor"
      >
        <path
          d="M92.7 58.8l78.4 78.4c18.2-25 28.9-55.9 28.9-89.2 0-14.1-1.9-27.7-5.5-40.6-38 9.4-72.6 27.2-101.8 51.4zM58.8 92.7c-24.2 29.2-42 63.8-51.4 101.8 12.9 3.6 26.5 5.5 40.6 5.5 33.3 0 64.1-10.7 89.2-28.9L58.8 92.7zM256 0c-4.6 0-9.2 .1-13.7 .4 3.7 15.3 5.7 31.2 5.7 47.6 0 46.6-15.9 89.4-42.6 123.4L256 222.1 419.3 58.8C374.9 22.1 318.1 0 256 0zM48 248c-16.4 0-32.4-2-47.6-5.7-.2 4.5-.4 9.1-.4 13.7 0 62.1 22.1 118.9 58.8 163.3L222.1 256 171.4 205.4C137.4 232.1 94.6 248 48 248zm463.6 21.7c.2-4.5 .4-9.1 .4-13.7 0-62.1-22.1-118.9-58.8-163.3L289.9 256 340.6 306.6c34-26.7 76.9-42.6 123.4-42.6 16.4 0 32.4 2 47.6 5.7zm-7.1 47.8c-12.9-3.6-26.5-5.5-40.6-5.5-33.3 0-64.1 10.7-89.2 28.9l78.4 78.4c24.2-29.2 42-63.8 51.4-101.8zM340.9 374.8c-18.2 25-28.9 55.9-28.9 89.2 0 14.1 1.9 27.7 5.5 40.6 38-9.4 72.6-27.2 101.8-51.4l-78.4-78.4zm-34.3-34.3L256 289.9 92.7 453.2c44.3 36.7 101.2 58.8 163.3 58.8 4.6 0 9.2-.1 13.7-.4-3.7-15.3-5.7-31.2-5.7-47.6 0-46.6 15.9-89.4 42.6-123.4z"
        ></path>
      </svg>
      <span
        class="font-barlow font-bold text-sm md:text-base tracking-wide text-white group-hover:text-[#E5383B] transition-colors text-center leading-snug"
      >
        {t('camps.basketball')}
      </span>
    </a>

    <!-- Button 4: Player Camps (Bottom Right) -->
    <a
      href={`/${locale}/camps/player`}
      class="animate-subtle-glow aspect-square w-36 sm:w-40 md:w-44 lg:w-48 flex flex-col items-center justify-center gap-2.5 sm:gap-3 backdrop-blur-md bg-black/40 border border-[#E5383B] transition-all duration-300 hover:scale-105 active:scale-95 group cursor-pointer p-3 sm:p-4 text-center hover:shadow-[0_0_30px_rgba(229,56,59,0.35)]"
    >
      <svg
        class="w-10 h-10 md:w-12 md:h-12 text-white group-hover:text-[#E5383B] transition-colors filter drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]"
        viewBox="0 0 512 512"
        fill="currentColor"
      >
        <path
          d="M256 0c4.6 0 9.2 1 13.4 2.9L457.8 82.8c22 9.3 38.4 31 38.3 57.2-.5 99.2-41.3 280.7-213.6 363.2-16.7 8-36.1 8-52.8 0-172.4-82.5-213.1-264-213.6-363.2-.1-26.2 16.3-47.9 38.3-57.2L242.7 2.9C246.9 1 251.4 0 256 0zm0 52L79 123.5c-.2 73.5 31.8 231.2 177 298.5 145.2-67.3 177.2-225 177-298.5L256 52zm0 68a48 48 0 1 1 0 96 48 48 0 0 1 0-96zm0 128c53 0 96 32.2 96 72v20c0 4.4-3.6 8-8 8H168c-4.4 0-8-3.6-8-8v-20c0-39.8 43-72 96-72z"
        ></path>
      </svg>
      <span
        class="font-barlow font-bold text-sm md:text-base tracking-wide text-white group-hover:text-[#E5383B] transition-colors text-center leading-snug"
      >
        {t('camps.player')}
      </span>
    </a>
  </div>
</section>

<!-- Full-screen Blurred Modal for Volleyball -->
<div
  id="volleyball-modal"
  class="fixed inset-0 backdrop-blur-xl bg-black/60 z-50 hidden items-center justify-center p-4 transition-opacity duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="volleyball-modal-title"
>
  <div
    id="volleyball-modal-content"
    class="relative w-full max-w-lg bg-[#0e0e0e]/95 border border-white/15 p-6 sm:p-8 md:p-10 shadow-[0_0_50px_rgba(0,0,0,0.8)] backdrop-blur-2xl flex flex-col items-center transform transition-all duration-300 ease-out scale-95 opacity-0 translate-y-4"
  >
    <!-- Modal Close Button (Top-Right) -->
    <button
      id="volleyball-modal-close"
      type="button"
      class="absolute top-4 right-4 text-white/60 hover:text-white p-2 transition-colors cursor-pointer"
      aria-label="Close"
    >
      <svg
        class="w-6 h-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div
      class="inline-flex items-center gap-2 px-3 py-1 bg-[#E5383B]/10 border border-[#E5383B]/30 text-[#E5383B] font-mono text-[10px] uppercase tracking-[0.2em] mb-4"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-[#E5383B] animate-pulse"></span>
      <span>SPORTIVERF</span>
    </div>

    <h3
      id="volleyball-modal-title"
      class="font-barlow font-bold text-xl md:text-2xl tracking-wide text-white mb-6 text-center"
    >
      {t('camps.volleyball')}
    </h3>

    <!-- Sub-options: Team Camps & Friendly Matches with Motion Animation -->
    <div
      id="volleyball-options-container"
      class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 w-full"
    >
      <!-- Team Camps Button -->
      <a
        href={`/${locale}/camps/team`}
        class="volleyball-modal-option aspect-square w-36 sm:w-40 md:w-44 flex flex-col items-center justify-center gap-3 backdrop-blur-md bg-black/40 border border-white/10 hover:border-[#E5383B] transition-all duration-300 hover:scale-105 active:scale-95 text-white group cursor-pointer p-4 shadow-lg hover:shadow-[0_0_20px_rgba(229,56,59,0.3)] text-center transform translate-y-6 opacity-0"
      >
        <svg
          class="w-8 h-8 md:w-10 md:h-10 text-white group-hover:text-[#E5383B] transition-colors filter drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]"
          viewBox="0 0 640 512"
          fill="currentColor"
        >
          <path
            d="M96 128a128 128 0 1 1 256 0A128 128 0 1 1 96 128zM0 482.3C0 383.8 79.8 304 178.3 304h91.4C368.2 304 448 383.8 448 482.3c0 16.4-13.3 29.7-29.7 29.7H29.7C13.3 512 0 498.7 0 482.3zM609.3 512H478.7c5.4-9.4 8.7-20.2 9.1-31.7 4.9-39.7-4-80-25.2-113.6C476 348.8 497.6 336 521.7 336h68.6C607 336 624 353 624 369.7V482.3c0 16.4-14.7 29.7-14.7 29.7zM480 96a96 96 0 1 1 0 192 96 96 0 1 1 0-192z"
          ></path>
        </svg>
        <span
          class="font-barlow font-bold text-xs sm:text-sm tracking-wide text-center leading-snug"
        >
          {t('camps.team')}
        </span>
      </a>

      <!-- Friendly Matches Button -->
      <a
        href={`/${locale}/camps/friendly`}
        class="volleyball-modal-option aspect-square w-36 sm:w-40 md:w-44 flex flex-col items-center justify-center gap-3 backdrop-blur-md bg-black/40 border border-white/10 hover:border-[#E5383B] transition-all duration-300 hover:scale-105 active:scale-95 text-white group cursor-pointer p-4 shadow-lg hover:shadow-[0_0_20px_rgba(229,56,59,0.3)] text-center transform translate-y-6 opacity-0"
      >
        <svg
          class="w-8 h-8 md:w-10 md:h-10 text-white group-hover:text-[#E5383B] transition-colors filter drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]"
          viewBox="0 0 576 512"
          fill="currentColor"
        >
          <path
            d="M268.9 85.2L152.3 214.8c-4.6 5.1-4.4 13 .5 17.9 30.5 30.5 80 30.5 110.5 0l31.8-31.8c4.2-4.2 9.5-6.5 14.9-6.9 6.8-.6 13.8 1.7 19 6.9L505.6 376 576 320 576 32 464 96 440.2 80.1C424.4 69.6 405.9 64 386.9 64l-70.4 0c-1.1 0-2.3 0-3.4 .1-16.9 .9-32.8 8.5-44.2 21.1zM116.6 182.7L223.4 64 183.8 64c-25.5 0-49.9 10.1-67.9 28.1L112 96 0 32 0 320 156.4 450.3c23 19.2 52 29.7 81.9 29.7l15.7 0-7-7c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0l41 41 9 0c19.1 0 37.8-4.3 54.8-12.3L359 441c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0l32 32 17.5-17.5c8.9-8.9 11.5-21.8 7.6-33.1l-137.9-136.8-14.9 14.9c-49.3 49.3-129.1 49.3-178.4 0-23-23-23.9-59.9-2.2-84z"
          ></path>
        </svg>
        <span
          class="font-barlow font-bold text-xs sm:text-sm tracking-wide text-center leading-snug"
        >
          {t('camps.friendly')}
        </span>
      </a>
    </div>

    <!-- Skip / Close Button -->
    <button
      id="volleyball-modal-skip"
      type="button"
      class="mt-8 px-6 py-2.5 bg-white/10 hover:bg-[#E5383B] text-white border border-white/20 hover:border-[#E5383B] text-xs font-mono tracking-wider font-semibold transition-all duration-200 cursor-pointer shadow-md hover:shadow-[0_0_20px_rgba(229,56,59,0.4)] active:scale-95"
    >
      {locale === 'tr' ? 'Kapat / Geç' : 'Skip / Close'} &times;
    </button>
  </div>
</div>

<style>
  .hero-split-panel {
    flex: 1;
    transition:
      flex 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.5s ease;
  }
  .hero-split-panel:hover {
    flex: 1.45;
  }

  @keyframes subtleGlow {
    0%,
    100% {
      box-shadow: 0 0 0px rgba(229, 56, 59, 0);
    }
    50% {
      box-shadow: 0 0 30px rgba(229, 56, 59, 0.15);
    }
  }

  .animate-subtle-glow {
    animation: subtleGlow 3s ease-in-out infinite;
  }
</style>

<script>
  function initHeroInteractions(): void {
    // --- 1. Volleyball Modal Logic (Instant Motion, No Loading Delay) ---
    const volleyballBtn = document.getElementById('btn-volleyball-camps');
    const volleyballModal = document.getElementById('volleyball-modal');
    const volleyballModalContent = document.getElementById('volleyball-modal-content');
    const volleyballModalClose = document.getElementById('volleyball-modal-close');
    const volleyballModalSkip = document.getElementById('volleyball-modal-skip');

    const openVolleyballModal = (): void => {
      if (!volleyballModal || !volleyballModalContent) return;
      volleyballBtn?.setAttribute('aria-expanded', 'true');
      volleyballModal.classList.remove('hidden');
      volleyballModal.classList.add('flex');

      // Force layout reflow
      void volleyballModal.offsetWidth;

      // Instant backdrop blur and modal card entrance
      volleyballModal.classList.remove('opacity-0');
      volleyballModal.classList.add('opacity-100');
      volleyballModalContent.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
      volleyballModalContent.classList.add('scale-100', 'opacity-100', 'translate-y-0');

      // Staggered animated motion for sub-options
      const modalOptions = volleyballModal.querySelectorAll<HTMLElement>(
        '.volleyball-modal-option'
      );
      modalOptions.forEach((option, index) => {
        setTimeout(
          () => {
            option.classList.remove('translate-y-6', 'opacity-0');
            option.classList.add('translate-y-0', 'opacity-100');
          },
          80 + index * 90
        );
      });
    };

    const closeVolleyballModal = (): void => {
      if (!volleyballModal || !volleyballModalContent) return;
      volleyballBtn?.setAttribute('aria-expanded', 'false');

      const modalOptions = volleyballModal.querySelectorAll<HTMLElement>(
        '.volleyball-modal-option'
      );
      modalOptions.forEach((option) => {
        option.classList.remove('translate-y-0', 'opacity-100');
        option.classList.add('translate-y-6', 'opacity-0');
      });

      volleyballModal.classList.remove('opacity-100');
      volleyballModal.classList.add('opacity-0');
      volleyballModalContent.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
      volleyballModalContent.classList.add('scale-95', 'opacity-0', 'translate-y-4');

      setTimeout(() => {
        volleyballModal.classList.remove('flex');
        volleyballModal.classList.add('hidden');
      }, 300);
    };

    volleyballBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      openVolleyballModal();
    });

    volleyballModalClose?.addEventListener('click', (e) => {
      e.preventDefault();
      closeVolleyballModal();
    });

    volleyballModalSkip?.addEventListener('click', (e) => {
      e.preventDefault();
      closeVolleyballModal();
    });

    volleyballModal?.addEventListener('click', (e) => {
      if (e.target === volleyballModal) {
        closeVolleyballModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeVolleyballModal();
      }
    });

    // --- 2. Mobile Hero Image Slideshow (Fades every 2.7 seconds / 2700ms) ---
    const mobileSlides = document.querySelectorAll<HTMLElement>('.hero-mobile-slide');
    if (mobileSlides.length > 1) {
      let currentSlideIdx = 0;
      const slideTimer = window.setInterval(() => {
        mobileSlides[currentSlideIdx].classList.remove('opacity-100');
        mobileSlides[currentSlideIdx].classList.add('opacity-0');

        currentSlideIdx = (currentSlideIdx + 1) % mobileSlides.length;

        mobileSlides[currentSlideIdx].classList.remove('opacity-0');
        mobileSlides[currentSlideIdx].classList.add('opacity-100');
      }, 2700);

      // Clean up interval if navigating away
      document.addEventListener(
        'astro:before-swap',
        () => {
          clearInterval(slideTimer);
        },
        { once: true }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroInteractions);
  } else {
    initHeroInteractions();
  }
  document.addEventListener('astro:page-load', initHeroInteractions);
</script>
