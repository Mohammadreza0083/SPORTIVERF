---
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations, getDirFromLocale } from '@/i18n/utils';

export interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const dir = getDirFromLocale(locale);
---

<!-- Statistics Section (500+ Athletes, 40+ Clubs, 15+ Academies) -->
<section
  id="statistics-section"
  dir={dir}
  class="w-full border-b border-t border-white/10 bg-[#0A0A0A] relative z-20 py-5 sm:py-6 shadow-[0_-10px_30px_rgba(0,0,0,0.5)]"
>
  <div
    class="max-w-[1400px] mx-auto px-4 md:px-8 grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 text-center"
  >
    <div class="p-2">
      <span
        class="font-barlow font-black text-4xl sm:text-5xl md:text-6xl text-white block tracking-tight"
        data-counter="500"
        data-suffix="+"
      >
        0+
      </span>
      <span
        class="font-mono text-xs sm:text-sm text-[#888888] uppercase tracking-wider mt-2 block font-medium"
      >
        {t('hero.statAthletes')}
      </span>
    </div>

    <div class="sm:border-x border-white/10 p-2">
      <span
        class="font-barlow font-black text-4xl sm:text-5xl md:text-6xl text-white block tracking-tight"
        data-counter="40"
        data-suffix="+"
      >
        0+
      </span>
      <span
        class="font-mono text-xs sm:text-sm text-[#888888] uppercase tracking-wider mt-2 block font-medium"
      >
        {t('hero.statClubs')}
      </span>
    </div>

    <div class="p-2">
      <span
        class="font-barlow font-black text-4xl sm:text-5xl md:text-6xl text-white block tracking-tight"
        data-counter="15"
        data-suffix="+"
      >
        0+
      </span>
      <span
        class="font-mono text-xs sm:text-sm text-[#888888] uppercase tracking-wider mt-2 block font-medium"
      >
        {t('hero.statAcademies')}
      </span>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Kinetic Stats Counter Trigger
    const counters = document.querySelectorAll('#statistics-section [data-counter]');

    if (counters.length) {
      const animateCounter = (counter: Element): void => {
        const target = parseInt(counter.getAttribute('data-counter') || '0', 10);
        const suffix = counter.getAttribute('data-suffix') || '';
        const duration = 2000;
        const startTime = performance.now();

        const updateCount = (currentTime: number): void => {
          const elapsedTime = currentTime - startTime;
          const progress = Math.min(elapsedTime / duration, 1);
          const easeProgress = 1 - Math.pow(1 - progress, 3);
          const currentCount = Math.floor(easeProgress * target);

          counter.textContent = `${currentCount}${suffix}`;

          if (progress < 1) {
            requestAnimationFrame(updateCount);
          } else {
            counter.textContent = `${target}${suffix}`;
          }
        };

        requestAnimationFrame(updateCount);
      };

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCounter(entry.target);
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.2 }
      );

      counters.forEach((c) => observer.observe(c));
    }
  });
</script>
