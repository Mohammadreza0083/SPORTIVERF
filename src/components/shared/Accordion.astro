---
export interface AccordionItem {
  id: string;
  title: string;
  subtitle?: string;
  content: string;
  bullets?: string[];
}

export interface Props {
  items: AccordionItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class={`space-y-4 ${className}`}>
  {items.map((item, index) => (
    <div class="border border-brand-borderSubtle bg-brand-dark rounded-lg overflow-hidden transition-colors">
      <button
        type="button"
        class="accordion-trigger w-full px-6 py-5 flex items-center justify-between text-left focus:outline-none hover:bg-brand-surface/50 transition-colors"
        aria-expanded={index === 0 ? "true" : "false"}
        aria-controls={`accordion-panel-${item.id}`}
      >
        <div>
          {item.subtitle && (
            <span class="block font-mono text-xs text-neutral-500 uppercase tracking-widest mb-1">
              {item.subtitle}
            </span>
          )}
          <h3 class="font-display font-bold text-lg md:text-xl text-white">
            {item.title}
          </h3>
        </div>
        <span class="accordion-icon font-mono font-bold text-2xl text-white ml-4 shrink-0 transition-transform duration-300">
          {index === 0 ? "−" : "+"}
        </span>
      </button>

      <div
        id={`accordion-panel-${item.id}`}
        class={`accordion-panel px-6 pb-6 pt-2 text-neutral-300 text-sm leading-relaxed ${index === 0 ? "" : "hidden"}`}
      >
        <p class="mb-4">{item.content}</p>
        {item.bullets && item.bullets.length > 0 && (
          <ul class="space-y-2 list-disc list-inside text-neutral-400 font-mono text-xs">
            {item.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        )}
      </div>
    </div>
  ))}
</div>

<script>
  const triggers = document.querySelectorAll('.accordion-trigger');
  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
      const panelId = trigger.getAttribute('aria-controls');
      const panel = document.getElementById(panelId || '');
      const icon = trigger.querySelector('.accordion-icon');

      if (panel && icon) {
        if (isExpanded) {
          trigger.setAttribute('aria-expanded', 'false');
          panel.classList.add('hidden');
          icon.textContent = '+';
        } else {
          trigger.setAttribute('aria-expanded', 'true');
          panel.classList.remove('hidden');
          icon.textContent = '−';
        }
      }
    });
  });
</script>
