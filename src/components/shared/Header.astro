---
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations } from '@/i18n/utils';

export interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const currentPath = Astro.url.pathname;

const navItems = [
  { href: `/${locale}`, label: t('nav.home'), key: 'home' },
  { href: `/${locale}/volleyball-camps`, label: t('hero.btnVolleyball'), key: 'volleyball-camps' },
  {
    href: `/${locale}/volleyball-camps`,
    label: t('hero.btnVolleyballAcademic'),
    key: 'volleyball-academic-camps'
  },
  {
    href: `/${locale}/volleyball-camps`,
    label: t('hero.btnCollegeVolleyball'),
    key: 'college-volleyball'
  }
];

// Count identical hrefs to prevent multi-highlight bug on shared sub-routes
const hrefCounts = navItems.reduce(
  (acc, item) => {
    acc[item.href] = (acc[item.href] || 0) + 1;
    return acc;
  },
  {} as Record<string, number>
);
---

<header
  id="app-header"
  role="banner"
  class="fixed top-0 left-0 w-full z-50 bg-[#080808] border-b border-transparent transition-all duration-300"
>
  <div class="max-w-[1400px] mx-auto px-4 md:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a
      href={`/${locale}`}
      class="flex flex-col focus:outline-none group"
      aria-label="SPORTIVERF Homepage"
    >
      <span
        class="font-barlow font-black text-3xl md:text-4xl tracking-tight text-white group-hover:text-[#E5383B] transition-colors uppercase"
      >
        SPORTIV<span class="text-[#E5383B]">ERF</span>
      </span>
      <span class="font-mono text-[9px] tracking-[0.2em] text-[#888888] uppercase -mt-1">
        TALENT OVERSEAS
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav
      role="navigation"
      aria-label={t('nav.main')}
      class="hidden lg:flex items-center gap-8 rtl:space-x-reverse"
    >
      {
        navItems.map((item) => {
          const isDuplicateHref = (hrefCounts[item.href] || 0) > 1;
          const isExactPath = currentPath === item.href || currentPath === `${item.href}/`;
          const isSubPath = item.href !== `/${locale}` && currentPath.startsWith(`${item.href}/`);
          const isActive = !isDuplicateHref && (isExactPath || isSubPath);

          return (
            <a
              href={item.href}
              class={`relative text-sm uppercase tracking-[0.15em] font-barlow font-bold transition-colors py-1 ${
                isActive ? 'text-white' : 'text-white/70 hover:text-[#E5383B]'
              }`}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
              {isActive && <span class="absolute bottom-0 left-0 w-full h-[2px] bg-[#E5383B]" />}
            </a>
          );
        })
      }
    </nav>

    <!-- Right Utilities & Action CTAs -->
    <div class="flex items-center gap-3 sm:gap-4 rtl:space-x-reverse">
      <a
        href={`/${locale}/tours`}
        class="hidden sm:inline-flex btn-primary !py-2.5 !px-5 !text-[11px] font-barlow font-bold shadow-[0_0_15px_rgba(229,56,59,0.3)]"
      >
        {t('nav.bookNow')}
      </a>

      <!-- Global Language Switcher (Visible on both Mobile & Desktop, adjacent to hamburger menu on mobile) -->
      <LanguageSwitcher currentLocale={locale} />

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden p-2 text-white border border-white/20 hover:border-[#E5383B] focus:outline-none bg-[#121212] shadow-sm transition-all duration-200 active:scale-95"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg
          class="w-6 h-6 fill-none stroke-current stroke-2 transition-transform duration-300"
          width="24"
          height="24"
          style="width: 24px; height: 24px;"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            id="menu-icon-path"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Animated Mobile Navigation Drawer Slide -->
  <div
    id="mobile-nav-drawer"
    class="hidden lg:hidden fixed inset-x-0 top-20 bg-[#121212]/95 border-b-2 border-[#E5383B] p-6 flex flex-col gap-6 backdrop-blur-2xl transition-all duration-300 ease-in-out shadow-2xl max-h-[calc(100vh-80px)] overflow-y-auto z-50 transform opacity-0 -translate-y-3 pointer-events-none text-white"
  >
    <!-- Navigation Links -->
    <nav class="flex flex-col gap-3">
      {
        navItems.map((item) => {
          const isDuplicateHref = (hrefCounts[item.href] || 0) > 1;
          const isExactPath = currentPath === item.href || currentPath === `${item.href}/`;
          const isSubPath = item.href !== `/${locale}` && currentPath.startsWith(`${item.href}/`);
          const isActive = !isDuplicateHref && (isExactPath || isSubPath);

          return (
            <a
              href={item.href}
              class={`text-base font-barlow font-bold uppercase tracking-wider transition-all duration-200 border-b border-white/10 pb-3 flex items-center justify-between ${
                isActive
                  ? 'text-[#E5383B] pl-2 border-l-2 border-[#E5383B]'
                  : 'text-white hover:text-[#E5383B] hover:pl-1'
              }`}
            >
              <span>{item.label}</span>
              {isActive && <span class="w-2 h-2 rounded-full bg-[#E5383B]" />}
            </a>
          );
        })
      }
    </nav>

    <!-- Mobile Action CTA -->
    <div class="pt-2">
      <a
        href={`/${locale}/tours`}
        class="btn-primary w-full justify-center !py-3.5 text-center text-xs font-bold tracking-[0.18em] shadow-lg"
      >
        {t('nav.bookNow')}
      </a>
    </div>
  </div>
  <!-- Thin Brand Red Scroll Reading Progress Indicator Bar -->
  <div
    id="scroll-progress-bar"
    class="absolute bottom-0 left-0 h-[2px] bg-[#E5383B] z-50 transition-none pointer-events-none shadow-[0_0_8px_rgba(229,56,59,0.8)]"
    style="width: 0%"
  >
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('app-header');
    const progressBar = document.getElementById('scroll-progress-bar');
    let ticking = false;

    // Apple-Style Glassmorphism Scroll Handler
    const handleScroll = (): void => {
      if (!header) return;
      if (window.scrollY > 10) {
        header.classList.add('bg-[#080808]/60', 'backdrop-blur-xl', 'border-white/10', 'shadow-xl');
        header.classList.remove('bg-[#080808]', 'border-transparent');
      } else {
        header.classList.remove(
          'bg-[#080808]/60',
          'backdrop-blur-xl',
          'border-white/10',
          'shadow-xl'
        );
        header.classList.add('bg-[#080808]', 'border-transparent');
      }
    };

    // 60fps High-Performance Scroll Progress Bar Calculator
    const updateScrollProgress = (): void => {
      if (progressBar) {
        const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (scrollableHeight > 0) {
          const progress = Math.min(Math.max((window.scrollY / scrollableHeight) * 100, 0), 100);
          progressBar.style.width = `${progress}%`;
        } else {
          progressBar.style.width = '0%';
        }
      }
      ticking = false;
    };

    const onScroll = (): void => {
      handleScroll();
      if (!ticking) {
        requestAnimationFrame(updateScrollProgress);
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener(
      'resize',
      () => {
        if (!ticking) {
          requestAnimationFrame(updateScrollProgress);
          ticking = true;
        }
      },
      { passive: true }
    );

    handleScroll();
    updateScrollProgress();

    // Mobile Menu Toggle Logic
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');

    if (toggleBtn && drawer) {
      toggleBtn.addEventListener('click', () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        const newExpanded = !isExpanded;
        toggleBtn.setAttribute('aria-expanded', String(newExpanded));

        if (newExpanded) {
          drawer.classList.remove('hidden');
          requestAnimationFrame(() => {
            drawer.classList.remove('opacity-0', '-translate-y-3', 'pointer-events-none');
            drawer.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
          });
        } else {
          drawer.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
          drawer.classList.add('opacity-0', '-translate-y-3', 'pointer-events-none');
          setTimeout(() => {
            drawer.classList.add('hidden');
          }, 300);
        }
      });
    }

    // Handle localStorage update on mobile language link click
    const langLinks = document.querySelectorAll('.lang-switch-link');
    langLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const lang = link.getAttribute('data-locale-switch');
        if (lang) {
          localStorage.setItem('user-lang', lang);
          document.cookie = `user-lang=${lang}; path=/; max-age=31536000; SameSite=Lax`;
        }
      });
    });
  });
</script>
