---
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations } from '@/i18n/utils';

export interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer
  id="site-footer"
  role="contentinfo"
  class="bg-[#0D0D0D] text-white pt-16 pb-12 border-t border-[#E5383B] relative"
>
  <div class="max-w-[1400px] mx-auto px-4 md:px-8">
    <!-- Top Header Banner Row -->
    <div
      class="flex flex-col lg:flex-row justify-between items-start lg:items-center border-b border-[#222222] pb-10 gap-6"
    >
      <div>
        <h2 class="font-barlow font-black text-3xl md:text-4xl tracking-tight text-white uppercase">
          SPORTIV<span class="text-[#E5383B]">ERF</span>
        </h2>
        <p class="font-mono text-[10px] text-[#888888] uppercase tracking-[0.2em] mt-1">
          TALENT OVERSEAS • OFFICIAL SPORTS TOURISM
        </p>
      </div>
      <div class="max-w-xl text-[#AAAAAA] text-xs leading-relaxed font-light">
        <p>
          {t('footer.supervision')}
        </p>
      </div>
    </div>

    <!-- Main Architectural Specs Grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 py-12 border-b border-[#222222]"
    >
      <!-- Column 1: Core Values & Mission -->
      <div>
        <h3 class="font-mono text-xs font-bold text-[#E5383B] uppercase tracking-widest mb-4">
          {t('footer.valuesTitle')}
        </h3>
        <p class="font-barlow font-bold text-xl text-white mb-3 uppercase">
          {t('footer.coreValues')}
        </p>
        <p class="text-xs text-[#888888] leading-relaxed font-light">
          {t('site.description')}
        </p>
      </div>

      <!-- Column 2: Navigation Links -->
      <div>
        <h3 class="font-mono text-xs font-bold text-[#E5383B] uppercase tracking-widest mb-4">
          {t('nav.main')}
        </h3>
        <ul class="space-y-2.5 text-xs font-light text-[#CCCCCC]">
          <li>
            <a href={`/${locale}`} class="hover:text-[#E5383B] transition">{t('nav.home')}</a>
          </li>
          <li>
            <a href={`/${locale}/football-camps`} class="hover:text-[#E5383B] transition"
              >{t('nav.football')}</a
            >
          </li>
          <li>
            <a href={`/${locale}/volleyball-camps`} class="hover:text-[#E5383B] transition"
              >{t('nav.volleyball')}</a
            >
          </li>
          <li>
            <a href={`/${locale}/tours`} class="hover:text-[#E5383B] transition">{t('nav.tours')}</a
            >
          </li>
          <li>
            <a href={`/${locale}/about`} class="hover:text-[#E5383B] transition">{t('nav.about')}</a
            >
          </li>
        </ul>
      </div>

      <!-- Column 3: Contact & Headquarters -->
      <div>
        <h3 class="font-mono text-xs font-bold text-[#E5383B] uppercase tracking-widest mb-4">
          {t('footer.addressTitle')}
        </h3>
        <ul class="space-y-3 text-xs text-[#CCCCCC] font-light">
          <li>
            <span class="text-[#888888] block uppercase font-mono text-[9px]"
              >{t('footer.addressTitle')}</span
            >
            <span>{t('footer.address')}</span>
          </li>
          <li>
            <span class="text-[#888888] block uppercase font-mono text-[9px]"
              >{t('footer.phoneTitle')}</span
            >
            <a href="tel:+902165147808" class="hover:text-[#E5383B] transition font-mono"
              >{t('footer.phone')}</a
            >
          </li>
          <li>
            <span class="text-[#888888] block uppercase font-mono text-[9px]"
              >{t('footer.whatsappTitle')}</span
            >
            <a
              href={`https://wa.me/905421661698?text=${encodeURIComponent(t('contact.whatsappText'))}`}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[#E5383B] transition font-mono">{t('footer.whatsapp')}</a
            >
          </li>
        </ul>
      </div>

      <!-- Column 4: Legal Supervision -->
      <div>
        <h3 class="font-mono text-xs font-bold text-[#E5383B] uppercase tracking-widest mb-4">
          AKLIMOSATURIZM
        </h3>
        <div
          class="bg-[#1A1A1A] border border-[#333333] p-4 text-xs text-[#AAAAAA] leading-relaxed font-light"
        >
          <p class="font-barlow font-bold text-white mb-2 uppercase">Aklimosaturizm Supervision</p>
          <p>
            {t('footer.supervision')}
          </p>
          <p class="text-[10px] text-[#888888] mt-3 font-mono">
            Licensing & Legal Compliance 2026.
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright Row -->
    <div
      class="flex flex-col md:flex-row justify-between items-center pt-8 text-xs text-[#888888] gap-4 font-mono"
    >
      <p class="text-center md:text-left">
        {t('footer.copyright')}
      </p>

      <p class="text-[11px] text-[#888888] tracking-wide text-center">
        {t('footer.madeWith')}
        <span
          class="text-[#E5383B] inline-block transition-transform duration-300 hover:scale-125 select-none"
          aria-hidden="true">❤️</span
        >
        {t('footer.by')}{' '}
        <a
          href="https://www.linkedin.com/in/mohammadreza-bonyadi/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#CCCCCC] hover:text-[#E5383B] font-medium transition-colors duration-200 underline decoration-[#333333] hover:decoration-[#E5383B] underline-offset-4"
        >
          Mohammadreza Bonyadi
        </a>
      </p>

      <div class="flex items-center gap-6">
        <a href="#app-header" class="hover:text-[#E5383B] transition uppercase tracking-wider">
          Top ↑
        </a>
      </div>
    </div>
  </div>

  <!-- Sleek Red Floating Scroll-to-Top Button (Left-positioned to avoid WhatsApp widget) -->
  <button
    id="scroll-to-top"
    type="button"
    aria-label="Scroll to Top"
    class="fixed bottom-6 left-6 z-40 p-3.5 rounded-full bg-[#E5383B] text-white shadow-[0_0_25px_rgba(229,56,59,0.5)] hover:bg-[#FF4D6D] hover:scale-110 active:scale-95 transition-all duration-300 opacity-0 pointer-events-none translate-y-4 focus:outline-none cursor-pointer border border-[#FF4D6D]/40"
  >
    <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"></path>
    </svg>
  </button>
</footer>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scrollTopBtn = document.getElementById('scroll-to-top');
    const footer = document.getElementById('site-footer') || document.querySelector('footer');

    if (scrollTopBtn && footer) {
      const updateScrollTopVisibility = (): void => {
        const scrollPosition = window.scrollY + window.innerHeight;
        const triggerPoint = footer.offsetTop - 200;

        if (scrollPosition >= triggerPoint && window.scrollY > 100) {
          scrollTopBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
          scrollTopBtn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        } else {
          scrollTopBtn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
          scrollTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        }
      };

      window.addEventListener('scroll', updateScrollTopVisibility, { passive: true });
      window.addEventListener('resize', updateScrollTopVisibility, { passive: true });
      updateScrollTopVisibility();

      scrollTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  });
</script>
