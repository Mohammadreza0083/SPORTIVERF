---
export interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  sizes?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className = '',
  sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw'
} = Astro.props;

// Ensure alt is present and non-empty for WCAG AA compliance
if (!alt && alt !== '') {
  console.warn(`[a11y warning]: Image at ${src} is missing a descriptive alt attribute.`);
}

const isExternal = src.startsWith('http://') || src.startsWith('https://');
const aspectRatio = (width / height).toFixed(4);
---

<figure class={`relative overflow-hidden inline-block ${className}`} style={`aspect-ratio: ${aspectRatio};`}>
  {isExternal ? (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      sizes={sizes}
      class="w-full h-full object-cover transition-opacity duration-300"
    />
  ) : (
    <picture>
      <source srcset={`${src}?format=avif`} type="image/avif" />
      <source srcset={`${src}?format=webp`} type="image/webp" />
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding="async"
        sizes={sizes}
        class="w-full h-full object-cover transition-opacity duration-300"
      />
    </picture>
  )}
</figure>
