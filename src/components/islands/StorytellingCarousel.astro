---
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations } from '@/i18n/utils';
import contentData from '@/data/content.json';

export interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const localeContent = contentData[locale as keyof typeof contentData] || contentData.en;
const features = localeContent.homepageFeatures;
---

<section
  id="homepage-features-section"
  class="py-12 md:py-20 bg-[#0A0A0A] text-white overflow-hidden relative border-b border-[#222222]"
>
  <div class="max-w-[1400px] mx-auto px-4 md:px-8 mb-8 md:mb-12 text-center">
    <span
      class="inline-block px-3.5 py-1 bg-[#E5383B]/10 border border-[#E5383B]/30 text-[#E5383B] font-mono text-xs uppercase tracking-[0.2em] mb-3"
    >
      {locale === 'tr' ? 'HİZMETLER & UZMANLIK' : 'SERVICES & EXPERTISE'}
    </span>
    <h2
      class="font-barlow font-extrabold text-3xl sm:text-4xl md:text-5xl uppercase tracking-tight text-white"
    >
      {locale === 'tr' ? 'SPORTIVERF Hizmetleri' : 'SPORTIVERF Services & Features'}
    </h2>
  </div>

  <!-- ========================================================= -->
  <!-- MOBILE VIEW (Horizontal Swipe Carousel - Unchanged) -->
  <!-- ========================================================= -->
  <div class="md:hidden">
    <!-- Swipe Hint Animation -->
    <div
      class="flex items-center justify-center gap-2 text-[#888888] font-mono text-[11px] uppercase tracking-widest mb-4 animate-pulse"
    >
      <span>{locale === 'tr' ? 'Kaydırarak Keşfedin' : 'Swipe to explore'}</span>
      <svg
        class="w-4 h-4 text-[#E5383B] animate-bounce"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </div>

    <!-- Mobile Horizontal Carousel Container -->
    <div
      class="flex overflow-x-auto snap-x snap-mandatory gap-4 hide-scrollbar px-6 pb-6 pt-2 scroll-smooth"
    >
      {
        features.map((feature, idx) => (
          <div class="snap-center shrink-0 min-w-[85vw] max-w-[85vw] bg-[#141414] border border-[#262626] p-6 flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-24 h-24 bg-[#E5383B]/10 rounded-full blur-2xl pointer-events-none" />
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-mono text-xs text-[#E5383B] font-bold uppercase tracking-widest">
                  {String(idx + 1).padStart(2, '0')} / SPORTIVERF
                </span>
                <div class="w-8 h-8 rounded bg-[#E5383B]/10 border border-[#E5383B]/30 flex items-center justify-center text-[#E5383B] font-mono text-xs font-bold">
                  {String(idx + 1).padStart(2, '0')}
                </div>
              </div>
              <h3 class="font-barlow font-extrabold text-xl uppercase tracking-tight text-white mb-3">
                {feature.title}
              </h3>
              <p class="text-xs text-[#AAAAAA] leading-relaxed font-light whitespace-pre-line">
                {feature.description}
              </p>
            </div>
            <div class="pt-4 mt-6 border-t border-[#222222] font-mono text-[10px] text-[#888888] uppercase tracking-widest flex items-center justify-between">
              <span>SPORTIVERF EXCELLENCE</span>
              <span class="text-[#E5383B]">0{idx + 1}</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Mobile Bottom CTA -->
    <div class="px-6 pt-4">
      <a
        href={`/${locale}/about`}
        class="btn-red !py-3.5 !px-5 text-xs text-center w-full block font-barlow font-bold uppercase tracking-wider"
      >
        {t('about.storyTitle')} &rarr;
      </a>
    </div>
  </div>

  <!-- ========================================================= -->
  <!-- DESKTOP VIEW (Tabbed Sidebar UI with iOS-Style Nudge Scroll) -->
  <!-- ========================================================= -->
  <div class="hidden md:block max-w-[1400px] mx-auto px-8">
    <div class="grid grid-cols-12 gap-8 items-stretch">
      <!-- Left Column: iOS-style Scrollable Menu with Fixed Bottom CTA -->
      <div class="col-span-5 lg:col-span-4 flex flex-col justify-between pr-4 border-r border-[#222222]">
        <div>
          <div class="flex items-center justify-between mb-3 pr-2">
            <span class="font-mono text-xs text-[#888888] uppercase tracking-widest">
              {locale === 'tr' ? 'HİZMET SEÇİN' : 'SELECT SERVICE'}
            </span>
            <span class="font-mono text-[11px] text-[#E5383B] uppercase tracking-wider">
              {features.length} {locale === 'tr' ? 'ÖZELLİK' : 'FEATURES'}
            </span>
          </div>

          <!-- Vertically Scrollable List (4 items visible at a time, hidden scrollbar) -->
          <div
            id="homepage-feature-scroll-menu"
            class="space-y-2.5 max-h-[355px] overflow-y-auto hide-scrollbar pr-1 scroll-smooth"
          >
            {
              features.map((feature, idx) => (
                <button
                  type="button"
                  data-feature-target={idx}
                  class={`homepage-feature-tab w-full text-left p-3.5 border-l-4 transition-all duration-300 cursor-pointer flex flex-col justify-between ${
                    idx === 0
                      ? 'bg-[#181818] border-[#E5383B] shadow-[0_0_15px_rgba(229,56,59,0.15)]'
                      : 'bg-[#121212] border-transparent opacity-75 hover:opacity-100 hover:bg-[#161616]'
                  }`}
                >
                  <span class="font-mono text-[10px] text-[#E5383B] font-bold uppercase tracking-widest block mb-0.5">
                    {String(idx + 1).padStart(2, '0')} / SPORTIVERF
                  </span>
                  <span class="font-barlow font-bold text-base uppercase tracking-wide text-white block">
                    {feature.title}
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <!-- Fixed Bottom CTA Button in Left Column -->
        <div class="pt-6 mt-4 border-t border-[#222222]">
          <a
            href={`/${locale}/about`}
            class="btn-red !py-3.5 !px-6 text-xs text-center w-full block font-barlow font-bold uppercase tracking-wider shadow-[0_0_20px_rgba(229,56,59,0.3)] hover:shadow-[0_0_30px_rgba(229,56,59,0.5)] transition-all"
          >
            {t('about.storyTitle')} &rarr;
          </a>
        </div>
      </div>

      <!-- Right Column: Glassmorphism Content Card -->
      <div class="col-span-7 lg:col-span-8 relative">
        <div
          class="relative bg-[#121212] border border-[#262626] p-8 lg:p-10 min-h-[440px] h-full flex flex-col justify-between overflow-hidden shadow-2xl"
        >
          <!-- Background Ambient Neon Red Glow -->
          <div
            class="absolute -bottom-10 -right-10 w-72 h-72 bg-[#E5383B]/10 rounded-full blur-3xl pointer-events-none"
          >
          </div>

          {
            features.map((feature, idx) => (
              <div
                data-feature-slide={idx}
                class={`homepage-feature-slide h-full flex flex-col justify-between transition-all duration-500 ${
                  idx === 0 ? 'block opacity-100' : 'hidden opacity-0'
                }`}
              >
                <div>
                  <!-- Header Row with Index Badge and Accent -->
                  <div class="flex items-center justify-between pb-5 mb-6 border-b border-white/10">
                    <div class="flex items-center gap-3">
                      <span class="font-mono text-xs font-bold text-[#E5383B] tracking-widest px-3 py-1 bg-[#1A1A1A] border border-[#E5383B]/30">
                        {String(idx + 1).padStart(2, '0')} / {String(features.length).padStart(2, '0')}
                      </span>
                      <span class="font-mono text-xs uppercase tracking-widest text-[#888888]">
                        SPORTIVERF • {locale === 'tr' ? 'HİZMET' : 'FEATURE'}
                      </span>
                    </div>

                    <div class="w-10 h-10 rounded bg-[#E5383B]/10 border border-[#E5383B]/30 flex items-center justify-center text-[#E5383B] font-mono text-sm font-bold shadow-[0_0_15px_rgba(229,56,59,0.2)]">
                      {String(idx + 1).padStart(2, '0')}
                    </div>
                  </div>

                  <!-- Feature Title -->
                  <h3 class="font-barlow font-black text-2xl sm:text-3xl lg:text-4xl uppercase tracking-tight text-white mb-5 leading-tight">
                    {feature.title}
                  </h3>

                  <!-- Feature Description with Multiline Formatting -->
                  <p class="font-sans text-sm sm:text-base text-[#CCCCCC] font-light leading-relaxed whitespace-pre-line">
                    {feature.description}
                  </p>
                </div>

                <!-- Footer Meta -->
                <div class="pt-6 mt-8 border-t border-white/10 flex items-center justify-between">
                  <span class="font-mono text-[11px] text-[#666666] uppercase tracking-widest">
                    SPORTIVERF EXCELLENCE • 2026
                  </span>
                  <a
                    href={`/${locale}/about`}
                    class="text-xs font-barlow font-bold uppercase tracking-wider text-[#E5383B] hover:text-white transition-colors flex items-center gap-1.5"
                  >
                    <span>{locale === 'tr' ? 'Detayları İnceleyin' : 'Learn More'}</span>
                    <span>&rarr;</span>
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Tab Switching Logic
    const tabs = document.querySelectorAll('.homepage-feature-tab');
    const slides = document.querySelectorAll('.homepage-feature-slide');

    if (tabs.length && slides.length) {
      const switchTab = (targetIndex) => {
        tabs.forEach((tab, i) => {
          if (i === targetIndex) {
            tab.classList.remove('bg-[#121212]', 'border-transparent', 'opacity-75');
            tab.classList.add(
              'bg-[#181818]',
              'border-[#E5383B]',
              'shadow-[0_0_15px_rgba(229,56,59,0.15)]'
            );
          } else {
            tab.classList.remove(
              'bg-[#181818]',
              'border-[#E5383B]',
              'shadow-[0_0_15px_rgba(229,56,59,0.15)]'
            );
            tab.classList.add('bg-[#121212]', 'border-transparent', 'opacity-75');
          }
        });

        slides.forEach((slide, i) => {
          if (i === targetIndex) {
            slide.classList.remove('hidden', 'opacity-0');
            slide.classList.add('block', 'opacity-100');
          } else {
            slide.classList.add('hidden', 'opacity-0');
            slide.classList.remove('block', 'opacity-100');
          }
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const targetIndex = parseInt(tab.getAttribute('data-feature-target') || '0', 10);
          switchTab(targetIndex);
        });
      });
    }

    // 2. iOS-Style Scroll Nudge Animation
    const scrollContainer = document.getElementById('homepage-feature-scroll-menu');
    if (scrollContainer) {
      let isInteracted = false;

      const stopNudge = () => {
        if (!isInteracted) {
          isInteracted = true;
          if (nudgeInterval) {
            clearInterval(nudgeInterval);
          }
        }
      };

      // UX Guards: stop nudge animation permanently upon any user interaction
      scrollContainer.addEventListener('mouseenter', stopNudge, { once: true });
      scrollContainer.addEventListener('touchstart', stopNudge, { once: true, passive: true });
      scrollContainer.addEventListener('wheel', stopNudge, { once: true, passive: true });
      scrollContainer.addEventListener('scroll', stopNudge, { once: true, passive: true });

      // Trigger subtle nudge every 2.5s (scrolls down ~20px, waits 300ms, scrolls back up ~20px)
      const nudgeInterval = setInterval(() => {
        if (isInteracted) return;

        scrollContainer.scrollBy({ top: 20, behavior: 'smooth' });

        setTimeout(() => {
          if (!isInteracted) {
            scrollContainer.scrollBy({ top: -20, behavior: 'smooth' });
          }
        }, 300);
      }, 2500);
    }
  });
</script>
