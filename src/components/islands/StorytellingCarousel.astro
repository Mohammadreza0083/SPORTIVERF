---
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations } from '@/i18n/utils';
import contentData from '@/data/content.json';

export interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const localeContent = contentData[locale as keyof typeof contentData] || contentData.en;
const features = localeContent.homepageFeatures;
---

<section
  id="homepage-features-section"
  class="py-12 md:py-20 bg-[#0A0A0A] text-white overflow-hidden relative border-b border-[#222222]"
>
  <!-- ========================================================= -->
  <!-- MOBILE VIEW (Horizontal Swipe Carousel with Icons) -->
  <!-- ========================================================= -->
  <div class="md:hidden">
    <!-- Mobile Horizontal Carousel Container -->
    <div
      id="mobile-features-carousel"
      class="flex overflow-x-auto snap-x snap-mandatory gap-4 hide-scrollbar px-6 pb-6 pt-2 scroll-smooth"
    >
      {
        features.map((feature, idx) => (
          <div class="mobile-feature-card snap-center shrink-0 min-w-[85vw] max-w-[85vw] bg-[#141414] border border-[#262626] p-6 flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-24 h-24 bg-[#E5383B]/10 rounded-full blur-2xl pointer-events-none" />
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-mono text-xs text-[#E5383B] font-bold tracking-wide">
                  {String(idx + 1).padStart(2, '0')} / SPORTIVERF
                </span>
                <div class="w-10 h-10 rounded-xl bg-[#1A1A1A] border border-[#E5383B]/30 flex items-center justify-center text-[#E5383B] shadow-[0_0_12px_rgba(229,56,59,0.2)]">
                  {feature.icon === 'handshake' && (
                    <svg
                      class="w-5 h-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="m11 17 2 2a1 1 0 0 0 1.4 0l4.3-4.3a1 1 0 0 0 0-1.4l-3-3a1 1 0 0 0-1.4 0l-1.3 1.3" />
                      <path d="m14 11-1.3-1.3a1 1 0 0 0-1.4 0L7 14" />
                      <path d="m7 7 3-3a1 1 0 0 1 1.4 0l3 3" />
                      <path d="M2 14h6" />
                      <path d="M22 10h-6" />
                      <path d="m2 14 3-3a1 1 0 0 1 1.4 0L10 14" />
                    </svg>
                  )}
                  {feature.icon === 'globe' && (
                    <svg
                      class="w-5 h-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <line x1="2" y1="12" x2="22" y2="12" />
                      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                    </svg>
                  )}
                  {feature.icon === 'award' && (
                    <svg
                      class="w-5 h-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="8" r="6" />
                      <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
                    </svg>
                  )}
                  {feature.icon === 'activity' && (
                    <svg
                      class="w-5 h-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                    </svg>
                  )}
                  {feature.icon === 'plane' && (
                    <svg
                      class="w-5 h-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z" />
                    </svg>
                  )}
                  {feature.icon === 'bus' && (
                    <svg
                      class="w-5 h-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M8 6v6" />
                      <path d="M15 6v6" />
                      <path d="M2 12h19.6" />
                      <path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2V7c0-2-2-4-4-4H6C4 3 2 5 2 7v7c0 .4.1.8.2 1.2.3 1.1.8 2.8.8 2.8h3" />
                      <circle cx="7" cy="18" r="2" />
                      <circle cx="16" cy="18" r="2" />
                    </svg>
                  )}
                  {feature.icon === 'shield-check' && (
                    <svg
                      class="w-5 h-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                      <path d="m9 12 2 2 4-4" />
                    </svg>
                  )}
                  {![
                    'handshake',
                    'globe',
                    'award',
                    'activity',
                    'plane',
                    'bus',
                    'shield-check'
                  ].includes(feature.icon) && (
                    <svg
                      class="w-5 h-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                    </svg>
                  )}
                </div>
              </div>
              <h3 class="font-barlow font-extrabold text-xl tracking-tight text-white mb-3">
                {feature.title}
              </h3>
              <p class="text-xs text-[#AAAAAA] leading-relaxed font-light whitespace-pre-line">
                {feature.description}
              </p>
            </div>
            <div class="pt-4 mt-6 border-t border-[#222222] font-mono text-[10px] text-[#888888] tracking-wide flex items-center justify-between">
              <span>SPORTIVERF Excellence</span>
              <span class="text-[#E5383B]">0{idx + 1}</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Mobile Bottom CTA -->
    <div class="px-6 pt-4">
      <a
        href={`/${locale}/about`}
        class="btn-red !py-3.5 !px-5 text-xs text-center w-full block font-barlow font-bold tracking-wide"
      >
        {t('about.storyTitle')} &rarr;
      </a>
    </div>
  </div>

  <!-- ========================================================= -->
  <!-- DESKTOP VIEW (Tabbed Sidebar UI with Icons & Scroll Nudge) -->
  <!-- ========================================================= -->
  <div class="hidden md:block max-w-[1400px] mx-auto px-8">
    <div class="grid grid-cols-12 gap-8 items-stretch">
      <!-- Left Column: iOS-style Scrollable Menu with Fixed Bottom CTA -->
      <div
        class="col-span-5 lg:col-span-4 flex flex-col justify-between pr-4 border-r border-[#222222]"
      >
        <div>
          <div class="flex items-center justify-between mb-3 pr-2">
            <span class="font-mono text-xs text-[#888888] tracking-wide">
              {locale === 'tr' ? 'Hizmet Seçin' : 'Select Service'}
            </span>
            <span class="font-mono text-[11px] text-[#E5383B] tracking-wide">
              {features.length}{' '}
              {locale === 'tr' ? 'Özellik' : 'Features'}
            </span>
          </div>

          <!-- Vertically Scrollable List (4 items visible at a time, hidden scrollbar) -->
          <div
            id="homepage-feature-scroll-menu"
            class="space-y-2.5 max-h-[355px] overflow-y-auto hide-scrollbar pr-1 scroll-smooth"
          >
            {
              features.map((feature, idx) => (
                <button
                  type="button"
                  data-feature-target={idx}
                  class={`homepage-feature-tab w-full text-left p-3.5 border-l-4 transition-all duration-300 cursor-pointer flex flex-col justify-between ${
                    idx === 0
                      ? 'bg-[#181818] border-[#E5383B] shadow-[0_0_15px_rgba(229,56,59,0.15)]'
                      : 'bg-[#121212] border-transparent opacity-75 hover:opacity-100 hover:bg-[#161616]'
                  }`}
                >
                  <span class="font-mono text-[10px] text-[#E5383B] font-bold tracking-wide block mb-0.5">
                    {String(idx + 1).padStart(2, '0')} / SPORTIVERF
                  </span>
                  <span class="font-barlow font-bold text-base tracking-wide text-white block">
                    {feature.title}
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <!-- Fixed Bottom CTA Button in Left Column -->
        <div class="pt-6 mt-4 border-t border-[#222222]">
          <a
            href={`/${locale}/about`}
            class="btn-red !py-3.5 !px-6 text-xs text-center w-full block font-barlow font-bold tracking-wide shadow-[0_0_20px_rgba(229,56,59,0.3)] hover:shadow-[0_0_30px_rgba(229,56,59,0.5)] transition-all"
          >
            {t('about.storyTitle')} &rarr;
          </a>
        </div>
      </div>

      <!-- Right Column: Glassmorphism Content Card with Prominent SVG Icon -->
      <div class="col-span-7 lg:col-span-8 relative">
        <div
          class="relative bg-[#121212] border border-[#262626] p-8 lg:p-10 min-h-[440px] h-full flex flex-col justify-between overflow-hidden shadow-2xl"
        >
          <!-- Background Ambient Neon Red Glow -->
          <div
            class="absolute -bottom-10 -right-10 w-72 h-72 bg-[#E5383B]/10 rounded-full blur-3xl pointer-events-none"
          >
          </div>

          {
            features.map((feature, idx) => (
              <div
                data-feature-slide={idx}
                class={`homepage-feature-slide h-full flex flex-col justify-between transition-all duration-500 ${
                  idx === 0 ? 'block opacity-100' : 'hidden opacity-0'
                }`}
              >
                <div>
                  {/* Header Row with Index Badge and Prominent SVG Icon Box */}
                  <div class="flex items-center justify-between pb-5 mb-6 border-b border-white/10">
                    <div class="flex items-center gap-3">
                      <span class="font-mono text-xs font-bold text-[#E5383B] tracking-wide px-3 py-1 bg-[#1A1A1A] border border-[#E5383B]/30">
                        {String(idx + 1).padStart(2, '0')} /{' '}
                        {String(features.length).padStart(2, '0')}
                      </span>
                      <span class="font-mono text-xs tracking-wide text-[#888888]">
                        SPORTIVERF • {locale === 'tr' ? 'Hizmet' : 'Feature'}
                      </span>
                    </div>

                    {/* Glowing Icon Box (Desktop) */}
                    <div class="w-14 h-14 rounded-2xl bg-[#181818] border border-[#E5383B]/40 flex items-center justify-center text-[#E5383B] shadow-[0_0_20px_rgba(229,56,59,0.25)] relative overflow-hidden group">
                      <div class="absolute inset-0 bg-gradient-to-br from-[#E5383B]/10 to-transparent pointer-events-none" />
                      {feature.icon === 'handshake' && (
                        <svg
                          class="w-7 h-7 filter drop-shadow-[0_0_8px_rgba(229,56,59,0.5)]"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="m11 17 2 2a1 1 0 0 0 1.4 0l4.3-4.3a1 1 0 0 0 0-1.4l-3-3a1 1 0 0 0-1.4 0l-1.3 1.3" />
                          <path d="m14 11-1.3-1.3a1 1 0 0 0-1.4 0L7 14" />
                          <path d="m7 7 3-3a1 1 0 0 1 1.4 0l3 3" />
                          <path d="M2 14h6" />
                          <path d="M22 10h-6" />
                          <path d="m2 14 3-3a1 1 0 0 1 1.4 0L10 14" />
                        </svg>
                      )}
                      {feature.icon === 'globe' && (
                        <svg
                          class="w-7 h-7 filter drop-shadow-[0_0_8px_rgba(229,56,59,0.5)]"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <circle cx="12" cy="12" r="10" />
                          <line x1="2" y1="12" x2="22" y2="12" />
                          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                        </svg>
                      )}
                      {feature.icon === 'award' && (
                        <svg
                          class="w-7 h-7 filter drop-shadow-[0_0_8px_rgba(229,56,59,0.5)]"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <circle cx="12" cy="8" r="6" />
                          <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
                        </svg>
                      )}
                      {feature.icon === 'activity' && (
                        <svg
                          class="w-7 h-7 filter drop-shadow-[0_0_8px_rgba(229,56,59,0.5)]"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                        </svg>
                      )}
                      {feature.icon === 'plane' && (
                        <svg
                          class="w-7 h-7 filter drop-shadow-[0_0_8px_rgba(229,56,59,0.5)]"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z" />
                        </svg>
                      )}
                      {feature.icon === 'bus' && (
                        <svg
                          class="w-7 h-7 filter drop-shadow-[0_0_8px_rgba(229,56,59,0.5)]"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M8 6v6" />
                          <path d="M15 6v6" />
                          <path d="M21 12h-19.6" />
                          <path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2V7c0-2-2-4-4-4H6C4 3 2 5 2 7v7c0 .4.1.8.2 1.2.3 1.1.8 2.8.8 2.8h3" />
                          <circle cx="7" cy="18" r="2" />
                          <circle cx="16" cy="18" r="2" />
                        </svg>
                      )}
                      {feature.icon === 'shield-check' && (
                        <svg
                          class="w-7 h-7 filter drop-shadow-[0_0_8px_rgba(229,56,59,0.5)]"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                          <path d="m9 12 2 2 4-4" />
                        </svg>
                      )}
                      {![
                        'handshake',
                        'globe',
                        'award',
                        'activity',
                        'plane',
                        'bus',
                        'shield-check'
                      ].includes(feature.icon) && (
                        <svg
                          class="w-7 h-7 filter drop-shadow-[0_0_8px_rgba(229,56,59,0.5)]"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                        </svg>
                      )}
                    </div>
                  </div>

                  {/* Feature Title */}
                  <h3 class="font-barlow font-black text-2xl sm:text-3xl lg:text-4xl tracking-tight text-white mb-5 leading-tight">
                    {feature.title}
                  </h3>

                  {/* Feature Description with Multiline Formatting */}
                  <p class="font-sans text-sm sm:text-base text-[#CCCCCC] font-light leading-relaxed whitespace-pre-line">
                    {feature.description}
                  </p>
                </div>

                {/* Footer Meta */}
                <div class="pt-5 mt-6 border-t border-white/10 flex items-center justify-between font-mono text-[11px] text-[#666666] tracking-wide">
                  <span>SPORTIVERF Excellence</span>
                  <span class="text-[#E5383B]">
                    0{idx + 1} / 0{features.length}
                  </span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  function initStorytellingCarousel(): void {
    // 1. Tab Switching Logic
    const tabs = document.querySelectorAll('.homepage-feature-tab');
    const slides = document.querySelectorAll('.homepage-feature-slide');

    if (tabs.length && slides.length) {
      const switchTab = (targetIndex: number): void => {
        tabs.forEach((tab, i): void => {
          if (i === targetIndex) {
            tab.classList.remove('bg-[#121212]', 'border-transparent', 'opacity-75');
            tab.classList.add(
              'bg-[#181818]',
              'border-[#E5383B]',
              'shadow-[0_0_15px_rgba(229,56,59,0.15)]'
            );
          } else {
            tab.classList.remove(
              'bg-[#181818]',
              'border-[#E5383B]',
              'shadow-[0_0_15px_rgba(229,56,59,0.15)]'
            );
            tab.classList.add('bg-[#121212]', 'border-transparent', 'opacity-75');
          }
        });

        slides.forEach((slide, i): void => {
          if (i === targetIndex) {
            slide.classList.remove('hidden', 'opacity-0');
            slide.classList.add('block', 'opacity-100');
          } else {
            slide.classList.add('hidden', 'opacity-0');
            slide.classList.remove('block', 'opacity-100');
          }
        });
      };

      tabs.forEach((tab): void => {
        tab.addEventListener('click', (): void => {
          const targetIndex = parseInt(tab.getAttribute('data-feature-target') || '0', 10);
          switchTab(targetIndex);
        });
      });
    }

    // 2. iOS-Style Scroll Nudge Animation
    const scrollContainer = document.getElementById('homepage-feature-scroll-menu');
    if (scrollContainer) {
      let isInteracted = false;
      let nudgeInterval: ReturnType<typeof setInterval> | null = null;

      const stopNudge = (): void => {
        if (!isInteracted) {
          isInteracted = true;
          if (nudgeInterval) {
            clearInterval(nudgeInterval);
            nudgeInterval = null;
          }
        }
      };

      // UX Guards: stop nudge animation permanently upon any user interaction
      scrollContainer.addEventListener('mouseenter', stopNudge, { once: true });
      scrollContainer.addEventListener('touchstart', stopNudge, { once: true, passive: true });
      scrollContainer.addEventListener('wheel', stopNudge, { once: true, passive: true });
      scrollContainer.addEventListener('scroll', stopNudge, { once: true, passive: true });

      // Trigger subtle nudge every 2.5s (scrolls down ~20px, waits 300ms, scrolls back up ~20px)
      nudgeInterval = setInterval((): void => {
        if (isInteracted) return;

        scrollContainer.scrollBy({ top: 20, behavior: 'smooth' });

        setTimeout((): void => {
          if (!isInteracted) {
            scrollContainer.scrollBy({ top: -20, behavior: 'smooth' });
          }
        }, 300);
      }, 2500);
    }

    // 3. Mobile Features Carousel Auto-Scroll (5000ms Interval, Infinite Reset, Touch Pause/Resume)
    const mobileCarousel = document.getElementById('mobile-features-carousel');
    if (mobileCarousel) {
      let autoScrollTimer: ReturnType<typeof setInterval> | null = null;

      const startAutoScroll = (): void => {
        if (autoScrollTimer) clearInterval(autoScrollTimer);

        autoScrollTimer = setInterval((): void => {
          const firstCard = mobileCarousel.querySelector(
            '.mobile-feature-card'
          ) as HTMLElement | null;
          const gap = 16;
          const cardWidth = firstCard
            ? firstCard.offsetWidth + gap
            : mobileCarousel.clientWidth * 0.85 + gap;
          const maxScroll = mobileCarousel.scrollWidth - mobileCarousel.clientWidth;

          // Infinite loop: if scroll reaches maximum scroll width, smoothly reset to 0 (start)
          if (mobileCarousel.scrollLeft >= maxScroll - 15) {
            mobileCarousel.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            mobileCarousel.scrollBy({ left: cardWidth, behavior: 'smooth' });
          }
        }, 5000);
      };

      const stopAutoScroll = (): void => {
        if (autoScrollTimer) {
          clearInterval(autoScrollTimer);
          autoScrollTimer = null;
        }
      };

      // Pause on Touch: clear interval on touchstart, resume on touchend/touchcancel
      mobileCarousel.addEventListener('touchstart', stopAutoScroll, { passive: true });
      mobileCarousel.addEventListener('touchend', startAutoScroll, { passive: true });
      mobileCarousel.addEventListener('touchcancel', startAutoScroll, { passive: true });

      // Start auto-scrolling
      startAutoScroll();

      // Clean up interval when navigating away with Astro view transitions
      document.addEventListener(
        'astro:before-swap',
        (): void => {
          stopAutoScroll();
        },
        { once: true }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStorytellingCarousel);
  } else {
    initStorytellingCarousel();
  }
  document.addEventListener('astro:page-load', initStorytellingCarousel);
</script>
