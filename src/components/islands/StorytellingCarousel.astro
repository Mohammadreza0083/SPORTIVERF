---
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations } from '@/i18n/utils';
import contentData from '@/data/content.json';

export interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const localeContent = contentData[locale as keyof typeof contentData] || contentData.en;
const features = localeContent.homepageFeatures;
---

<section
  id="homepage-features-section"
  class="py-12 md:py-20 bg-[#0A0A0A] text-white overflow-hidden relative border-b border-[#222222]"
>
  <div class="max-w-[1400px] mx-auto px-4 md:px-8 mb-8 md:mb-12 text-center">
    <span
      class="inline-block px-3.5 py-1 bg-[#E5383B]/10 border border-[#E5383B]/30 text-[#E5383B] font-mono text-xs uppercase tracking-[0.2em] mb-3"
    >
      {locale === 'tr' ? 'HİZMETLER & UZMANLIK' : 'SERVICES & EXPERTISE'}
    </span>
    <h2
      class="font-barlow font-extrabold text-3xl sm:text-4xl md:text-5xl uppercase tracking-tight text-white"
    >
      {locale === 'tr' ? 'SPORTIVERF Hizmetleri' : 'SPORTIVERF Services & Features'}
    </h2>
  </div>

  <!-- Mobile UI: Horizontally scrolling flex snap carousel with swipe cue -->
  <div class="md:hidden">
    <!-- Swipe Hint Animation -->
    <div
      class="flex items-center justify-center gap-2 text-[#888888] font-mono text-[11px] uppercase tracking-widest mb-4 animate-pulse"
    >
      <span>{locale === 'tr' ? 'Kaydırarak Keşfedin' : 'Swipe to explore'}</span>
      <svg
        class="w-4 h-4 text-[#E5383B] animate-bounce"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </div>

    <!-- Mobile Horizontal Carousel Container -->
    <div
      class="flex overflow-x-auto snap-x snap-mandatory gap-4 hide-scrollbar px-6 pb-6 pt-2 scroll-smooth"
    >
      {
        features.map((feature, idx) => (
          <div class="snap-center shrink-0 min-w-[85vw] max-w-[85vw] bg-[#141414] border border-[#262626] p-6 flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-24 h-24 bg-[#E5383B]/10 rounded-full blur-2xl pointer-events-none" />
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-mono text-xs text-[#E5383B] font-bold uppercase tracking-widest">
                  {String(idx + 1).padStart(2, '0')} / SPORTIVERF
                </span>
                <div class="w-8 h-8 rounded bg-[#E5383B]/10 border border-[#E5383B]/30 flex items-center justify-center text-[#E5383B] font-mono text-xs font-bold">
                  {String(idx + 1).padStart(2, '0')}
                </div>
              </div>
              <h3 class="font-barlow font-extrabold text-xl uppercase tracking-tight text-white mb-3">
                {feature.title}
              </h3>
              <p class="text-xs text-[#AAAAAA] leading-relaxed font-light whitespace-pre-line">
                {feature.description}
              </p>
            </div>
            <div class="pt-4 mt-6 border-t border-[#222222] font-mono text-[10px] text-[#888888] uppercase tracking-widest flex items-center justify-between">
              <span>SPORTIVERF EXCELLENCE</span>
              <span class="text-[#E5383B]">0{idx + 1}</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Mobile Bottom CTA -->
    <div class="px-6 pt-4">
      <a
        href={`/${locale}/about`}
        class="btn-red !py-3.5 !px-5 text-xs text-center w-full block font-barlow font-bold uppercase tracking-wider"
      >
        {t('about.storyTitle')} &rarr;
      </a>
    </div>
  </div>

  <!-- Desktop UI: Clean Grid Layout -->
  <div class="hidden md:block max-w-[1400px] mx-auto px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        features.map((feature, idx) => (
          <div class="bg-[#121212] border border-[#262626] hover:border-[#E5383B]/60 p-7 lg:p-8 flex flex-col justify-between relative overflow-hidden group transition-all duration-300 hover:shadow-[0_0_30px_rgba(229,56,59,0.15)]">
            <div class="absolute top-0 right-0 w-32 h-32 bg-[#E5383B]/5 rounded-full blur-3xl pointer-events-none group-hover:bg-[#E5383B]/15 transition-all duration-300" />
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-5">
                <span class="font-mono text-xs font-bold text-[#E5383B] uppercase tracking-widest">
                  {String(idx + 1).padStart(2, '0')}
                </span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#E5383B]/60 group-hover:bg-[#E5383B] transition-colors" />
              </div>
              <h3 class="font-barlow font-black text-2xl uppercase tracking-tight text-white mb-4 transition-colors">
                {feature.title}
              </h3>
              <p class="text-sm text-[#AAAAAA] leading-relaxed font-light whitespace-pre-line">
                {feature.description}
              </p>
            </div>
            <div class="pt-6 mt-6 border-t border-white/5 flex items-center justify-between relative z-10">
              <span class="font-mono text-[10px] uppercase tracking-widest text-[#666666] group-hover:text-[#888888] transition-colors">
                SPORTIVERF • {locale === 'tr' ? 'HİZMET' : 'FEATURE'}
              </span>
              <svg
                class="w-4 h-4 text-[#E5383B] transform group-hover:translate-x-1 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"
                />
              </svg>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Desktop CTA Button Below Grid -->
    <div class="flex justify-center mt-12">
      <a
        href={`/${locale}/about`}
        class="btn-red !py-4 !px-8 text-sm font-barlow font-bold uppercase tracking-wider inline-flex items-center gap-3 shadow-[0_0_20px_rgba(229,56,59,0.3)] hover:shadow-[0_0_30px_rgba(229,56,59,0.6)] transition-all"
      >
        <span>{t('about.storyTitle')}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
