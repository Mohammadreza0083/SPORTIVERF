---
import { SUPPORTED_LOCALES } from '@/i18n/config';
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations } from '@/i18n/utils';

export interface Props {
  currentLocale: SupportedLocale;
}

const { currentLocale } = Astro.props;
const t = useTranslations(currentLocale);
---

<div
  id="language-gate-backdrop"
  class="fixed inset-0 z-[100] flex items-center justify-center bg-[#0D0D0D]/80 backdrop-blur-xl transition-opacity duration-500 opacity-0 pointer-events-none hidden px-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="gate-title"
  aria-describedby="gate-subtitle"
>
  <div
    id="language-gate-modal"
    class="w-full max-w-lg mx-auto border border-[#E5E3DC] bg-[#FAF9F6] p-6 sm:p-8 md:p-10 shadow-2xl text-center text-[#0D0D0D] transform scale-95 transition-all duration-300 relative"
  >
    <!-- Top Gold Accent Bar -->
    <div class="absolute top-0 left-0 right-0 h-1 bg-[#C5A059]" />

    <!-- Brand Mark -->
    <div class="mb-6 flex justify-center">
      <span class="font-serif font-bold text-3xl tracking-tight text-[#0D0D0D] pb-1 border-b border-[#C5A059]">
        SPORTIV<span class="text-[#C5A059]">ERF</span>
      </span>
    </div>

    <!-- Title & Subtitle -->
    <h2 id="gate-title" class="font-serif text-2xl md:text-3xl font-bold tracking-tight text-[#0D0D0D]">
      {t('gate.title')}
    </h2>
    <p id="gate-subtitle" class="mt-3 text-xs md:text-sm text-[#555555] font-light leading-relaxed max-w-md mx-auto">
      {t('gate.subtitle')}
    </p>

    <!-- Language Choices List -->
    <div class="mt-8 space-y-3">
      {Object.values(SUPPORTED_LOCALES).map((loc) => (
        <button
          type="button"
          data-lang={loc.code}
          class="gate-lang-btn group w-full flex items-center justify-between px-5 sm:px-6 py-4 border border-[#E5E3DC] bg-white hover:bg-[#0D0D0D] hover:text-white hover:border-[#0D0D0D] transition-all duration-300 text-left rtl:text-right font-medium focus:outline-none"
        >
          <div class="flex items-center space-x-3 rtl:space-x-reverse">
            <span class="text-xs uppercase tracking-widest font-mono text-[#C5A059] group-hover:text-[#C5A059] transition-colors">
              {loc.code}
            </span>
            <span class="text-sm font-semibold text-[#0D0D0D] group-hover:text-white transition-colors">
              {loc.nativeName}
            </span>
          </div>
          <span class="text-xs text-[#888888] group-hover:text-neutral-300 transition-colors font-sans">
            {loc.name}
          </span>
        </button>
      ))}
    </div>

    <!-- Minimal Privacy / Persistence Note -->
    <p class="mt-8 text-[11px] text-[#888888] font-mono uppercase tracking-widest">
      {t('gate.remember')}
    </p>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const backdrop = document.getElementById('language-gate-backdrop');
    const modal = document.getElementById('language-gate-modal');
    const langBtns = document.querySelectorAll('.gate-lang-btn');

    if (!backdrop || !modal) return;

    // Check if user-lang preference is saved
    const savedLang = localStorage.getItem('user-lang');

    if (!savedLang) {
      backdrop.classList.remove('hidden');
      requestAnimationFrame(() => {
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        modal.classList.remove('scale-95');
        modal.classList.add('scale-100');
      });
    }

    // Language selection click handler
    langBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedLang = btn.getAttribute('data-lang');
        if (!selectedLang) return;

        // Store choice in localStorage & Cookie (1 year duration)
        localStorage.setItem('user-lang', selectedLang);
        document.cookie = `user-lang=${selectedLang}; path=/; max-age=31536000; SameSite=Lax`;

        // Hide modal
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');

        // Robust redirect logic avoiding 404s
        setTimeout(() => {
          const currentPath = window.location.pathname;
          // Strip locale prefix if already present (/en, /tr, /fa)
          const cleanPath = currentPath.replace(/^\/(en|tr|fa)(\/|$)/, '/');
          const normalizedPath = cleanPath.startsWith('/') ? cleanPath : '/' + cleanPath;
          const targetUrl = `/${selectedLang}${normalizedPath === '/' ? '' : normalizedPath}`;

          if (window.location.pathname !== targetUrl) {
            window.location.href = targetUrl;
          } else {
            backdrop.classList.add('hidden');
          }
        }, 300);
      });
    });
  });
</script>
