---
// Root redirect to default locale using relative path for Vercel preview compatibility
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/en" />
    <link rel="canonical" href="/en" />
    <title>Redirecting...</title>
    <script is:inline>
      window.location.replace('/en');
    </script>
  </head>
  <body>
    <p>Redirecting to <a href="/en">/en</a>...</p>
  </body>
</html>

