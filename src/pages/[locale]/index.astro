---
import MainLayout from '@/layouts/MainLayout.astro';
import { LOCALES_LIST } from '@/i18n/config';
import type { SupportedLocale } from '@/types/i18n';
import StorytellingCarousel from '@/components/islands/StorytellingCarousel.astro';
import FeaturedCampsSlider from '@/components/islands/FeaturedCampsSlider.astro';
import PartnerEcosystem from '@/components/shared/PartnerEcosystem.astro';
import ContactButtons from '@/components/shared/ContactButtons.astro';
import { useTranslations } from '@/i18n/utils';

export function getStaticPaths() {
  return LOCALES_LIST.map((locale) => ({
    params: { locale }
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = useTranslations(locale);
---

<MainLayout
  locale={locale}
  seo={{
    title: t('site.title'),
    description: t('site.description')
  }}
>
  <!-- Redesigned Hero Section with Full-Screen Unsplash Image Background -->
  <section
    class="relative min-h-[85vh] md:min-h-[90vh] flex flex-col justify-between bg-[#0D0D0D] text-white border-b border-[#222222] overflow-hidden w-full max-w-full"
  >
    <!-- Unsplash Hero Background Asset with Gradient Overlays -->
    <div class="absolute inset-0 z-0">
      <picture class="w-full h-full block">
        <source srcset="/images/hero-bg.webp" type="image/webp" />
        <img
          src="/images/hero-bg.jpg"
          alt="SPORTIVERF Soccer Silhouette Field"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover object-center opacity-45 scale-105 transition-transform duration-1000"
        />
      </picture>
      <div
        class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A] via-[#0D0D0D]/60 to-[#0D0D0D]/80"
      >
      </div>
      <div
        class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-transparent via-[#000000]/40 to-[#000000]/80"
      >
      </div>
    </div>

    <!-- Main Hero Content Overlay -->
    <div
      class="max-w-[1400px] mx-auto px-4 md:px-8 pt-28 pb-16 md:pt-36 md:pb-20 text-center flex flex-col items-center relative z-10 w-full flex-1 justify-center"
    >
      <!-- Top Tagline Badge -->
      <span
        class="inline-block px-4 py-1.5 bg-[#E5383B]/10 border border-[#E5383B]/40 text-[#E5383B] font-mono text-xs uppercase tracking-[0.2em] mb-6 backdrop-blur-md"
      >
        {t('hero.badge')}
      </span>

      <!-- Main Athletic Headline with Barlow Condensed -->
      <h1
        class="font-barlow font-black text-5xl sm:text-7xl md:text-8xl lg:text-9xl uppercase tracking-tight text-white max-w-6xl leading-[0.95] mb-6 drop-shadow-lg"
      >
        {t('hero.title')}
      </h1>

      <!-- Subtitle -->
      <p
        class="font-sans text-base md:text-xl text-[#DDDDDD] max-w-2xl font-light mb-12 leading-relaxed drop-shadow-md"
      >
        {t('hero.subtitle')}
      </p>

      <!-- Absolute Interactive CTA Buttons with Tooltip/Guide UX -->
      <div class="relative w-full max-w-3xl my-6 min-h-[140px] flex items-center justify-center">
        <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 z-20">
          <!-- CTA 1: Volleyball Camps -->
          <div class="relative group/cta">
            <a
              href={`/${locale}/volleyball-camps`}
              class="btn-red !py-4 !px-7 font-barlow font-bold text-sm tracking-[0.18em] uppercase flex items-center gap-2 shadow-2xl relative"
            >
              <span>Volleyball Camps</span>
              <!-- Mobile Help Icon -->
              <button
                type="button"
                data-guide-trigger="volleyball-camps"
                class="sm:hidden w-5 h-5 rounded-full bg-white/20 text-white flex items-center justify-center text-[10px] font-mono ml-1 hover:bg-white/40 focus:outline-none"
                aria-label="Volleyball Camps Guide"
              >
                ?
              </button>
            </a>

            <!-- Desktop Floating Tooltip -->
            <div
              class="hidden sm:block absolute bottom-full left-1/2 -translate-x-1/2 mb-3 w-64 p-3 bg-[#181818]/95 border border-[#E5383B] text-white text-xs font-sans rounded-none shadow-2xl opacity-0 translate-y-2 pointer-events-none group-hover/cta:opacity-100 group-hover/cta:translate-y-0 transition-all duration-300 z-30 backdrop-blur-md text-left"
            >
              <span class="font-barlow font-bold text-sm uppercase text-[#E5383B] block mb-1"
                >Volleyball Masterclasses</span
              >
              FIVB Taraflex court clinics, jump serve biomechanics, and scout exposure.
              <div
                class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-[#E5383B]"
              >
              </div>
            </div>
          </div>

          <!-- CTA 2: Football Camps -->
          <div class="relative group/cta">
            <a
              href={`/${locale}/football-camps`}
              class="btn-primary !py-4 !px-7 !bg-white !text-[#0D0D0D] hover:!bg-[#E5383B] hover:!text-white font-barlow font-bold text-sm tracking-[0.18em] uppercase flex items-center gap-2 shadow-2xl relative"
            >
              <span>Football Camps</span>
              <!-- Mobile Help Icon -->
              <button
                type="button"
                data-guide-trigger="football-camps"
                class="sm:hidden w-5 h-5 rounded-full bg-black/20 text-black flex items-center justify-center text-[10px] font-mono ml-1 hover:bg-black/40 focus:outline-none"
                aria-label="Football Camps Guide"
              >
                ?
              </button>
            </a>

            <!-- Desktop Floating Tooltip -->
            <div
              class="hidden sm:block absolute bottom-full left-1/2 -translate-x-1/2 mb-3 w-64 p-3 bg-[#181818]/95 border border-[#E5383B] text-white text-xs font-sans rounded-none shadow-2xl opacity-0 translate-y-2 pointer-events-none group-hover/cta:opacity-100 group-hover/cta:translate-y-0 transition-all duration-300 z-30 backdrop-blur-md text-left"
            >
              <span class="font-barlow font-bold text-sm uppercase text-[#E5383B] block mb-1"
                >Football Showcases</span
              >
              UEFA Pro coaches, FIFA hybrid grass pitches, and European scout evaluations.
              <div
                class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-[#E5383B]"
              >
              </div>
            </div>
          </div>

          <!-- CTA 3: Volleyball Direct -->
          <div class="relative group/cta">
            <a
              href={`/${locale}/volleyball-camps`}
              class="btn-secondary !border-white !text-white hover:!bg-[#E5383B] hover:!border-[#E5383B] !py-4 !px-7 font-barlow font-bold text-sm tracking-[0.18em] uppercase flex items-center gap-2 backdrop-blur-md relative"
            >
              <span>Volleyball</span>
              <!-- Mobile Help Icon -->
              <button
                type="button"
                data-guide-trigger="volleyball-direct"
                class="sm:hidden w-5 h-5 rounded-full bg-white/20 text-white flex items-center justify-center text-[10px] font-mono ml-1 hover:bg-white/40 focus:outline-none"
                aria-label="Volleyball Guide"
              >
                ?
              </button>
            </a>

            <!-- Desktop Floating Tooltip -->
            <div
              class="hidden sm:block absolute bottom-full left-1/2 -translate-x-1/2 mb-3 w-64 p-3 bg-[#181818]/95 border border-[#E5383B] text-white text-xs font-sans rounded-none shadow-2xl opacity-0 translate-y-2 pointer-events-none group-hover/cta:opacity-100 group-hover/cta:translate-y-0 transition-all duration-300 z-30 backdrop-blur-md text-left"
            >
              <span class="font-barlow font-bold text-sm uppercase text-[#E5383B] block mb-1"
                >High-Altitude Indoor</span
              >
              Specialized setter, libero & attacker high-altitude training camps.
              <div
                class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-[#E5383B]"
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Interactive Guide Popover Modal -->
    <div
      id="mobile-guide-modal"
      class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 hidden flex items-center justify-center p-4"
    >
      <div
        class="bg-[#181818] border-2 border-[#E5383B] p-6 max-w-sm w-full text-left relative text-white space-y-4"
      >
        <button
          id="close-guide-modal"
          class="absolute top-3 right-3 text-[#888888] hover:text-white font-mono text-lg"
          >&times;</button
        >
        <div class="w-10 h-1 bg-[#E5383B] mb-2"></div>
        <h4 id="guide-title" class="font-barlow font-bold text-2xl uppercase text-[#E5383B]">
          Camp Guide
        </h4>
        <p id="guide-body" class="text-sm text-[#DDDDDD] font-light leading-relaxed">
          Explanation guide text goes here.
        </p>
        <button
          id="guide-action-btn"
          class="btn-red w-full !py-3 text-xs font-barlow font-bold uppercase tracking-wider block text-center"
        >
          Explore Now
        </button>
      </div>
    </div>

    <!-- Statistics Strip Directly Positioned Underneath Hero Content -->
    <div
      class="w-full border-t border-[#222222] bg-[#0A0A0A]/90 backdrop-blur-md relative z-10 py-8"
    >
      <div
        class="max-w-[1400px] mx-auto px-4 md:px-8 grid grid-cols-1 sm:grid-cols-3 gap-8 text-center"
      >
        <div>
          <span
            class="font-barlow font-black text-4xl md:text-5xl text-white block transition-all"
            data-counter="500"
            data-suffix="+"
          >
            0+
          </span>
          <span
            class="font-mono text-xs text-[#888888] uppercase tracking-wider mt-1 block font-medium"
            >{t('hero.statAthletes')}</span
          >
        </div>
        <div class="sm:border-x border-[#222222]">
          <span
            class="font-barlow font-black text-4xl md:text-5xl text-white block transition-all"
            data-counter="40"
            data-suffix="+"
          >
            0+
          </span>
          <span
            class="font-mono text-xs text-[#888888] uppercase tracking-wider mt-1 block font-medium"
            >{t('hero.statClubs')}</span
          >
        </div>
        <div>
          <span
            class="font-barlow font-black text-4xl md:text-5xl text-white block transition-all"
            data-counter="15"
            data-suffix="+"
          >
            0+
          </span>
          <span
            class="font-mono text-xs text-[#888888] uppercase tracking-wider mt-1 block font-medium"
            >{t('hero.statAcademies')}</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Storytelling Section (Hero-Adjacent Sticky Carousel) -->
  <StorytellingCarousel locale={locale} />

  <!-- Home Page Featured Camps Section (Peeking/Blur Slider) -->
  <FeaturedCampsSlider locale={locale} />

  <!-- Parent Agency (Aklimosaturizm) & Partner Ecosystem Section -->
  <PartnerEcosystem locale={locale} />

  <!-- Concierge Direct Action Section -->
  <section class="py-20 bg-white border-t border-[#E5E3DC] text-center">
    <div class="max-w-3xl mx-auto px-4">
      <span class="font-mono text-xs text-[#E5383B] uppercase tracking-[0.2em] block mb-3">
        {t('booking.badge')}
      </span>
      <h2
        class="font-barlow font-extrabold text-3xl md:text-5xl uppercase tracking-tight text-[#0D0D0D] mb-6"
      >
        {t('booking.title')}
      </h2>
      <p class="text-[#555555] text-base mb-8 leading-relaxed font-light">
        {t('booking.subtitle')}
      </p>
      <ContactButtons class="justify-center" />
    </div>
  </section>
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Kinetic Stats Counter Trigger
    const counters = document.querySelectorAll('[data-counter]');

    if (counters.length) {
      const animateCounter = (counter: Element): void => {
        const target = parseInt(counter.getAttribute('data-counter') || '0', 10);
        const suffix = counter.getAttribute('data-suffix') || '';
        const duration = 2000;
        const startTime = performance.now();

        const updateCount = (currentTime: number): void => {
          const elapsedTime = currentTime - startTime;
          const progress = Math.min(elapsedTime / duration, 1);
          const easeProgress = 1 - Math.pow(1 - progress, 3);
          const currentCount = Math.floor(easeProgress * target);

          counter.textContent = `${currentCount}${suffix}`;

          if (progress < 1) {
            requestAnimationFrame(updateCount);
          } else {
            counter.textContent = `${target}${suffix}`;
          }
        };

        requestAnimationFrame(updateCount);
      };

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCounter(entry.target);
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.2 }
      );

      counters.forEach((c) => observer.observe(c));
    }

    // Mobile Guide Popover Trigger Logic
    const guideTriggers = document.querySelectorAll('[data-guide-trigger]');
    const guideModal = document.getElementById('mobile-guide-modal');
    const closeGuideBtn = document.getElementById('close-guide-modal');
    const guideTitle = document.getElementById('guide-title');
    const guideBody = document.getElementById('guide-body');
    const guideActionBtn = document.getElementById('guide-action-btn');

    const guideData = {
      'volleyball-camps': {
        title: 'Volleyball Camps',
        body: 'FIVB Taraflex court clinics, jump serve biomechanics, and direct scout exposure across top Turkish indoor arenas.',
        link: '/volleyball-camps'
      },
      'football-camps': {
        title: 'Football Camps',
        body: 'UEFA Pro coaches, 5-Star resort stays, FIFA Quality Pro hybrid pitches, and European scout showcase evaluations.',
        link: '/football-camps'
      },
      'volleyball-direct': {
        title: 'Volleyball Masterclass',
        body: 'Specialized setter, libero, and attacker high-altitude training clinics for international youth athletes.',
        link: '/volleyball-camps'
      }
    };

    guideTriggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const key = trigger.getAttribute('data-guide-trigger');
        const info = key && key in guideData ? guideData[key as keyof typeof guideData] : null;

        if (info && guideModal && guideTitle && guideBody && guideActionBtn) {
          guideTitle.textContent = info.title;
          guideBody.textContent = info.body;
          guideActionBtn.onclick = (): void => {
            window.location.href = info.link;
          };
          guideModal.classList.remove('hidden');
        }
      });
    });

    if (closeGuideBtn && guideModal) {
      closeGuideBtn.addEventListener('click', () => {
        guideModal.classList.add('hidden');
      });

      guideModal.addEventListener('click', (e) => {
        if (e.target === guideModal) {
          guideModal.classList.add('hidden');
        }
      });
    }
  });
</script>
