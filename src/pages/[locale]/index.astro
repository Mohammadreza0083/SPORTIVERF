---
import MainLayout from '@/layouts/MainLayout.astro';
import { LOCALES_LIST } from '@/i18n/config';
import type { SupportedLocale } from '@/types/i18n';
import HeroSection from '@/components/shared/HeroSection.astro';
import StorytellingCarousel from '@/components/islands/StorytellingCarousel.astro';
import FeaturedCampsSlider from '@/components/islands/FeaturedCampsSlider.astro';
import PartnerEcosystem from '@/components/shared/PartnerEcosystem.astro';
import ContactButtons from '@/components/shared/ContactButtons.astro';
import { useTranslations } from '@/i18n/utils';

export function getStaticPaths() {
  return LOCALES_LIST.map((locale) => ({
    params: { locale }
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = useTranslations(locale);
---

<MainLayout
  locale={locale}
  seo={{
    title: t('site.title'),
    description: t('site.description')
  }}
>
  <!-- Redesigned Hero Section Component with Elite Obsidian Aesthetic & Language-Aware Alignment -->
  <HeroSection locale={locale} />

  <!-- Interactive Storytelling Section (Hero-Adjacent Sticky Carousel) -->
  <StorytellingCarousel locale={locale} />

  <!-- Home Page Featured Camps Section (Peeking/Blur Slider) -->
  <FeaturedCampsSlider locale={locale} />

  <!-- Parent Agency (Aklimosaturizm) & Partner Ecosystem Section -->
  <PartnerEcosystem locale={locale} />

  <!-- Concierge Direct Action Section -->
  <section class="py-20 bg-white border-t border-[#E5E3DC] text-center">
    <div class="max-w-3xl mx-auto px-4">
      <span class="font-mono text-xs text-[#E5383B] uppercase tracking-[0.2em] block mb-3">
        {t('booking.badge')}
      </span>
      <h2
        class="font-barlow font-extrabold text-3xl md:text-5xl uppercase tracking-tight text-[#0D0D0D] mb-6"
      >
        {t('booking.title')}
      </h2>
      <p class="text-[#555555] text-base mb-8 leading-relaxed font-light">
        {t('booking.subtitle')}
      </p>
      <ContactButtons locale={locale} class="justify-center" />
    </div>
  </section>
</MainLayout>
