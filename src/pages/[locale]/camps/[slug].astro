---
import MainLayout from '@/layouts/MainLayout.astro';
import { LOCALES_LIST } from '@/i18n/config';
import type { SupportedLocale } from '@/types/i18n';
import BookingIsland from '@/components/islands/BookingIsland.astro';
import OptimizedImage from '@/components/seo/OptimizedImage.astro';
import ContactButtons from '@/components/shared/ContactButtons.astro';
import campsData from '@/data/camps.json';
import { getCampBySlug, type CampItem } from '@/data/camps';
import { useTranslations, getLocalizedField } from '@/i18n/utils';

const allCamps = campsData as CampItem[];

export function getStaticPaths() {
  const slugs = (campsData as CampItem[]).map((camp) => camp.slug);

  return LOCALES_LIST.flatMap((locale) =>
    slugs.map((slug) => ({
      params: { locale, slug }
    }))
  );
}

const { locale, slug } = Astro.params as { locale: SupportedLocale; slug: string };
const t = useTranslations(locale);

const camp = getCampBySlug(slug) || allCamps[0];

const title = getLocalizedField(camp.title, locale);
const summary = getLocalizedField(camp.summary, locale);
const location = getLocalizedField(camp.location, locale);
const dates = getLocalizedField(camp.dates, locale);
const ageGroup = getLocalizedField(camp.ageGroup, locale);
const capacity = getLocalizedField(camp.capacity, locale);
const tierName = getLocalizedField(camp.tierName, locale);
const includedServices = camp.includedServices[locale] || camp.includedServices['en'] || [];
---

<MainLayout
  locale={locale}
  seo={{
    title: `${title} — SPORTIVERF`,
    description: summary,
    image: camp.imageUrl
  }}
>
  <!-- Split Light Luxury Detail Section -->
  <section class="py-12 bg-[#FAF9F6] border-b border-[#E5E3DC]">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
      <!-- Breadcrumb Navigation -->
      <nav
        aria-label="Breadcrumb"
        class="mb-6 font-mono text-xs text-[#888888] uppercase tracking-widest flex items-center gap-2"
      >
        <a href={`/${locale}`} class="hover:text-[#C5A059] transition">{t('nav.home')}</a>
        <span>/</span>
        <a href={`/${locale}/tours`} class="hover:text-[#C5A059] transition">{t('nav.tours')}</a>
        <span>/</span>
        <span class="text-[#0D0D0D] font-bold">{camp.sport}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <!-- Left 60% Hero & Content -->
        <div class="lg:col-span-7 space-y-8">
          <!-- Main Hero Image Container -->
          <div
            class="relative w-full aspect-[16/10] overflow-hidden border border-[#E5E3DC] bg-white shadow-md"
          >
            <OptimizedImage
              src={camp.imageUrl}
              alt={title}
              width={1200}
              height={750}
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover"
            />
            <div class="absolute top-4 left-4 z-10 flex gap-2">
              <span
                class="px-3 py-1 bg-[#0D0D0D] text-white font-mono text-xs uppercase tracking-widest shadow-md"
              >
                {camp.sport}
              </span>
              <span
                class="px-3 py-1 bg-[#C5A059] text-white font-mono text-xs uppercase tracking-widest shadow-md font-bold"
              >
                {camp.starRating}★ {tierName}
              </span>
            </div>
          </div>

          <!-- Header Titles & Location -->
          <div>
            <h1
              class="font-serif font-bold text-3xl sm:text-4xl md:text-5xl text-[#0D0D0D] tracking-tight leading-tight mb-4"
            >
              {title}
            </h1>
            <p
              class="font-mono text-xs text-[#888888] uppercase tracking-wider flex items-center gap-2"
            >
              <svg
                class="w-4 h-4 fill-none stroke-current stroke-2 text-[#C5A059]"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                ></path>
              </svg>
              <span>{location}</span>
            </p>
          </div>

          <!-- Overview Card -->
          <div class="bg-white p-6 border border-[#E5E3DC] space-y-3 shadow-sm">
            <h3 class="font-mono text-xs font-bold text-[#C5A059] uppercase tracking-widest">
              EXPEDITION OVERVIEW
            </h3>
            <p class="text-[#555555] text-base leading-relaxed font-light">{summary}</p>
          </div>

          <!-- Specifications Strip -->
          <div
            class="grid grid-cols-3 gap-4 py-4 px-6 bg-white border border-[#E5E3DC] text-center font-mono"
          >
            <div>
              <span class="block text-[10px] text-[#888888] uppercase tracking-widest"
                >{t('camps.dates')}</span
              >
              <span class="text-xs font-bold text-[#0D0D0D] mt-1 block">{dates}</span>
            </div>
            <div class="border-x border-[#E5E3DC]">
              <span class="block text-[10px] text-[#888888] uppercase tracking-widest"
                >{t('camps.age')}</span
              >
              <span class="text-xs font-bold text-[#0D0D0D] mt-1 block">{ageGroup}</span>
            </div>
            <div>
              <span class="block text-[10px] text-[#888888] uppercase tracking-widest"
                >{t('camps.capacity')}</span
              >
              <span class="text-xs font-bold text-[#C5A059] mt-1 block">{capacity}</span>
            </div>
          </div>

          <!-- Included Services List -->
          <div>
            <h3 class="font-mono text-xs font-bold text-[#C5A059] uppercase tracking-widest mb-4">
              INCLUDED SERVICES & SPECIFICATIONS
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {
                includedServices.map((service) => (
                  <div class="bg-white p-4 border border-[#E5E3DC] flex items-center gap-3">
                    <div class="w-2 h-2 rounded-full bg-[#C5A059] flex-shrink-0" />
                    <span class="text-xs font-medium text-[#0D0D0D]">{service}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Right 40% Sticky Booking Card -->
        <div class="lg:col-span-5 lg:sticky lg:top-28">
          <BookingIsland
            locale={locale}
            tourId={slug}
            tourTitle={title}
            sport={camp.sport}
            starTier={`${camp.starRating}-Star ${tierName}`}
          />

          <div class="mt-8 bg-white p-6 border border-[#E5E3DC] text-center shadow-sm">
            <p class="font-mono text-xs text-[#888888] uppercase tracking-widest mb-3">
              Direct Contact & Custom Team Packages
            </p>
            <ContactButtons class="justify-center" campTitle={title} />
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
