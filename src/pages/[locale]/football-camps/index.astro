---
import MainLayout from '@/layouts/MainLayout.astro';
import { LOCALES_LIST } from '@/i18n/config';
import type { SupportedLocale } from '@/types/i18n';
import CampCard from '@/components/shared/CampCard.astro';
import FilterBar from '@/components/islands/FilterBar.astro';
import ContactButtons from '@/components/shared/ContactButtons.astro';
import { CAMPS_DATA } from '@/data/camps';
import { useTranslations, getLocalizedField } from '@/i18n/utils';

export function getStaticPaths() {
  return LOCALES_LIST.map((locale) => ({
    params: { locale }
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = useTranslations(locale);

const footballCamps = CAMPS_DATA.filter((camp) => camp.sport === 'FOOTBALL');
---

<MainLayout
  locale={locale}
  seo={{
    title: `${t('nav.football')} — SPORTIVERF`,
    description: t('site.description')
  }}
>
  <!-- Category Hero -->
  <section class="relative py-24 bg-[#FAF9F6] border-b border-[#E5E3DC] overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8 text-center relative z-10">
      <span class="font-mono text-xs text-[#C5A059] uppercase tracking-[0.2em] block mb-4">
        FIFA QUALITY PRO FIELDS • UEFA LICENSED COACHES
      </span>
      <h1 class="font-serif font-bold text-4xl sm:text-6xl text-[#0D0D0D] tracking-tight mb-6">
        {t('nav.football')}
      </h1>
      <p class="font-sans text-[#555555] text-base md:text-lg max-w-2xl mx-auto font-light leading-relaxed">
        High-intensity development camps, tactical pitch training, match video analysis, and direct exposure to European scouts across 3-Star, 4-Star, and 5-Star VIP categories.
      </p>
    </div>
  </section>

  <!-- Filter Bar -->
  <FilterBar locale={locale} activeSport="FOOTBALL" activeStar="ALL" />

  <!-- Camp Cards Grid -->
  <section class="py-16 bg-[#FAF9F6]">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {footballCamps.map((camp) => (
          <div data-camp-wrapper data-sport={camp.sport} data-star-rating={camp.starRating}>
            <CampCard
              locale={locale}
              title={getLocalizedField(camp.title, locale)}
              sport={camp.sport}
              starRating={camp.starRating}
              tierName={getLocalizedField(camp.tierName, locale)}
              location={getLocalizedField(camp.location, locale)}
              dates={getLocalizedField(camp.dates, locale)}
              ageGroup={getLocalizedField(camp.ageGroup, locale)}
              capacity={getLocalizedField(camp.capacity, locale)}
              imageUrl={camp.imageUrl}
              href={`/${locale}/camps/${camp.slug}`}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Facility & Scout Highlights -->
  <section class="py-20 bg-white border-t border-[#E5E3DC]">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
      <div class="text-center mb-16">
        <span class="font-mono text-xs text-[#C5A059] uppercase tracking-[0.2em] block mb-2">
          WHY ATHLETES CHOOSE SPORTIVERF
        </span>
        <h2 class="font-serif font-bold text-3xl md:text-4xl text-[#0D0D0D]">
          FOOTBALL EXCELLENCE STANDARDS
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-[#FAF9F6] p-8 border border-[#E5E3DC]">
          <h3 class="font-serif font-bold text-xl text-[#0D0D0D] mb-3">FIFA Standard Pitches</h3>
          <p class="text-[#555555] text-sm leading-relaxed font-light">
            Natural hybrid and FIFA Quality Pro synthetic turf fields with recovery facilities and floodlighting.
          </p>
        </div>
        <div class="bg-[#FAF9F6] p-8 border border-[#E5E3DC]">
          <h3 class="font-serif font-bold text-xl text-[#0D0D0D] mb-3">UEFA A Coaches</h3>
          <p class="text-[#555555] text-sm leading-relaxed font-light">
            Coaching staff featuring UEFA A & Pro licensed managers from professional European academies.
          </p>
        </div>
        <div class="bg-[#FAF9F6] p-8 border border-[#E5E3DC]">
          <h3 class="font-serif font-bold text-xl text-[#0D0D0D] mb-3">PDF Scout Reports</h3>
          <p class="text-[#555555] text-sm leading-relaxed font-light">
            GPS tracking, match video breakdown, and detailed scout evaluation dossiers provided to every athlete.
          </p>
        </div>
      </div>

      <div class="mt-16 text-center">
        <ContactButtons class="justify-center" />
      </div>
    </div>
  </section>
</MainLayout>
