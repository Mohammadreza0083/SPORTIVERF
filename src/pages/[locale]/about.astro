---
import MainLayout from '@/layouts/MainLayout.astro';
import { LOCALES_LIST } from '@/i18n/config';
import type { SupportedLocale } from '@/types/i18n';
import ContactButtons from '@/components/shared/ContactButtons.astro';
import { useTranslations } from '@/i18n/utils';

export function getStaticPaths() {
  return LOCALES_LIST.map((locale) => ({
    params: { locale }
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = useTranslations(locale);
---

<MainLayout
  locale={locale}
  seo={{
    title: `${t('nav.about')} — SPORTIVERF`,
    description: t('about.storyDesc')
  }}
>
  <!-- Hero Section -->
  <section class="relative py-28 bg-[#0A0A0A] text-white border-b border-[#222222] overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8 text-center relative z-10">
      <span
        class="inline-block px-4 py-1.5 bg-[#E5383B]/10 border border-[#E5383B]/40 text-[#E5383B] font-mono text-xs uppercase tracking-[0.2em] mb-6 shadow-sm"
      >
        {t('about.badge')}
      </span>

      <h1
        class="font-barlow font-black text-5xl sm:text-7xl md:text-8xl uppercase text-white tracking-tight mb-6 max-w-4xl mx-auto leading-tight"
      >
        {t('about.heroTitle')}
      </h1>

      <p
        class="font-sans text-base md:text-lg text-[#DDDDDD] max-w-2xl mx-auto font-light leading-relaxed mb-10"
      >
        {t('about.heroSubtitle')}
      </p>
    </div>
  </section>

  <!-- Narrative Story & Aklimosaturizm Supervision -->
  <section class="py-24 bg-white border-b border-[#E5E3DC]">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Story Column -->
        <div class="lg:col-span-6 space-y-6">
          <span class="font-mono text-xs text-[#E5383B] uppercase tracking-[0.2em] block">
            SPORTIVERF HERITAGE
          </span>
          <h2 class="font-barlow font-extrabold text-3xl md:text-5xl uppercase tracking-tight text-[#0D0D0D] leading-tight">
            {t('about.storyTitle')}
          </h2>
          <p class="text-[#555555] text-base leading-relaxed font-light">
            {t('about.storyDesc')}
          </p>
          <div class="p-6 bg-[#FAF9F6] border-l-4 border-[#E5383B] border border-[#E5E3DC]">
            <h4 class="font-barlow font-bold text-xl uppercase text-[#0D0D0D] mb-1">
              {t('about.supervisionTitle')}
            </h4>
            <p class="text-xs text-[#666666] leading-relaxed">
              {t('about.supervisionDesc')}
            </p>
          </div>
        </div>

        <!-- Visual Image Showcase Column -->
        <div class="lg:col-span-6 relative">
          <div
            class="relative w-full aspect-[4/3] border border-[#E5E3DC] shadow-xl overflow-hidden bg-[#FAF9F6]"
          >
            <img
              src="https://images.unsplash.com/photo-1517649763962-0c623266010b?q=80&w=1200&auto=format&fit=crop"
              alt="SPORTIVERF Athletic Training"
              class="w-full h-full object-cover filter contrast-105"
            />
            <div
              class="absolute bottom-6 left-6 right-6 p-6 bg-white/95 backdrop-blur-md border border-[#E5E3DC] shadow-lg"
            >
              <span
                class="font-mono text-[10px] text-[#E5383B] uppercase tracking-widest block mb-1 font-bold"
              >
                AKLIMOSATURIZM AUTHORIZED
              </span>
              <p class="font-barlow font-bold text-xl uppercase text-[#0D0D0D]">
                Licensed Sports Tourism & Overseas Athletic Supervision
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tiered Camp Philosophy Section (3-Star, 4-Star, 5-Star) -->
  <section class="py-24 bg-[#FAF9F6] border-b border-[#E5E3DC]">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
      <div class="text-center mb-16">
        <span class="font-mono text-xs text-[#E5383B] uppercase tracking-[0.2em] block mb-2">
          CURATED ATHLETIC PACKAGES
        </span>
        <h2 class="font-barlow font-extrabold text-3xl md:text-5xl uppercase tracking-tight text-[#0D0D0D]">
          {t('about.standardsTitle')}
        </h2>
        <p
          class="text-[#666666] text-sm md:text-base max-w-2xl mx-auto mt-4 font-light leading-relaxed"
        >
          {t('about.standardsDesc')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- 3-Star Tier -->
        <div
          class="bg-white border border-[#E5E3DC] p-8 shadow-sm hover:border-[#E5383B] transition-all"
        >
          <div class="flex items-center gap-1 text-[#E5383B] mb-4">
            <span class="font-mono text-sm font-bold">3★</span>
            <span class="font-barlow font-bold text-lg uppercase text-[#0D0D0D]">{t('tiers.star3')}</span>
          </div>
          <p class="text-[#555555] text-sm leading-relaxed font-light mb-6">
            {t('tiers.star3Desc')}
          </p>
          <ul class="text-xs text-[#666666] space-y-2 font-mono border-t border-[#F4F3EF] pt-4">
            <li>• Standard Turf Pitch Access</li>
            <li>• Biophysical Testing</li>
            <li>• Full Board Athlete Nutrition</li>
          </ul>
        </div>

        <!-- 4-Star Tier -->
        <div
          class="bg-white border border-[#E5E3DC] p-8 shadow-sm hover:border-[#E5383B] transition-all relative"
        >
          <div class="flex items-center gap-1 text-[#E5383B] mb-4">
            <span class="font-mono text-sm font-bold">4★</span>
            <span class="font-barlow font-bold text-lg uppercase text-[#0D0D0D]">{t('tiers.star4')}</span>
          </div>
          <p class="text-[#555555] text-sm leading-relaxed font-light mb-6">
            {t('tiers.star4Desc')}
          </p>
          <ul class="text-xs text-[#666666] space-y-2 font-mono border-t border-[#F4F3EF] pt-4">
            <li>• Executive Hotel Accommodation</li>
            <li>• Video Classroom & GPS Analysis</li>
            <li>• Certified UEFA / FIVB Mentors</li>
          </ul>
        </div>

        <!-- 5-Star Tier -->
        <div class="bg-white border-2 border-[#E5383B] p-8 shadow-md relative">
          <span
            class="absolute -top-3 left-6 px-3 py-0.5 bg-[#E5383B] text-white font-mono text-[9px] uppercase tracking-widest font-bold"
          >
            VIP EXPEDITION
          </span>
          <div class="flex items-center gap-1 text-[#E5383B] mb-4">
            <span class="font-mono text-sm font-bold">5★</span>
            <span class="font-barlow font-bold text-lg uppercase text-[#0D0D0D]">{t('tiers.star5')}</span>
          </div>
          <p class="text-[#555555] text-sm leading-relaxed font-light mb-6">
            {t('tiers.star5Desc')}
          </p>
          <ul class="text-xs text-[#666666] space-y-2 font-mono border-t border-[#F4F3EF] pt-4">
            <li>• 5-Star Beachfront Resort</li>
            <li>• Direct European Scout Showcase</li>
            <li>• 4K Video Dossier & Scout Report</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Concierge Direct Call to Action -->
  <section class="py-20 bg-white text-center">
    <div class="max-w-3xl mx-auto px-4">
      <span class="font-mono text-xs text-[#E5383B] uppercase tracking-[0.2em] block mb-3 font-bold">
        {t('booking.badge')}
      </span>
      <h2 class="font-barlow font-extrabold text-3xl md:text-5xl uppercase tracking-tight text-[#0D0D0D] mb-6">
        {t('about.leadershipTitle')}
      </h2>
      <p class="text-[#555555] text-base mb-8 font-light leading-relaxed">
        {t('about.leadershipDesc')}
      </p>
      <ContactButtons class="justify-center" />
    </div>
  </section>
</MainLayout>
