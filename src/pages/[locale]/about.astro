---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/shared/Header.astro';
import WhatsAppButton from '@/components/shared/WhatsAppButton.astro';
import LoadingEntrance from '@/components/shared/LoadingEntrance.astro';
import LanguageGate from '@/components/LanguageGate.astro';
import SkipToContent from '@/components/shared/SkipToContent.astro';
import { LOCALES_LIST } from '@/i18n/config';
import type { SupportedLocale } from '@/types/i18n';
import { useTranslations } from '@/i18n/utils';

export function getStaticPaths() {
  return LOCALES_LIST.map((locale) => ({
    params: { locale }
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = useTranslations(locale);

const chapters = [
  {
    index: '01',
    badge: t('about.chapter1Badge'),
    title: t('about.chapter1Title'),
    paragraph: t('about.p1'),
    image:
      'https://images.unsplash.com/photo-1508098682722-e99c43a406b2?q=80&w=1600&auto=format&fit=crop',
    imageAlt: 'SPORTIVERF Foundation Arena',
    tag: 'TÜRKİYE • 2026',
    icon: 'globe'
  },
  {
    index: '02',
    badge: t('about.chapter2Badge'),
    title: t('about.chapter2Title'),
    paragraph: t('about.p2'),
    image:
      'https://images.unsplash.com/photo-1517649763962-0c623266010b?q=80&w=1600&auto=format&fit=crop',
    imageAlt: 'Athletes & Academies Professional Development',
    tag: 'DEVELOPMENT & NETWORK',
    icon: 'athletes'
  },
  {
    index: '03',
    badge: t('about.chapter3Badge'),
    title: t('about.chapter3Title'),
    paragraph: t('about.p3'),
    image:
      'https://images.unsplash.com/photo-1574629810360-7efbbe195018?q=80&w=1600&auto=format&fit=crop',
    imageAlt: 'Specialized Sports Camps & Coaching',
    tag: 'ELITE CAMPS & ACADEMICS',
    icon: 'programs'
  },
  {
    index: '04',
    badge: t('about.chapter4Badge'),
    title: t('about.chapter4Title'),
    paragraph: t('about.p4'),
    image:
      'https://images.unsplash.com/photo-1461896836934-ffe607ba8211?q=80&w=1600&auto=format&fit=crop',
    imageAlt: 'International Opportunities & Pathways',
    tag: 'GLOBAL HORIZONS',
    icon: 'pathway'
  },
  {
    index: '05',
    badge: t('about.chapter5Badge'),
    title: t('about.chapter5Title'),
    paragraph: t('about.p5'),
    image:
      'https://images.unsplash.com/photo-1540747913346-19e32dc3e97e?q=80&w=1600&auto=format&fit=crop',
    imageAlt: 'SPORTIVERF Mission & Professional Standards',
    tag: 'MISSION & EXCELLENCE',
    icon: 'mission'
  }
];
---

<BaseLayout
  locale={locale}
  seo={{
    title: `${t('nav.about')} — SPORTIVERF`,
    description: t('about.storyDesc')
  }}
>
  <!-- Language Gate & Entrance Loaders -->
  <LanguageGate currentLocale={locale} />
  <LoadingEntrance />
  <SkipToContent locale={locale} targetId="scrollytelling-container" />

  <!-- Fixed Top Header -->
  <Header locale={locale} />

  <!-- Full-Screen Scrollytelling Container with CSS Snap Scroll -->
  <main
    id="scrollytelling-container"
    role="main"
    class="relative w-full h-screen overflow-y-scroll snap-y snap-mandatory bg-[#0a0a0a] text-white selection:bg-[#E5383B] selection:text-white scrollbar-none focus:outline-none"
    tabindex="-1"
  >
    <!-- Split Layout Grid (Sticky Media + Scrolling Text) -->
    <div class="relative w-full min-h-full grid grid-cols-1 md:grid-cols-2">
      <!-- ========================================================= -->
      <!-- STICKY MEDIA SIDE (Fixed on mobile, Sticky on desktop) -->
      <!-- ========================================================= -->
      <div
        class="fixed inset-0 md:sticky md:top-0 md:h-screen w-full md:w-auto h-full pointer-events-none md:pointer-events-auto z-0 md:z-10 overflow-hidden bg-[#0a0a0a] border-r-0 md:border-r border-white/10 flex flex-col justify-between p-6 sm:p-10 md:p-12"
      >
        <!-- Background Images Layer with Smooth Cross-Fade & Ken Burns Subtle Effect -->
        <div class="absolute inset-0 w-full h-full overflow-hidden">
          {
            chapters.map((chapter, idx) => (
              <img
                src={chapter.image}
                alt={chapter.imageAlt}
                loading={idx === 0 ? 'eager' : 'lazy'}
                data-image-index={idx}
                class={`scrolly-bg-image absolute inset-0 w-full h-full object-cover object-center filter brightness-[0.38] contrast-[1.15] saturate-[1.2] transition-all duration-700 ease-out ${
                  idx === 0 ? 'opacity-100 scale-100' : 'opacity-0 scale-105'
                }`}
              />
            ))
          }
        </div>

        <!-- Dark Gradient Overlays for High Text Contrast -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/80 to-[#0a0a0a]/60 md:bg-gradient-to-r md:from-transparent md:via-[#0a0a0a]/30 md:to-[#0a0a0a] pointer-events-none z-10"
        >
        </div>
        <div
          class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-transparent via-[#0a0a0a]/40 to-[#0a0a0a]/90 pointer-events-none z-10"
        >
        </div>

        <!-- Ambient Crimson Neon Accents -->
        <div
          class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-72 sm:w-96 sm:h-96 bg-[#E5383B]/20 rounded-full blur-[100px] pointer-events-none z-10"
        >
        </div>

        <!-- Sticky Header Indicator (Desktop) -->
        <div class="relative z-20 hidden md:flex items-center justify-between pt-16">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#E5383B] animate-pulse"></span>
            <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#AAAAAA]">
              {t('about.badge')}
            </span>
          </div>

          <!-- Dynamic Counter Display -->
          <div
            id="active-chapter-counter"
            class="font-mono text-xs font-bold text-[#E5383B] tracking-widest px-3 py-1 bg-[#141414]/90 border border-[#E5383B]/30 backdrop-blur-md"
          >
            01 / 05
          </div>
        </div>

        <!-- Central Glowing Dynamic SVG Icon Box -->
        <div class="relative z-20 flex-1 flex flex-col items-center justify-center my-auto">
          <div
            class="w-28 h-28 sm:w-36 sm:h-36 md:w-44 md:h-44 rounded-2xl bg-[#111111]/80 border border-white/10 md:border-[#E5383B]/30 shadow-[0_0_50px_rgba(229,56,59,0.25)] backdrop-blur-xl flex items-center justify-center relative overflow-hidden group"
          >
            <!-- Inner Subtle Neon Ring -->
            <div
              class="absolute inset-0 bg-gradient-to-br from-[#E5383B]/20 via-transparent to-[#B7094C]/20 opacity-80"
            >
            </div>

            <!-- Icon 01: Foundation / Globe -->
            <div
              data-icon-index="0"
              class="scrolly-icon absolute transition-all duration-500 transform opacity-100 scale-100 translate-y-0"
            >
              <svg
                class="w-14 h-14 sm:w-16 sm:h-16 md:w-20 md:h-20 text-[#E5383B] filter drop-shadow-[0_0_12px_rgba(229,56,59,0.6)]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path
                  d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                ></path>
              </svg>
            </div>

            <!-- Icon 02: Growth / Athletes & Network -->
            <div
              data-icon-index="1"
              class="scrolly-icon absolute transition-all duration-500 transform opacity-0 scale-75 translate-y-4 pointer-events-none"
            >
              <svg
                class="w-14 h-14 sm:w-16 sm:h-16 md:w-20 md:h-20 text-[#E5383B] filter drop-shadow-[0_0_12px_rgba(229,56,59,0.6)]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>

            <!-- Icon 03: Core Activities & Training / Academics -->
            <div
              data-icon-index="2"
              class="scrolly-icon absolute transition-all duration-500 transform opacity-0 scale-75 translate-y-4 pointer-events-none"
            >
              <svg
                class="w-14 h-14 sm:w-16 sm:h-16 md:w-20 md:h-20 text-[#E5383B] filter drop-shadow-[0_0_12px_rgba(229,56,59,0.6)]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                <path d="M12 12v6"></path>
              </svg>
            </div>

            <!-- Icon 04: International Pathways & Global Vision -->
            <div
              data-icon-index="3"
              class="scrolly-icon absolute transition-all duration-500 transform opacity-0 scale-75 translate-y-4 pointer-events-none"
            >
              <svg
                class="w-14 h-14 sm:w-16 sm:h-16 md:w-20 md:h-20 text-[#E5383B] filter drop-shadow-[0_0_12px_rgba(229,56,59,0.6)]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
              </svg>
            </div>

            <!-- Icon 05: Mission / Excellence & Crest -->
            <div
              data-icon-index="4"
              class="scrolly-icon absolute transition-all duration-500 transform opacity-0 scale-75 translate-y-4 pointer-events-none"
            >
              <svg
                class="w-14 h-14 sm:w-16 sm:h-16 md:w-20 md:h-20 text-[#E5383B] filter drop-shadow-[0_0_12px_rgba(229,56,59,0.6)]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="6"></circle>
                <circle cx="12" cy="12" r="2"></circle>
              </svg>
            </div>
          </div>
        </div>

        <!-- Bottom Navigation Dots & Supervision Label (Desktop) -->
        <div class="relative z-20 hidden md:flex flex-col gap-4">
          <!-- Interactive Chapter Navigation Dots -->
          <div class="flex items-center gap-2">
            {
              chapters.map((_, idx) => (
                <button
                  type="button"
                  data-target-index={idx}
                  aria-label={`Jump to Chapter ${idx + 1}`}
                  class={`chapter-nav-dot h-2 rounded-full transition-all duration-300 cursor-pointer ${
                    idx === 0
                      ? 'bg-[#E5383B] w-8 shadow-[0_0_10px_rgba(229,56,59,0.8)]'
                      : 'bg-white/20 w-2.5 hover:bg-white/50'
                  }`}
                />
              ))
            }
          </div>

          <div class="flex items-center justify-between text-[11px] font-mono text-[#888888] pt-2">
            <span>SPORTIVERF • OFFICIAL DOSSIER</span>
            <span>2026 TÜRKIYE</span>
          </div>
        </div>
      </div>

      {/* ========================================================= */}
      {/* SCROLLING TEXT SIDE (5 Full-Screen Snap-Start Sections) */}
      {/* ========================================================= */}
      <div class="relative z-10 flex flex-col">
        {
          chapters.map((chapter, idx) => (
            <section
              id={`story-section-${idx}`}
              data-chapter-index={idx}
              class="scrolly-section snap-start min-h-screen h-screen flex flex-col justify-center px-6 sm:px-10 md:px-12 lg:px-16 pt-24 pb-12 relative overflow-hidden"
            >
              <div class="story-content max-w-xl mx-auto md:mx-0 transition-all duration-700 ease-out transform opacity-100 translate-y-0">
                <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#E5383B]/10 border border-[#E5383B]/40 text-[#E5383B] font-mono text-[11px] sm:text-xs uppercase tracking-[0.2em] mb-4 shadow-[0_0_15px_rgba(229,56,59,0.15)]">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#E5383B]" />
                  <span>{chapter.badge}</span>
                </div>

                <h2 class="font-barlow font-black text-3xl sm:text-4xl md:text-5xl uppercase tracking-tight text-white mb-6 leading-tight drop-shadow-md">
                  {chapter.title}
                </h2>

                <p class="font-sans text-base sm:text-lg md:text-xl text-[#DDDDDD] font-light leading-relaxed mb-8">
                  {chapter.paragraph}
                </p>

                {/* Section-Specific Elements */}
                {idx === 4 ? (
                  <div class="space-y-6 pt-4 border-t border-white/10">
                    <div class="flex flex-wrap items-center gap-3.5">
                      <a
                        href={`/${locale}/volleyball-camps`}
                        class="bg-gradient-to-r from-[#E5383B] to-[#B7094C] hover:from-[#FF4D6D] hover:to-[#E5383B] text-white shadow-[0_0_20px_rgba(229,56,59,0.4)] transition-all duration-300 font-barlow font-bold text-xs uppercase tracking-wider py-3.5 px-6 flex items-center gap-2"
                      >
                        <span>{t('about.exploreCamps')}</span>
                        <span>&rarr;</span>
                      </a>
                      <a
                        href={`https://wa.me/905421661698?text=${encodeURIComponent(t('contact.whatsappText'))}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="bg-[#141414] hover:bg-[#1f1f1f] text-white border border-white/20 hover:border-[#E5383B] transition-all duration-300 font-barlow font-bold text-xs uppercase tracking-wider py-3.5 px-6 flex items-center gap-2"
                      >
                        <svg class="w-4 h-4 text-[#E5383B]" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984a9.964 9.964 0 001.333 4.993L2 22l5.233-1.237a9.982 9.982 0 004.779 1.222h.004c5.505 0 9.988-4.478 9.989-9.984 0-2.669-2.08-5.172-3.932-7.054C16.143 3.064 13.639 2 12.012 2zm0 1.8c4.52 0 8.188 3.664 8.189 8.184 0 4.52-3.668 8.184-8.189 8.184a8.167 8.167 0 01-4.162-1.129l-.299-.177-3.1 0.733.826-3.023-.194-.31a8.162 8.162 0 01-1.252-4.278c0-4.52 3.669-8.184 8.189-8.184z" />
                        </svg>
                        <span>{t('about.contactConcierge')}</span>
                      </a>
                    </div>

                    <div class="p-4 bg-[#141414]/90 border-l-2 border-[#E5383B] text-xs text-[#AAAAAA] leading-relaxed">
                      <span class="font-mono text-[10px] text-[#E5383B] uppercase tracking-widest block font-bold mb-1">
                        {t('about.supervisionTitle')}
                      </span>
                      <p>{t('about.supervisionDesc')}</p>
                    </div>
                  </div>
                ) : (
                  <div class="pt-2 flex items-center gap-3 text-white/40 font-mono text-[11px] uppercase tracking-widest">
                    <span>{t('about.scrollPrompt')}</span>
                    <svg
                      class="w-4 h-4 text-[#E5383B] animate-bounce"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 14l-7 7m0 0l-7-7m7 7V3"
                      />
                    </svg>
                  </div>
                )}
              </div>
            </section>
          ))
        }
      </div>
    </div>

    <!-- Floating WhatsApp Concierge Button -->
    <WhatsAppButton locale={locale} variant="floating" />
  </main>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('scrollytelling-container');
    const sections = document.querySelectorAll('.scrolly-section');
    const mediaImages = document.querySelectorAll('.scrolly-bg-image');
    const mediaIcons = document.querySelectorAll('.scrolly-icon');
    const chapterPills = document.querySelectorAll('.chapter-nav-dot');
    const chapterCounter = document.getElementById('active-chapter-counter');

    if (!sections.length) return;

    const setActiveChapter = (index) => {
      // Cross-fade background images
      mediaImages.forEach((img, i) => {
        if (i === index) {
          img.classList.remove('opacity-0', 'scale-105');
          img.classList.add('opacity-100', 'scale-100');
        } else {
          img.classList.remove('opacity-100', 'scale-100');
          img.classList.add('opacity-0', 'scale-105');
        }
      });

      // Cross-fade SVG glowing icons
      mediaIcons.forEach((icon, i) => {
        if (i === index) {
          icon.classList.remove('opacity-0', 'scale-75', 'translate-y-4', 'pointer-events-none');
          icon.classList.add('opacity-100', 'scale-100', 'translate-y-0');
        } else {
          icon.classList.remove('opacity-100', 'scale-100', 'translate-y-0');
          icon.classList.add('opacity-0', 'scale-75', 'translate-y-4', 'pointer-events-none');
        }
      });

      // Update chapter navigation dots
      chapterPills.forEach((dot, i) => {
        if (i === index) {
          dot.classList.add('bg-[#E5383B]', 'w-8', 'shadow-[0_0_10px_rgba(229,56,59,0.8)]');
          dot.classList.remove('bg-white/20', 'w-2.5');
        } else {
          dot.classList.remove('bg-[#E5383B]', 'w-8', 'shadow-[0_0_10px_rgba(229,56,59,0.8)]');
          dot.classList.add('bg-white/20', 'w-2.5');
        }
      });

      // Update counter
      if (chapterCounter) {
        chapterCounter.textContent = `0${index + 1} / 05`;
      }
    };

    // IntersectionObserver to observe which full-screen snap section is in view
    const observerOptions = {
      root: container,
      threshold: 0.55
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const index = parseInt(entry.target.getAttribute('data-chapter-index') || '0', 10);
          setActiveChapter(index);

          const content = entry.target.querySelector('.story-content');
          if (content) {
            content.classList.remove('opacity-30', 'translate-y-4');
            content.classList.add('opacity-100', 'translate-y-0');
          }
        } else {
          const content = entry.target.querySelector('.story-content');
          if (content) {
            content.classList.remove('opacity-100', 'translate-y-0');
            content.classList.add('opacity-30', 'translate-y-4');
          }
        }
      });
    }, observerOptions);

    sections.forEach((sec) => observer.observe(sec));

    // Allow jumping to section via navigation dots
    chapterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const targetIndex = parseInt(pill.getAttribute('data-target-index') || '0', 10);
        const targetSection = document.getElementById(`story-section-${targetIndex}`);
        if (targetSection) {
          targetSection.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  });
</script>
