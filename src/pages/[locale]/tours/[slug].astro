---
import MainLayout from '@/layouts/MainLayout.astro';
import { LOCALES_LIST } from '@/i18n/config';
import type { SupportedLocale } from '@/types/i18n';
import BookingIsland from '@/components/islands/BookingIsland.astro';
import OptimizedImage from '@/components/seo/OptimizedImage.astro';
import campsData from '@/data/camps.json';
import { getCampBySlug, type CampItem } from '@/data/camps';
import { getLocalizedField } from '@/i18n/utils';

const allCamps = campsData as CampItem[];

export function getStaticPaths() {
  const slugs = (campsData as CampItem[]).map((camp) => camp.slug);

  return LOCALES_LIST.flatMap((locale) =>
    slugs.map((slug) => ({
      params: { locale, slug }
    }))
  );
}

const { locale, slug } = Astro.params as { locale: SupportedLocale; slug: string };

const camp = getCampBySlug(slug) || allCamps[0];

const title = getLocalizedField(camp.title, locale);
const summary = getLocalizedField(camp.summary, locale);
const location = getLocalizedField(camp.location, locale);
const tierName = getLocalizedField(camp.tierName, locale);
---

<MainLayout
  locale={locale}
  seo={{
    title: `${title} — SPORTIVERF`,
    description: summary,
    image: camp.imageUrl
  }}
>
  <section class="py-12 bg-[#FAF9F6]">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        <div class="lg:col-span-7 space-y-6">
          <OptimizedImage
            src={camp.imageUrl}
            alt={title}
            width={1200}
            height={750}
            loading="eager"
            class="w-full aspect-[16/10] object-cover border border-[#E5E3DC] shadow-sm bg-white"
          />
          <div class="flex items-center gap-3">
            <span class="inline-block px-3 py-1 bg-[#0D0D0D] text-white font-mono text-xs uppercase tracking-widest">
              {camp.sport} • {camp.starRating}★ {tierName}
            </span>
            <span class="text-xs font-mono text-[#888888] uppercase tracking-wider">
              {location}
            </span>
          </div>
          <h1 class="font-serif font-bold text-3xl md:text-5xl text-[#0D0D0D]">{title}</h1>
          <p class="text-[#555555] font-light leading-relaxed">{summary}</p>
        </div>
        <div class="lg:col-span-5 lg:sticky lg:top-28">
          <BookingIsland
            locale={locale}
            tourId={slug}
            tourTitle={title}
            sport={camp.sport}
            starTier={`${camp.starRating}-Star ${tierName}`}
          />
        </div>
      </div>
    </div>
  </section>
</MainLayout>
