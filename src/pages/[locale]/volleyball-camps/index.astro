---
import MainLayout from '@/layouts/MainLayout.astro';
import { LOCALES_LIST } from '@/i18n/config';
import type { SupportedLocale } from '@/types/i18n';
import CampCard from '@/components/shared/CampCard.astro';
import FilterBar from '@/components/islands/FilterBar.astro';
import ContactButtons from '@/components/shared/ContactButtons.astro';
import campsData from '@/data/camps.json';
import type { CampItem } from '@/data/camps';
import { useTranslations, getLocalizedField } from '@/i18n/utils';

export function getStaticPaths() {
  return LOCALES_LIST.map((locale) => ({
    params: { locale }
  }));
}

const { locale } = Astro.params as { locale: SupportedLocale };
const t = useTranslations(locale);

const volleyballCamps = (campsData as CampItem[]).filter((camp) => camp.sport === 'VOLLEYBALL');
---

<MainLayout
  locale={locale}
  seo={{
    title: `${t('nav.volleyball')} — SPORTIVERF`,
    description: t('site.description')
  }}
>
  <!-- Category Hero -->
  <section class="relative py-24 bg-[#0A0A0A] text-white border-b border-[#222222] overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8 text-center relative z-10">
      <span
        class="inline-block px-3 py-1 bg-[#E5383B]/10 border border-[#E5383B]/40 text-[#E5383B] font-mono text-xs uppercase tracking-[0.2em] mb-4"
      >
        FIVB TARAFLEX COURTS • INTERNATIONAL MASTERCLASSES
      </span>
      <h1
        class="font-barlow font-black text-5xl sm:text-7xl text-white uppercase tracking-tight mb-6"
      >
        {t('nav.volleyball')}
      </h1>
      <p
        class="font-sans text-[#DDDDDD] text-base md:text-lg max-w-2xl mx-auto font-light leading-relaxed"
      >
        Position-specific volleyball masterclasses, jump biomechanics, setter-libero precision
        drills, and elite club scout exposure across 3-Star, 4-Star, and 5-Star categories.
      </p>
    </div>
  </section>

  <!-- Dedicated Page Filter Bar -->
  <FilterBar locale={locale} activeSport="VOLLEYBALL" activeStar="ALL" />

  <!-- Camp Cards Grid with Reveal-on-Scroll Animations -->
  <section class="py-16 bg-[#FAF9F6]">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          volleyballCamps.map((camp) => (
            <div
              data-camp-wrapper
              data-sport={camp.sport}
              data-star-rating={camp.starRating}
              class="reveal-card opacity-0 translate-y-8 transition-all duration-700 ease-out"
            >
              <CampCard
                locale={locale}
                title={getLocalizedField(camp.title, locale)}
                sport={camp.sport}
                starRating={camp.starRating}
                tierName={getLocalizedField(camp.tierName, locale)}
                location={getLocalizedField(camp.location, locale)}
                dates={getLocalizedField(camp.dates, locale)}
                ageGroup={getLocalizedField(camp.ageGroup, locale)}
                capacity={getLocalizedField(camp.capacity, locale)}
                imageUrl={camp.imageUrl}
                href={`/${locale}/camps/${camp.slug}`}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Volleyball Standards Highlights -->
  <section class="py-20 bg-white border-t border-[#E5E3DC]">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
      <div class="text-center mb-16">
        <span class="font-mono text-xs text-[#E5383B] uppercase tracking-[0.2em] block mb-2">
          WHY VOLLEYBALL ATHLETES CHOOSE SPORTIVERF
        </span>
        <h2
          class="font-barlow font-extrabold text-3xl md:text-5xl uppercase tracking-tight text-[#0D0D0D]"
        >
          VOLLEYBALL MASTERCLASS STANDARDS
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div
          class="bg-[#FAF9F6] p-8 border border-[#E5E3DC] hover:border-[#E5383B] transition-colors"
        >
          <h3 class="font-barlow font-bold text-2xl uppercase text-[#0D0D0D] mb-3">
            FIVB Taraflex Courts
          </h3>
          <p class="text-[#555555] text-sm leading-relaxed font-light">
            Official shock-absorbing Taraflex surfaces designed to maximize jump performance and
            minimize athlete fatigue.
          </p>
        </div>
        <div
          class="bg-[#FAF9F6] p-8 border border-[#E5E3DC] hover:border-[#E5383B] transition-colors"
        >
          <h3 class="font-barlow font-bold text-2xl uppercase text-[#0D0D0D] mb-3">
            Jump Biomechanics Lab
          </h3>
          <p class="text-[#555555] text-sm leading-relaxed font-light">
            High-speed video capture and vertical jump assessment to refine spike velocity and
            blocking timing.
          </p>
        </div>
        <div
          class="bg-[#FAF9F6] p-8 border border-[#E5E3DC] hover:border-[#E5383B] transition-colors"
        >
          <h3 class="font-barlow font-bold text-2xl uppercase text-[#0D0D0D] mb-3">
            European Scout Network
          </h3>
          <p class="text-[#555555] text-sm leading-relaxed font-light">
            Direct showcase matches attended by European volleyball agents and university club
            recruiters.
          </p>
        </div>
      </div>

      <div class="mt-16 text-center">
        <ContactButtons locale={locale} class="justify-center" />
      </div>
    </div>
  </section>
</MainLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.reveal-card');

    if (!cards.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, index) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.remove('opacity-0', 'translate-y-8');
              entry.target.classList.add('opacity-100', 'translate-y-0');
            }, index * 100);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    cards.forEach((card) => observer.observe(card));
  });
</script>
