# Environment Variables Template
# Copy this file to .env or .env.production and set the appropriate variables.

# Core Site Config
PUBLIC_SITE_URL=https://sportiverf.com
PUBLIC_DEFAULT_LOCALE=en

# ASP.NET Core Backend API Configuration (Future Integration Target)
PUBLIC_API_BASE_URL=https://api.sportiverf.com/v1
PUBLIC_API_TIMEOUT_MS=10000

# Headless CMS Provider Configuration (Future Integration Target)
# Options: 'mock' | 'strapi' | 'contentful' | 'sanity'
PUBLIC_CMS_PROVIDER=mock
PUBLIC_CMS_URL=https://cms.sportiverf.com
PUBLIC_CMS_API_KEY=your_cms_read_token_here

# Booking Engine API Strategy
PUBLIC_BOOKING_SERVICE_URL=https://booking.sportiverf.com/api
